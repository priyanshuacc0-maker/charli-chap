<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#e3e4e7"><script>try{var t=localStorage.getItem("charlie-theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script><title>Charlie Chaap · Orders</title>
<style>
:root{color-scheme:light;--bg:#f4f4f2;--paper:#fff;--ink:#171717;--muted:#858585;--line:#ededeb;--soft:#f5f5f3;--black:#111;--gold:#c5a15a;--orange:#ff7a19;--blue:#2874dd;--green:#26835e;--shadow:0 10px 28px rgba(20,20,20,.045),0 2px 5px rgba(20,20,20,.025)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:20px}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.42 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit}button{border:0;cursor:pointer;touch-action:manipulation}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #7777;outline-offset:2px}button:disabled{opacity:.4;cursor:not-allowed}[hidden]{display:none!important}
.app{max-width:1120px;margin:0 auto;min-height:100vh;padding:8px 15px calc(122px + env(safe-area-inset-bottom))}.topbar{position:sticky;top:0;z-index:10;display:grid;grid-template-columns:45px minmax(0,1fr) 45px;align-items:center;gap:8px;margin:0 -15px;padding:10px 15px 14px;background:rgba(244,244,242,.9);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}.round-action{width:43px;height:43px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#171717;box-shadow:var(--shadow);border:1px solid #f4f4f4}.round-action svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.brand{min-width:0;text-align:center}.crown{display:block;margin:0 auto 1px;width:24px;height:19px;fill:var(--gold)}.brand-name{font-family:Georgia,"Times New Roman",serif;font-size:clamp(18px,4.4vw,24px);font-weight:700;letter-spacing:1.2px;line-height:1.15;white-space:nowrap}.brand-sub{font-size:8px;color:#777;letter-spacing:1.65px;margin-top:4px;text-transform:uppercase}.view{display:none;animation:fadeIn .18s ease}.view.active{display:block}@keyframes fadeIn{from{opacity:.6;transform:translateY(3px)}to{opacity:1;transform:none}}
.home-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:18px}.home-left,.home-right{min-width:0}.hero{height:176px;position:relative;overflow:hidden;border-radius:25px;background-color:#111;background-image:linear-gradient(90deg,rgba(5,5,5,.96) 0%,rgba(5,5,5,.82) 38%,rgba(5,5,5,.13) 100%),url("data:image/jpeg;base64,");background-size:cover;background-position:center right;box-shadow:0 12px 25px #00000012;color:white;margin:1px 0 13px}.hero-content{position:relative;z-index:1;height:100%;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:22px 19px;max-width:68%}.eyebrow{font-size:10px;letter-spacing:2.3px;color:#d9b66e;font-weight:800;margin-bottom:7px}.hero h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(22px,5.6vw,29px);font-weight:500;line-height:1.08;margin:0 0 8px;letter-spacing:-.35px}.hero p{font-size:12px;color:#d2d2d2;line-height:1.35;margin:0;max-width:165px}.hero-arrow{position:absolute;right:15px;bottom:15px;z-index:2;width:43px;height:43px;border-radius:50%;background:#fff;color:#111;box-shadow:0 4px 12px #0003;font-size:24px;display:grid;place-items:center}
.quick-card{background:#fff;border:1px solid #f1f1ef;border-radius:20px;padding:8px;box-shadow:var(--shadow);margin-bottom:15px}.quick-row{display:grid;grid-template-columns:20px minmax(0,1fr) 94px;align-items:center;gap:9px}.quick-search{width:19px;height:19px;stroke:#222;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;margin-left:4px}.quick-entry{width:100%;min-width:0;min-height:44px;max-height:114px;resize:none;border:0;background:transparent!important;box-shadow:none!important;outline:none!important;padding:11px 0;color:#171717;font-size:14px;line-height:1.35}.quick-entry::placeholder{color:#999}.black-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;padding:0 15px;border-radius:15px;background:linear-gradient(145deg,#252525,#050505);color:#fff;font-weight:750;box-shadow:0 5px 13px #0002;transition:transform .12s,filter .12s}.black-btn:active{transform:scale(.98);filter:brightness(1.14)}.quick-row .black-btn{height:48px;padding:0 12px}.plus-symbol{font-size:23px;line-height:1;font-weight:400}.quick-note{padding:7px 7px 3px;font-size:11px;color:#898989}.matches{display:grid;gap:6px;margin:8px 2px 2px}.match{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;text-align:left;background:#f8f8f7;border:1px solid #efefed;border-radius:14px;padding:10px 11px;color:#171717}.match:active{background:#f0f0ee}.match strong{display:block;font-size:12px;font-weight:800;overflow-wrap:anywhere}.match small{display:block;font-size:10px;color:#888;margin-top:3px}.match-price{font-size:13px;font-weight:850;white-space:nowrap;text-align:right}.summaryline{margin:6px 5px 0;color:#6f6f6f;font-size:11px}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:20px 1px 11px}.section-title{font-family:Georgia,"Times New Roman",serif;font-size:21px;font-weight:700;letter-spacing:-.4px;margin:0}.section-sub{font-size:11px;color:#8c8c8c;margin-top:3px}.text-btn{background:transparent;color:#222;font-size:12px;font-weight:650;padding:8px 3px;white-space:nowrap}.category-row{display:flex;gap:7px;overflow:auto;padding:1px 0 8px;margin:0 0 5px;scrollbar-width:none}.category-row::-webkit-scrollbar{display:none}.pill{flex:0 0 auto;padding:10px 15px;border-radius:99px;background:#fff;border:1px solid #eee;color:#343434;font-weight:650;font-size:12px;box-shadow:0 3px 8px #00000004}.pill.selected{background:linear-gradient(145deg,#252525,#050505);color:white;border-color:#111;box-shadow:0 5px 11px #0002}
.popular-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.food-card{background:#fff;border:1px solid #eeeeec;border-radius:20px;overflow:hidden;box-shadow:var(--shadow);min-width:0}.food-image-wrap{position:relative;height:108px;background:#e9e7e0;overflow:hidden}.food-image{width:100%;height:100%;object-fit:cover;display:block}.food-add{position:absolute;right:9px;bottom:8px;width:36px;height:36px;border-radius:50%;background:#fff;color:#111;font-size:23px;line-height:1;box-shadow:0 4px 12px #0002;display:grid;place-items:center}.food-info{padding:9px 10px 10px}.food-name{font-size:12px;font-weight:800;line-height:1.25;min-height:30px;display:flex;align-items:center;overflow-wrap:anywhere}.food-category{font-size:10px;color:#999;margin:2px 0 7px}.price-pair{display:grid;grid-template-columns:1fr 1fr;gap:6px}.price-choice{border:0;background:#f6f6f5;border-radius:11px;padding:7px 6px;text-align:left;color:#171717;min-width:0}.price-choice:active{background:#eaeae8}.price-choice strong{display:block;font-size:12px;font-weight:850}.price-choice small{display:block;color:#8b8b8b;font-size:9px;margin-top:1px}
.order-panel{background:#fff;border:1px solid #f0f0ee;border-radius:25px;padding:15px 13px 13px;box-shadow:var(--shadow);margin-top:15px}.order-top-tools{display:flex;gap:8px;align-items:center;margin:12px 0}.searchbox{position:relative;flex:1;min-width:0}.searchbox svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);height:17px;width:17px;stroke:#858585;fill:none;stroke-width:2;pointer-events:none}.searchbox input{width:100%;min-height:43px;background:#f5f5f4;border:1px solid #efefed;border-radius:15px;padding:10px 12px 10px 38px;outline:none;font-size:12px;color:#171717}.searchbox input:focus{border-color:#d7d7d4;background:#fff}.filter-group{display:flex;gap:5px;padding:4px;border-radius:16px;background:#f4f4f3;border:1px solid #ededeb;margin-bottom:12px}.filter-btn{flex:1;min-width:0;background:transparent;color:#777;border-radius:12px;padding:10px 4px;font-size:11px;font-weight:750}.filter-btn.selected{background:linear-gradient(145deg,#252525,#050505);color:white;box-shadow:0 4px 9px #0002}.order-list{display:grid;gap:10px}.order-card{background:#fff;border:1px solid #ececea;border-radius:22px;padding:14px;box-shadow:0 4px 14px #00000004;cursor:pointer;min-width:0}.order-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.order-meta{min-width:0}.order-number{font-size:11px;font-weight:900;letter-spacing:1px;color:#777}.order-count{font-size:11px;color:#888;margin-top:2px}.order-time{font-size:11px;color:#999;margin-top:3px}.order-total{font-size:22px;font-weight:900;letter-spacing:-.6px;white-space:nowrap;font-variant-numeric:tabular-nums}.status{display:inline-flex;align-items:center;gap:5px;padding:6px 10px;border-radius:99px;font-size:10px;font-weight:800;white-space:nowrap}.status.pending{color:#ef7414;background:#fff0df}.status.preparing{color:#2466cd;background:#e9f1ff}.status.done{color:#21815a;background:#e8f6ee}.item-lines{margin:9px 0 0}.item-line{display:grid;grid-template-columns:43px minmax(0,1fr) auto;align-items:center;gap:9px;padding:8px 0;border-top:1px solid #f1f1ef}.item-line:first-child{border-top:0}.item-thumb{width:43px;height:43px;object-fit:cover;border-radius:12px;background:#eee}.item-line-info{min-width:0}.item-line-name{font-size:12px;font-weight:760;line-height:1.25;overflow-wrap:anywhere}.item-line-detail{font-size:10px;color:#888;margin-top:4px}.item-line-total{font-size:12px;font-weight:850;white-space:nowrap}.order-actions{display:flex;align-items:center;gap:8px;margin-top:11px}.action-main{flex:1;min-height:43px;padding:9px 12px;border-radius:14px;background:linear-gradient(145deg,#252525,#050505);color:#fff;font-size:12px;font-weight:800;box-shadow:0 4px 10px #0002}.action-more{flex:0 0 43px;height:43px;border-radius:14px;background:#f7f7f6;border:1px solid #efefed;color:#242424;font-size:19px;letter-spacing:1px}.order-empty{text-align:center;padding:25px 12px 20px;color:#858585}.empty-symbol{width:54px;height:54px;border-radius:19px;background:#f6f6f4;display:grid;place-items:center;margin:0 auto 11px;font-size:27px;color:#222}.order-empty strong{display:block;font-family:Georgia,serif;color:#242424;font-size:20px;margin-bottom:5px}.order-empty p{margin:0 auto 15px;max-width:230px;font-size:12px;line-height:1.5}
.page-head{padding:10px 0 13px}.page-head h1{font-family:Georgia,"Times New Roman",serif;font-size:30px;letter-spacing:-.7px;margin:0;font-weight:700}.page-head p{font-size:12px;color:#777;margin:3px 0 0}.menu-filters{margin-top:14px}.menu-list{display:grid;gap:9px}.menu-row{display:grid;grid-template-columns:66px minmax(0,1fr);gap:11px;align-items:center;background:#fff;border:1px solid #efefed;border-radius:18px;padding:9px;box-shadow:var(--shadow)}.menu-thumb{width:66px;height:66px;object-fit:cover;border-radius:13px;background:#eee}.menu-main{min-width:0}.menu-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:7px}.menu-name{font-size:13px;font-weight:800;line-height:1.25}.menu-cat{font-size:10px;color:#999;margin-top:3px}.menu-prices{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.menu-price-btn{background:#f5f5f4;border:1px solid #f0f0ee;border-radius:10px;padding:7px 9px;font-size:10px;font-weight:800;color:#222}.menu-price-btn:active{background:#eaeae8}.group-heading{font-family:Georgia,serif;font-size:19px;margin:17px 2px 8px}.more-grid{display:grid;gap:11px}.setting-card{display:flex;align-items:center;gap:13px;background:#fff;border:1px solid #eee;border-radius:20px;padding:16px;box-shadow:var(--shadow)}.setting-icon{width:43px;height:43px;border-radius:14px;background:#f3f3f1;display:grid;place-items:center;font-size:20px;flex:0 0 auto}.setting-text{flex:1;min-width:0}.setting-text strong{display:block;font-size:14px}.setting-text span{display:block;font-size:11px;color:#8a8a8a;margin-top:3px}.setting-card button{background:#111;color:#fff;border-radius:12px;padding:10px 13px;font-size:11px;font-weight:800}.small-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}.small-stat{padding:13px;border-radius:17px;border:1px solid #eee;background:white}.small-stat span{display:block;font-size:10px;color:#888}.small-stat strong{display:block;font-size:20px;margin-top:5px;letter-spacing:-.5px}
.bottom-wrap{position:fixed;z-index:30;bottom:calc(8px + env(safe-area-inset-bottom));left:0;right:0;display:flex;justify-content:center;padding:0 12px;pointer-events:none}.bottom-nav{width:min(100%,760px);min-height:68px;display:grid;grid-template-columns:1fr 1fr 66px 1fr 1fr;align-items:center;gap:2px;background:rgba(255,255,255,.96);border:1px solid #efefed;border-radius:26px;padding:7px 8px;box-shadow:0 12px 35px #0002;backdrop-filter:blur(18px);pointer-events:auto}.nav-btn{display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:#8d8d8d;background:transparent;border-radius:15px;padding:3px 1px;font-size:9px;font-weight:650}.nav-btn svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}.nav-btn.active{color:#111}.nav-btn.active svg{stroke-width:2.3}.nav-plus{justify-self:center;display:grid;place-items:center;width:56px;height:56px;border-radius:50%;color:white;background:linear-gradient(145deg,#262626,#050505);font-size:30px;font-weight:300;box-shadow:0 6px 16px #0003}.draft-dock{position:fixed;z-index:28;bottom:calc(84px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:min(calc(100% - 28px),720px);display:flex;align-items:center;gap:12px;padding:10px 11px 10px 15px;border-radius:19px;background:#fff;border:1px solid #ececea;box-shadow:0 10px 28px #0002}.draft-summary{flex:1;min-width:0}.draft-summary strong{font-size:13px;display:block}.draft-summary small{font-size:11px;color:#888;display:block;margin-top:2px}.draft-dock .black-btn{min-height:42px;border-radius:13px;font-size:12px;padding:0 15px}
.dialog{width:calc(100% - 24px);max-width:560px;max-height:min(88dvh,760px);padding:0;border:1px solid #ececea;border-radius:26px;background:#f7f7f5;color:#171717;box-shadow:0 20px 70px #0003;overflow:hidden}.dialog::backdrop{background:#1616166b;backdrop-filter:blur(5px)}.dialog-inner{max-height:min(88dvh,760px);overflow:auto;padding:18px;overscroll-behavior:contain}.dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:13px}.dialog-title{font-family:Georgia,serif;font-size:24px;letter-spacing:-.5px;font-weight:700}.dialog-sub{font-size:11px;color:#858585;margin-top:4px}.close-btn{width:38px;height:38px;border-radius:50%;background:#fff;box-shadow:var(--shadow);font-size:21px;color:#333;flex:0 0 auto}.draft-line{display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:10px;background:#fff;border:1px solid #eee;border-radius:17px;padding:10px;margin:8px 0}.draft-line img{width:44px;height:44px;border-radius:12px;object-fit:cover}.draft-name{font-size:12px;font-weight:800}.draft-meta{font-size:10px;color:#888;margin-top:3px}.qty-control{display:flex;align-items:center;gap:7px;margin-top:7px}.qty-control button{width:27px;height:27px;border-radius:9px;background:#f1f1ef;color:#222;font-size:15px;font-weight:750}.qty-control span{font-size:12px;font-weight:800;min-width:12px;text-align:center}.draft-price{font-weight:850;font-size:12px;white-space:nowrap}.summary-box{background:#fff;border:1px solid #eee;border-radius:18px;padding:14px;margin-top:12px}.summary-row{display:flex;justify-content:space-between;gap:12px;padding:5px 0;color:#777;font-size:12px}.summary-row.total{border-top:1px solid #eee;color:#171717;font-size:16px;font-weight:900;margin-top:4px;padding-top:12px}.dialog-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:13px}.dialog-actions .black-btn{grid-column:1/-1;width:100%;min-height:50px}.plain-btn{min-height:42px;border-radius:13px;background:#fff;border:1px solid #eee;color:#222;font-size:12px;font-weight:750;padding:10px 13px}.detail-item{display:grid;grid-template-columns:58px minmax(0,1fr) auto;gap:11px;align-items:center;padding:12px 0;border-bottom:1px solid #ececea}.detail-item img{width:58px;height:58px;border-radius:14px;object-fit:cover}.detail-item-name{font-size:13px;font-weight:800}.detail-item-sub{font-size:11px;color:#888;margin-top:4px}.detail-item-side{text-align:right}.detail-item-price{font-size:13px;font-weight:900}.detail-remove{display:block;background:#f1f1ef;color:#666;border-radius:8px;padding:4px 7px;margin:6px 0 0 auto;font-size:11px}.detail-summary{background:#fff;border:1px solid #eee;border-radius:18px;padding:13px;margin-top:13px}.detail-toolbar{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.toolbar-btn{background:#fff;border:1px solid #eee;border-radius:15px;min-height:68px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;font-size:10px;color:#333;font-weight:700}.toolbar-btn span{font-size:20px;line-height:1}.toolbar-btn.danger{color:#777}.pick-search{width:100%;height:45px;padding:10px 13px;border-radius:14px;border:1px solid #e9e9e7;background:#fff;margin:8px 0 12px;outline:none}.pick-item{display:grid;grid-template-columns:50px minmax(0,1fr);gap:10px;padding:10px;background:#fff;border:1px solid #eee;border-radius:15px;margin-bottom:8px}.pick-item img{width:50px;height:50px;border-radius:12px;object-fit:cover}.pick-item-main{min-width:0}.pick-item-title{font-size:12px;font-weight:850}.pick-item-price{display:flex;gap:6px;margin-top:7px;flex-wrap:wrap}.pick-item-price button{border-radius:9px;background:#f1f1ef;padding:7px 9px;font-size:10px;font-weight:800;color:#222}.toast{position:fixed;z-index:50;bottom:calc(160px + env(safe-area-inset-bottom));left:50%;transform:translate(-50%,10px);opacity:0;pointer-events:none;background:#111;color:#fff;border-radius:99px;padding:11px 16px;font-size:12px;font-weight:750;white-space:nowrap;box-shadow:0 8px 25px #0003;transition:opacity .2s,transform .2s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(min-width:700px){.app{padding-left:26px;padding-right:26px}.topbar{margin-left:-26px;margin-right:-26px;padding-left:26px;padding-right:26px}.home-grid{grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);align-items:start;gap:22px}.hero{height:190px}.popular-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.food-image-wrap{height:104px}.home-right{position:relative}.order-panel{margin-top:0;padding:17px}.menu-list{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.group-heading{grid-column:1/-1}.page-head{padding-top:15px}.bottom-nav{min-height:76px}.nav-btn{font-size:10px}.nav-btn svg{width:22px;height:22px}}
@media(max-width:370px){.app{padding-left:10px;padding-right:10px}.topbar{margin-left:-10px;margin-right:-10px;padding-left:10px;padding-right:10px;grid-template-columns:39px minmax(0,1fr) 39px}.round-action{width:38px;height:38px}.brand-name{font-size:17px;letter-spacing:.7px}.brand-sub{font-size:7px;letter-spacing:1px}.hero-content{padding-left:16px;max-width:73%}.food-image-wrap{height:94px}.filter-btn{font-size:10px;padding:9px 2px}.order-card{padding:11px}.order-total{font-size:20px}.bottom-nav{grid-template-columns:1fr 1fr 58px 1fr 1fr;padding:6px}.nav-plus{width:50px;height:50px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
@media print{body.print-mode{background:white}body.print-mode #app,body.print-mode .bottom-wrap,body.print-mode .draft-dock,body.print-mode .toast,body.print-mode dialog:not(#detailDialog){display:none!important}body.print-mode dialog#detailDialog{display:block!important;position:static;width:100%;max-width:none;max-height:none;padding:0;border:0;box-shadow:none;overflow:visible}body.print-mode dialog#detailDialog::backdrop{display:none}body.print-mode .dialog-inner{max-height:none;overflow:visible;padding:0}body.print-mode .close-btn,body.print-mode .detail-toolbar,body.print-mode .detail-main-action,body.print-mode .detail-item-controls,body.print-mode .add-another{display:none!important}}

/* Dedicated, focused order-taking workspace */
.take-page-head{padding:13px 2px 17px}.take-kicker{font-size:9px;font-weight:850;letter-spacing:2px;color:#a7833f;margin-bottom:4px}.take-page-head h1{font-size:32px}.take-page-head p{font-size:12px;color:#777;margin-top:5px}
.take-panel{background:#fff;border:1px solid #ececea;border-radius:22px;padding:14px;margin:0 0 13px;box-shadow:var(--shadow);min-width:0}.take-panel-head,.take-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.take-panel-head>div,.take-section-head>div{display:flex;align-items:center;gap:10px;min-width:0}.take-step{display:grid;place-items:center;width:31px;height:31px;flex:0 0 31px;border-radius:11px;background:#f2f1ed;color:#777;font-size:10px;font-weight:850}.take-panel h2{font-size:15px;line-height:1.2;margin:0;font-weight:850;letter-spacing:-.25px}.take-panel p{font-size:11px;color:#888;margin:4px 0 0;line-height:1.35}
.take-quick-card{margin:0;padding:8px;border-radius:17px;box-shadow:none;background:#f7f7f5}.take-quick-row{grid-template-columns:19px minmax(0,1fr) 105px;gap:8px}.take-quick-row .black-btn{font-size:11px;padding:0 10px;min-height:43px;white-space:nowrap}.take-quick-row .quick-entry{font-size:14px;min-height:50px}
.take-cart-list{display:grid;gap:7px}.take-cart-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:18px 10px 16px;color:#888;gap:5px}.take-empty-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:15px;background:#f4f4f2;color:#333;font-size:24px;margin-bottom:3px}.take-cart-empty strong{color:#333;font-size:13px}.take-cart-empty span:last-child{font-size:11px;line-height:1.45}
.take-cart-row{display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:10px;padding:9px;border:1px solid #f0f0ee;border-radius:16px;background:#fff}.take-cart-thumb{width:48px;height:48px;object-fit:cover;border-radius:12px;background:#eee}.take-cart-info{min-width:0}.take-cart-name{font-size:12px;line-height:1.25;font-weight:800;overflow-wrap:anywhere}.take-cart-detail{font-size:10px;color:#888;margin-top:4px}.take-cart-line-total{font-size:12px;font-weight:850;white-space:nowrap;text-align:right;align-self:start;padding-top:2px}.take-qty-row{display:flex;align-items:center;gap:5px;margin-top:7px}.take-qty-btn,.take-remove{display:grid;place-items:center;border:1px solid #eeeeec;background:#f6f6f4;color:#222;border-radius:9px;width:27px;height:27px;font-weight:750}.take-qty-value{min-width:20px;text-align:center;font-size:11px;font-weight:800}.take-remove{width:27px;margin-left:3px;color:#777;font-size:16px}
.take-cart-total{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #eee;padding:13px 2px 1px;margin-top:12px;font-size:12px;color:#777}.take-cart-total strong{font-size:21px;color:#111;letter-spacing:-.5px}.take-clear{font-size:11px!important}.take-inline-review{width:100%;margin-top:11px;min-height:43px;border-radius:14px;background:linear-gradient(145deg,#262626,#050505);color:#fff;font-size:12px;font-weight:800;box-shadow:0 5px 13px #0002}.take-inline-review:disabled{opacity:.35;box-shadow:none}
.take-menu-search{margin-bottom:11px}.take-menu-list{margin-top:11px}.take-dock{position:fixed;z-index:29;bottom:calc(84px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:min(calc(100% - 28px),720px);display:flex;align-items:center;gap:12px;padding:10px 11px 10px 15px;border-radius:19px;background:#fff;border:1px solid #ececea;box-shadow:0 10px 28px #0002}.take-dock-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}.take-dock-info strong{font-size:12px}.take-dock-info span{font-size:11px;color:#777}.take-dock .black-btn{min-height:42px;border-radius:13px;font-size:12px;padding:0 15px;white-space:nowrap}.nav-plus.active{outline:3px solid #1111;outline-offset:3px;transform:scale(1.04)}
@media(min-width:760px){.take-menu-list{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.take-menu-list .group-heading{grid-column:1/-1}}
@media(max-width:420px){.take-panel{padding:12px;border-radius:20px}.take-quick-row{grid-template-columns:17px minmax(0,1fr) 91px;gap:6px}.take-quick-row .black-btn{font-size:10px;padding:0 8px}.take-page-head h1{font-size:29px}.take-cart-row{grid-template-columns:43px minmax(0,1fr) auto;gap:8px;padding:8px}.take-cart-thumb{width:43px;height:43px}}


/* ===== Soft-touch theme: neumorphic surfaces, orange tactile accents ===== */
:root{--n-bg:#e3e4e7;--n-hi:#fbfbfc;--n-lo:#b6bac1;--n-ink:#25272b;--n-mute:#7a7f87;--n-or:#f77f0a;--n-or2:#ff9c3f;--n-ort:#a84a06;--n-well:#d5d7db;--n-line:rgba(110,116,128,.22);--n-pend:#a84a06;--n-prep:#3558b0;--n-done:#1f7a4d;
--rs:7px 7px 16px var(--n-lo),-7px -7px 16px var(--n-hi);--rm:4px 4px 10px var(--n-lo),-4px -4px 10px var(--n-hi);--in:inset 4px 4px 9px var(--n-lo),inset -4px -4px 9px var(--n-hi);
--knurl:repeating-linear-gradient(45deg,rgba(255,255,255,.6) 0 2px,rgba(0,0,0,.07) 2px 4px),repeating-linear-gradient(-45deg,rgba(255,255,255,.4) 0 2px,rgba(0,0,0,.06) 2px 4px);
--or-grad:linear-gradient(145deg,var(--n-or2),var(--n-or));--or-in:inset 3px 3px 7px rgba(140,55,0,.5),inset -3px -3px 7px rgba(255,175,95,.55)}
:root[data-theme="dark"]{color-scheme:dark;--n-bg:#2a2c30;--n-hi:#383b40;--n-lo:#16171a;--n-ink:#eceae6;--n-mute:#9a9ea6;--n-well:#222427;--n-ort:#ff9c3f;--n-pend:#ff9c3f;--n-prep:#93b2ff;--n-done:#6fd6a0}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--n-bg:#2a2c30;--n-hi:#383b40;--n-lo:#16171a;--n-ink:#eceae6;--n-mute:#9a9ea6;--n-well:#222427;--n-ort:#ff9c3f;--n-pend:#ff9c3f;--n-prep:#93b2ff;--n-done:#6fd6a0}}
body{background:var(--n-bg);color:var(--n-ink);font-family:"Avenir Next","Segoe UI Variable","Segoe UI",Inter,system-ui,-apple-system,Roboto,Arial,sans-serif}
.page-head h1,.section-title,.dialog-title,.group-heading,.order-empty strong,.hero h1,.brand-name{font-family:inherit;letter-spacing:-.01em;font-weight:700}
.brand-name{letter-spacing:.16em;font-weight:800;font-size:clamp(15px,4vw,19px)}.brand-sub{color:var(--n-mute)}.crown{fill:var(--n-or)}
.topbar{background:var(--n-bg);-webkit-backdrop-filter:none;backdrop-filter:none}
.round-action,.close-btn{background:var(--n-bg);border:0;color:var(--n-ink);box-shadow:var(--rm)}.round-action:active,.close-btn:active{box-shadow:var(--in)}
.hero{box-shadow:var(--rs);border-radius:28px}.eyebrow{color:var(--n-or2)}
.hero-arrow,.food-add{background:var(--knurl),linear-gradient(145deg,#f6f6f8,#d8d9dd);color:var(--n-or);border:3px solid #f7f7f8;font-weight:600;box-shadow:0 0 0 3px var(--n-or),3px 5px 10px rgba(0,0,0,.28)}
.hero-arrow:active,.food-add:active{box-shadow:0 0 0 3px var(--n-or),inset 2px 3px 6px rgba(0,0,0,.25)}
.quick-card,.take-quick-card{background:var(--n-bg);border:0;border-radius:24px;box-shadow:var(--rs);padding:10px}
.take-quick-card{background:transparent;box-shadow:none;padding:0}
.quick-row{background:var(--n-bg);border-radius:18px;box-shadow:var(--in);padding:4px 6px 4px 12px}
.quick-entry{color:var(--n-ink)}.quick-entry::placeholder,.searchbox input::placeholder,.pick-search::placeholder{color:var(--n-mute)}
.quick-search,.searchbox svg{stroke:var(--n-mute)}
.black-btn,.action-main,.take-inline-review,.setting-card button{background:var(--or-grad);color:#fff;border:0;text-shadow:0 1px 0 rgba(0,0,0,.18);box-shadow:var(--rm),inset 0 1px 0 rgba(255,255,255,.35)}
.black-btn:active,.action-main:active,.take-inline-review:active,.setting-card button:active{transform:none;filter:none;box-shadow:var(--or-in)}
.take-inline-review:disabled{box-shadow:none}
.match{background:var(--n-bg);border:0;box-shadow:var(--rm);color:inherit}.match:active{background:var(--n-bg);box-shadow:var(--in)}
.match small,.quick-note,.summaryline,.section-sub,.page-head p,.dialog-sub,.food-category,.menu-cat,.order-count,.order-time,.order-number,.draft-meta,.detail-item-sub,.item-line-detail,.take-cart-detail,.take-panel p,.setting-text span,.small-stat span,.draft-summary small,.take-dock-info span,.take-cart-empty,.order-empty,.price-choice small{color:var(--n-mute)}
.text-btn{color:var(--n-ort)}
.pill{background:var(--n-bg);border:0;color:var(--n-ink);box-shadow:var(--rm)}.pill.selected{background:var(--or-grad);color:#fff;box-shadow:var(--or-in)}
.category-row{padding:8px 10px 14px;margin:0 -10px}
.food-card,.menu-row,.setting-card,.take-panel,.order-panel{background:var(--n-bg);border:0;box-shadow:var(--rs)}
.food-card{border-radius:26px}.food-image-wrap{margin:8px 8px 0;border-radius:20px;height:100px;background:var(--n-well)}
.price-choice,.menu-price-btn,.pick-item-price button,.qty-control button,.take-qty-btn,.take-remove,.action-more,.plain-btn,.toolbar-btn,.detail-remove{background:var(--n-bg);border:0;color:var(--n-ink);box-shadow:var(--rm)}
.price-choice:active,.menu-price-btn:active,.pick-item-price button:active,.qty-control button:active,.take-qty-btn:active,.action-more:active,.plain-btn:active,.toolbar-btn:active{background:var(--n-bg);box-shadow:var(--in)}
.price-choice strong,.menu-price-btn{color:var(--n-ort)}.menu-price-btn{font-weight:800}
.order-panel{border-radius:28px}
.searchbox input,.pick-search{background:var(--n-bg);border:0;box-shadow:var(--in);color:var(--n-ink);border-radius:16px}
.searchbox input:focus,.pick-search:focus{background:var(--n-bg);box-shadow:var(--in),0 0 0 2px var(--n-or)}
.filter-group{background:var(--n-bg);border:0;border-radius:22px;padding:5px;box-shadow:var(--in)}
.filter-btn{color:var(--n-mute)}.filter-btn.selected{background:var(--or-grad);color:#fff;box-shadow:var(--rm),inset 0 1px 0 rgba(255,255,255,.35)}
.order-card,.take-cart-row,.draft-line,.pick-item,.summary-box,.detail-summary{background:var(--n-bg);border:0;box-shadow:var(--rm)}.order-card{border-radius:24px}
.item-line,.detail-item{border-color:var(--n-line)}.take-cart-total,.summary-row.total{border-color:var(--n-line)}
.summary-row,.take-cart-total{color:var(--n-mute)}.summary-row.total,.take-cart-total strong{color:var(--n-ink)}
.item-thumb,.menu-thumb,.take-cart-thumb{background:var(--n-well)}
.status{background:var(--n-bg);box-shadow:var(--in)}.status.pending{color:var(--n-pend);background:var(--n-bg)}.status.preparing{color:var(--n-prep);background:var(--n-bg)}.status.done{color:var(--n-done);background:var(--n-bg)}
.empty-symbol,.take-empty-icon,.setting-icon,.take-step{background:var(--n-bg);box-shadow:var(--in);color:var(--n-ort)}
.small-stat{background:var(--n-bg);border:0;box-shadow:var(--in)}
.take-kicker{color:var(--n-ort)}.toolbar-btn.danger{color:var(--n-mute)}
.bottom-nav,.draft-dock,.take-dock{background:var(--n-bg);border:0;box-shadow:var(--rs);-webkit-backdrop-filter:none;backdrop-filter:none}
.nav-btn{color:var(--n-mute)}.nav-btn.active{color:var(--n-ort);box-shadow:var(--in)}
.nav-plus{background:var(--knurl),linear-gradient(145deg,#f6f6f8,#d8d9dd);color:var(--n-or);border:3px solid #f7f7f8;font-weight:500;box-shadow:0 0 0 5px var(--n-or),var(--rs)}
.nav-plus.active{outline:0;transform:none;box-shadow:0 0 0 5px #c9600a,inset 3px 4px 8px rgba(0,0,0,.28)}
.dialog{background:var(--n-bg);color:var(--n-ink);border:0;border-radius:30px;box-shadow:0 24px 70px rgba(0,0,0,.4)}.dialog::backdrop{background:rgba(28,30,34,.5)}
/* Tactile switch (dark mode) */
.setting-card .switch{position:relative;flex:0 0 76px;width:76px;height:42px;padding:0;border-radius:21px;background:var(--n-well);color:inherit;text-shadow:none;box-shadow:var(--in);transition:background .25s}
.setting-card .switch:active{box-shadow:var(--in)}
.switch i{position:absolute;top:3px;left:3px;width:36px;height:36px;border-radius:50%;background:var(--knurl),linear-gradient(145deg,#f6f6f8,#d6d7db);border:2px solid #f7f7f8;box-shadow:2px 3px 6px rgba(0,0,0,.3);transition:transform .28s cubic-bezier(.3,1.35,.5,1)}
.switch::after{content:"";position:absolute;top:50%;right:13px;width:12px;height:12px;margin-top:-6px;border-radius:50%;border:2px solid rgba(0,0,0,.2)}
.setting-card .switch[aria-checked="true"]{background:var(--or-grad);box-shadow:inset 3px 4px 8px rgba(140,55,0,.55),inset -2px -2px 6px rgba(255,175,95,.5)}
.switch[aria-checked="true"] i{transform:translateX(34px)}
.switch[aria-checked="true"]::after{right:auto;left:15px;width:4px;height:14px;margin-top:-7px;border:0;border-radius:3px;background:rgba(120,45,0,.55)}
@media print{:root,:root[data-theme]{--n-bg:#fff;--n-ink:#111;--n-mute:#555;--n-hi:#fff;--n-lo:#ccc;--n-well:#eee;--n-ort:#111}}

/* ===== Orders page: just type, add, track ===== */
.topbar,.hero,.home-left>.section-head,#homeCategories,#popularGrid,#ordersSection>.section-head,#ordersSection .order-top-tools,#ordersSection .small-stats{display:none}
.app{max-width:720px;padding-top:calc(16px + env(safe-area-inset-top,0px))}
.home-grid{grid-template-columns:minmax(0,1fr);gap:16px}
.home-left .quick-card{margin-bottom:0;padding:12px}.home-left .quick-entry{font-size:16px;min-height:52px}.home-left .quick-row .black-btn{height:52px}
.order-panel{margin-top:0}
/* icons */
.plus-symbol{display:inline-grid;place-items:center}.plus-symbol svg,.take-empty-icon svg,.empty-symbol svg{stroke:currentColor;fill:none;stroke-linecap:round;stroke-linejoin:round}
.plus-symbol svg{width:18px;height:18px;stroke-width:2.6}.take-empty-icon svg,.empty-symbol svg{width:24px;height:24px;stroke-width:1.9}
.nav-plus svg{width:28px;height:28px;stroke:currentColor;stroke-width:2.6;fill:none;stroke-linecap:round}
.nav-btn.active svg{fill:rgba(247,127,10,.18)}
.setting-icon svg,.toolbar-btn span svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.toolbar-btn.danger{color:#b3382c}

/* ===== Home-first navigation and clean restaurant landing ===== */
.restaurant-home{position:relative;overflow:hidden;min-height:calc(100dvh - 170px);display:flex;flex-direction:column;justify-content:center;padding:30px 24px 26px;border-radius:30px;background:linear-gradient(155deg,#fff 0%,#fffaf3 65%,#f8e7d3 100%);border:1px solid #f0e6da;box-shadow:0 18px 50px rgba(73,45,17,.07)}
.restaurant-home:before{content:"";position:absolute;width:280px;height:280px;border-radius:50%;right:-125px;top:-110px;background:radial-gradient(circle,#f5c98e 0%,rgba(245,201,142,.15) 60%,transparent 72%)}
.home-brand-mark{width:54px;height:46px;display:grid;place-items:center;color:#b86b20;margin-bottom:22px}.home-brand-mark svg{width:50px;fill:currentColor}
.home-kicker{font-size:10px;font-weight:800;letter-spacing:3px;color:#a56b35}.restaurant-home h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(38px,9vw,58px);line-height:1.02;letter-spacing:-1.6px;margin:10px 0 12px;color:#201811}.restaurant-home>p{font-size:15px;color:#7d6c5b;margin:0 0 30px}.home-actions{display:flex;flex-direction:column;gap:10px;max-width:330px}.home-primary,.home-secondary{min-height:50px;border-radius:15px;padding:0 18px;font-weight:750;text-align:left}.home-primary{display:flex;align-items:center;justify-content:space-between;background:#211a14;color:#fff}.home-primary span{font-size:22px;font-weight:400}.home-secondary{background:#fff;color:#30261d;border:1px solid #e9ded1}.home-feature{display:flex;align-items:center;justify-content:space-between;margin-top:42px;padding-top:18px;border-top:1px solid #eadcc9;gap:14px}.home-feature>div:first-child{display:flex;flex-direction:column;gap:5px}.feature-label{font-size:9px;letter-spacing:1.8px;color:#a56b35;font-weight:800}.home-feature strong{font-family:Georgia,serif;font-size:15px;color:#35271c}.feature-mark{font-family:Georgia,serif;font-size:22px;font-weight:800;color:#c58b4e;border:1px solid #dfc39f;border-radius:50%;width:48px;height:48px;display:grid;place-items:center;flex:0 0 auto}
.bottom-nav{grid-template-columns:repeat(5,minmax(0,1fr));min-height:66px}.nav-plus{display:none}.nav-btn.orders-center{color:#171717}.nav-btn.orders-center.active{color:#b76418;background:#fff4e7;box-shadow:none}.order-entry-card{margin:8px 0 16px}.order-entry-card .black-btn{font-size:12px;padding:0 12px;white-space:nowrap}.order-entry-card .plus-symbol{display:none}.app{padding-top:calc(16px + env(safe-area-inset-top,0px))}
/* ===== Keyboard-safe navigation ===== */
:root{--knurl:repeating-linear-gradient(45deg,rgba(255,255,255,.35) 0 2px,rgba(0,0,0,.035) 2px 4px)}
.bottom-nav{min-height:62px;grid-template-columns:1fr 1fr 56px 1fr 1fr;padding:6px 8px}
.nav-plus{width:46px;height:46px;border-width:2px;font-size:0;box-shadow:0 0 0 3px var(--n-or),var(--rm)}
.nav-plus svg{width:20px;height:20px;stroke-width:2.4}
.nav-plus.active{box-shadow:0 0 0 3px #c9600a,inset 2px 3px 6px rgba(0,0,0,.25)}
.draft-dock,.take-dock{bottom:calc(80px + env(safe-area-inset-bottom,0px))}
body.kb .bottom-wrap{display:none}
body.kb .draft-dock,body.kb .take-dock{bottom:calc(8px + env(safe-area-inset-bottom,0px))}
body.kb .toast{bottom:calc(76px + env(safe-area-inset-bottom,0px))}

/* Premium restaurant-home redesign layered onto the latest Order Desk build */
.premium-restaurant-hero{
  position:relative;isolation:isolate;overflow:hidden;min-height:min(780px,calc(100dvh - 112px));
  display:flex;flex-direction:column;justify-content:space-between;gap:30px;padding:clamp(22px,4vw,44px);
  border-radius:30px;border:1px solid rgba(255,255,255,.16);color:#fff;background-color:#111820;
  background-image:linear-gradient(90deg,rgba(5,10,16,.88) 0%,rgba(5,10,16,.70) 38%,rgba(5,10,16,.15) 100%),linear-gradient(0deg,rgba(5,10,16,.76) 0%,transparent 35%),url("data:image/png;base64,