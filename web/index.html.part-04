const IMG={"hero":"data:image/jpeg;base64,","chaap":"data:image/jpeg;base64,","malai":"data:image/jpeg;base64,","tikka":"data:image/jpeg;base64,","momo":"data:image/jpeg;base64,","paneerMomo":"data:image/jpeg;base64,","rice":"data:image/jpeg;base64,","fries":"data:image/jpeg;base64,","cold":"data:image/jpeg;base64,"};
const $=id=>document.getElementById(id);
const IC={print:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V3h10v6"/><path d="M7 17H5a1 1 0 0 1-1-1v-5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v5a1 1 0 0 1-1 1h-2"/><rect x="7" y="14" width="10" height="7" rx="1"/></svg>',share:'<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="m8.2 10.8 7.6-3.6M8.2 13.2l7.6 3.6"/></svg>',edit:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13.5 6.5 4 4"/></svg>',trash:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>'};
const fmt=n=>'₹'+Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:2});
const categoryTabs=['All','Chaap','Gravy','Tikka','Momos','Chinese','Indian','Drinks'];
const popularNames=['Afghani Chaap','Malai Chaap Special','Malai Paneer Tikka','Veg Momos','Paneer Momos','Fried Rice'];
const KEY='charlie-orders-v1', DRAFT_KEY='charlie-draft-v1';
function safeLoad(key,fallback){try{const v=JSON.parse(localStorage.getItem(key)||'null');return v==null?fallback:v}catch{return fallback}}
let orders=safeLoad(KEY,[]);if(!Array.isArray(orders))orders=[];
orders=orders.map(o=>{const status=o.status||((o.done)?'done':'pending');const items=Array.isArray(o.items)?o.items.map(i=>({...i,qty:Math.max(1,Number(i.qty)||1),rate:Number(i.rate)||0,size:i.size||'h'})):[];return {...o,items,status,done:status==='done'||!!o.done,total:Number(o.total??items.reduce((s,i)=>s+i.qty*i.rate,0)),time:o.time||''}});
let draftItems=safeLoad(DRAFT_KEY,[]);if(!Array.isArray(draftItems))draftItems=[];
let activeTab='orders',homeCategory='All',menuCategory='All',activeFilter='pending',activeHistoryFilter='done',sizeItemName='',matchContext=null,detailOrderId=null,detailEditing=false,pickerReturnDetailId=null;
let chosenByLine={home:{},modal:{},take:{}};
function saveOrders(){try{localStorage.setItem(KEY,JSON.stringify(orders))}catch(e){showToast('Could not save in this browser')}}
function saveDraft(){try{localStorage.setItem(DRAFT_KEY,JSON.stringify(draftItems))}catch(e){}}
function normalize(s){return String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/&/g,' and ').replace(/[^a-z0-9\s]/g,' ').replace(/\s+/g,' ').trim()}
function phon(s){return normalize(s).split(" ").map(w=>{const fixes={afgani:"afghani",afghani:"afghani",chap:"chaap",chaap:"chaap",panner:"paneer",panir:"paneer",momo:"momos",noodle:"noodles",chilli:"chili",kabab:"kebab",fool:"full",ful:"full",haf:"half",hlaf:"half",adha:"half",aadha:"half",singapuri:"singapore",haka:"hakka",macroni:"macaroni",rise:"rice",con:"corn"};return fixes[w]||w.replace(/ph/g,"f").replace(/[ckq]/g,"k").replace(/(.)\1+/g,"$1").replace(/(.{3,})s$/,"$1")}).join(" ")}
function levenshtein(a,b){const row=Array.from({length:b.length+1},(_,i)=>i);for(let i=1;i<=a.length;i++){let prev=row[0];row[0]=i;for(let j=1;j<=b.length;j++){let cur=row[j];row[j]=Math.min(row[j]+1,row[j-1]+1,prev+(a[i-1]===b[j-1]?0:1));prev=cur}}return row[b.length]}
function itemScore(query,item){const q=phon(query);if(!q)return 0;let best=0;const qw=q.split(" ").filter(Boolean);for(const n of [item.n,...(item.a||[])]){const v=phon(n);if(!v)continue;if(q===v)return 1;if(v.includes(q)||q.includes(v))best=Math.max(best,Math.min(q.length,v.length)/Math.max(q.length,v.length)*.99);const vw=v.split(" ").filter(Boolean);let matched=0;for(const w of qw){let tokenBest=0;for(const x of vw){if(w===x){tokenBest=1;break}const d=levenshtein(w,x),max=Math.max(w.length,x.length);if(Math.min(w.length,x.length)>=3){if(d===1)tokenBest=Math.max(tokenBest,.86);else if(max>=7&&d===2)tokenBest=Math.max(tokenBest,.68);if(x.startsWith(w)||w.startsWith(x))tokenBest=Math.max(tokenBest,Math.min(w.length,x.length)/max*.92)}}matched+=tokenBest}const coverage=matched/Math.max(qw.length,1),precision=matched/Math.max(vw.length,1);best=Math.max(best,coverage*.78+precision*.22);if(qw.length===1&&vw.some(x=>x.startsWith(qw[0])||qw[0].startsWith(x)))best=Math.max(best,.72)}return Math.min(1,best)}
function parseLine(line){let text=String(line||'').trim();let qty=1;const wordQty={one:1,a:1,an:1,two:2,three:3,four:4,five:5,six:6};let m=text.match(/^(\d+)\s*(?:x|×)?\s*(.*)$/i);if(m&&m[2].trim()){qty=Math.min(100,Math.max(1,Number(m[1])||1));text=m[2].trim()}else{const w=text.match(/^(one|a|an|two|three|four|five|six)\s+(.+)$/i);if(w){qty=wordQty[w[1].toLowerCase()]||1;text=w[2].trim()}}let size=null;if(/\b(full plate|full|ful|fool|pura|large)\b/i.test(text)){size='f';text=text.replace(/\b(full plate|full|ful|fool|pura|large)\b/ig,' ')}else if(/\b(half plate|half|hlaf|haf|adha|aadha|small)\b/i.test(text)){size='h';text=text.replace(/\b(half plate|half|hlaf|haf|adha|aadha|small)\b/ig,' ')}text=text.replace(/\s+/g,' ').trim();return {raw:line.trim(),query:text,qty,size}}
function matchesFor(line){const p=parseLine(line);if(!p.query)return[];return menu.map(item=>({item,score:itemScore(p.query,item)})).sort((a,b)=>b.score-a.score).slice(0,8)}
function rateFor(item,size){return item[size==='f'?'f':'h']}
const FOOD_PHOTOS={chaap:IMG.chaap,malai:IMG.malai,tikka:IMG.tikka,momos:IMG.momo,paneerMomos:IMG.paneerMomo,fries:IMG.fries,corn:IMG.chaap,manchurian:IMG.chaap,springRoll:IMG.chaap,rice:IMG.rice,noodles:IMG.rice,drinks:IMG.cold};
function photoFor(name){const n=normalize(name);if(/paneer.*momo|momo.*paneer/.test(n))return FOOD_PHOTOS.paneerMomos;if(/momo/.test(n))return FOOD_PHOTOS.momos;if(/malai chaap/.test(n))return FOOD_PHOTOS.malai;if(/tikka/.test(n))return FOOD_PHOTOS.tikka;if(/chaap/.test(n))return FOOD_PHOTOS.chaap;if(/crispy corn/.test(n))return FOOD_PHOTOS.corn;if(/manchurian/.test(n))return FOOD_PHOTOS.manchurian;if(/spring roll/.test(n))return FOOD_PHOTOS.springRoll;if(/fries|potato/.test(n))return FOOD_PHOTOS.fries;if(/noodle|macaroni|chow mein/.test(n))return FOOD_PHOTOS.noodles;if(/fried rice|rice|chawal|rajma|dal/.test(n))return FOOD_PHOTOS.rice;if(/drink|coffee|mint|mojito|shake|watermelon|lagoon|juice|beverage/.test(n))return FOOD_PHOTOS.drinks;return FOOD_PHOTOS.chaap}
function attachFoodImageFallback(img,name){img.addEventListener('error',()=>{if(img.dataset.fallback==='1'){img.style.visibility='hidden';return}img.dataset.fallback='1';img.src=fallbackPhoto(name)},{once:true})}
function fallbackPhoto(name){const n=normalize(name);if(/momo/.test(n))return IMG.momo;if(/tikka/.test(n))return IMG.tikka;if(/malai chaap/.test(n))return IMG.malai;return IMG.chaap}
function categoryFor(item){if(item.c==='Chaap Dry')return'Chaap';if(item.c==='Beverages')return'Drinks';if(item.c==='Momo')return'Momos';return item.c}
function categoryMatches(item,cat){return cat==='All'||categoryFor(item)===cat}
function setTab(tab,scroll=true){activeTab=tab;document.body.dataset.tab=tab;document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.dataset.view===tab));document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));if(tab==='orders'){renderComposer('home');renderOrders();}if(tab==='take'){renderComposer('take');renderTakeCart();}if(tab==='menu'){renderMenu();if(window.__ccShared){fetch('/api/menu'+(window.__ccStaff?'?all=1':''),{credentials:'same-origin',cache:'no-store'}).then(r=>r.json()).then(d=>{if(d&&Array.isArray(d.items)&&d.items.length){const fresh=d.items.map(it=>({n:String(it.n||''),c:String(it.c||'Other'),h:it.h==null?null:Number(it.h),f:it.f==null?null:Number(it.f),hLabel:it.hLabel||'',fLabel:it.fLabel||'',a:Array.isArray(it.a)?it.a:[],available:it.available!==false,custom:!!it.custom,image:it.image||''})).filter(x=>x.n);menu.splice(0,menu.length,...fresh);try{renderMenu();}catch(_){}try{refreshMenuViews();}catch(_){}}}).catch(()=>{})}}if(tab==='history')renderHistory();if(tab==='more')renderMoreStats();renderDraftDock();if(scroll)window.scrollTo({top:0,behavior:'smooth'})}
function showToast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(window.__toastTimer);window.__toastTimer=setTimeout(()=>t.classList.remove('show'),1900)}
function getOrderTime(){return new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}
function nextOrderId(){return orders.reduce((m,o)=>Math.max(m,Number(o.id)||0),0)+1}
function recalcOrder(o){o.total=o.items.reduce((s,i)=>s+(Number(i.qty)||1)*(Number(i.rate)||0),0);o.done=o.status==='done';return o}
function addOrderItems(items){if(!items.length)return null;const o={id:nextOrderId(),items:items.map(i=>({...i})),total:items.reduce((s,i)=>s+i.qty*i.rate,0),done:false,status:'pending',time:getOrderTime()};orders.push(o);saveOrders();renderOrders();renderHistory();renderMoreStats();return o}
function renderComposer(prefix){const entry=$(prefix+'Entry'),host=$(prefix+'Matches'),summary=$(prefix+'Summary'),lines=entry.value.split('\n').map(s=>s.trim()).filter(Boolean);host.innerHTML='';let total=0,allGood=lines.length>0;const map=chosenByLine[prefix];lines.forEach((line,i)=>{const p=parseLine(line),matches=matchesFor(line),chosen=map[line]?menu.find(m=>m.n===map[line]):null,top=chosen?{item:chosen,score:1}:matches[0];let rate=null,confident=!!top&&top.score>=.48;if(confident)rate=rateFor(top.item,p.size||'h');if(!confident||rate==null)allGood=false;else total+=rate*p.qty;const b=document.createElement('button');b.className='match';b.type='button';const left=document.createElement('span'),right=document.createElement('span');left.innerHTML='<strong></strong><small></small>';left.querySelector('strong').textContent=line;left.querySelector('small').textContent=confident?(chosen?'✓ ':'')+top.item.n+' · '+(p.size==='f'?'Full':p.size==='h'?'Half':'Half by default'): 'Tap to choose dish';right.className='match-price';right.innerHTML='<span></span><small></small>';right.querySelector('span').textContent=rate!=null?fmt(rate*p.qty):'Check rate';right.querySelector('small').textContent=p.qty+' × '+(p.size==='f'?'Full':p.size==='h'?'Half':'Half default');b.append(left,right);b.onclick=()=>openMatchPicker(prefix,line);host.append(b)});host.hidden=!lines.length;summary.hidden=!lines.length;summary.textContent=lines.length?(allGood?`Estimated total · ${fmt(total)}`:'Check any uncertain match or price before adding.'):'';if(prefix==='home')$('homeAdd').disabled=!lines.length;if(prefix==='modal')$('modalAdd').disabled=!lines.length;if(prefix==='take')$('takeAdd').disabled=!lines.length;}
function openMatchPicker(prefix,line){matchContext={prefix,line};$('matchSearch').value='';renderMatchOptions('');$('matchDialog').showModal()}
function renderMatchOptions(term){const host=$('matchOptions');host.innerHTML='';const ctx=matchContext;if(!ctx)return;const candidates=matchesFor(ctx.line);const t=normalize(term);candidates.filter(m=>!t||normalize(m.item.n+' '+m.item.c).includes(t)).forEach(m=>{const p=parseLine(ctx.line),item=m.item;const row=document.createElement('button');row.className='match';row.type='button';const left=document.createElement('span'),right=document.createElement('span');left.innerHTML='<strong></strong><small></small>';left.querySelector('strong').textContent=item.n;left.querySelector('small').textContent=item.c+' · '+Math.round(m.score*100)+'% match';right.className='match-price';const h=item.h!=null?`Half ${fmt(item.h)}`:'Half —',f=item.f!=null?`Full ${fmt(item.f)}`:'Full —';right.textContent=(p.size==='f'?f:p.size==='h'?h:h)+' / '+(p.size==='f'?'Full':p.size==='h'?'Half':'default');row.append(left,right);row.onclick=()=>{chosenByLine[ctx.prefix][ctx.line]=item.n;$('matchDialog').close();renderComposer(ctx.prefix)};host.append(row)});if(!host.children.length)host.innerHTML='<div class="order-empty"><strong>No matches</strong><p>Try a shorter dish name.</p></div>'}
function commitComposer(prefix){const entry=$(prefix+'Entry'),lines=entry.value.split('\n').map(s=>s.trim()).filter(Boolean);if(!lines.length){entry.focus();return}const items=[],issues=[];for(const line of lines){const p=parseLine(line),c=chosenByLine[prefix][line],found=c?{item:menu.find(m=>m.n===c),score:1}:matchesFor(line)[0];if(!found||!found.item||found.score<.48){issues.push(line+' — choose a dish');continue}const size=p.size||'h',rate=rateFor(found.item,size);if(rate==null){issues.push(line+' — price not listed');continue}items.push({name:found.item.n,qty:p.qty,size,rate,source:line})}if(issues.length){alert('Please check these items before adding the order:\n\n'+issues.join('\n'));return}const o=addOrderItems(items);entry.value='';chosenByLine[prefix]={};renderComposer(prefix);if(prefix==='modal')$('quickDialog').close();setTab('orders',false);renderOrders();showToast('Order #'+o.id+' added');setTimeout(()=>$('ordersSection').scrollIntoView({behavior:'smooth',block:'start'}),80)}
function addToDraft(item,size,qty=1){const rate=rateFor(item,size);if(rate==null){showToast('This size has no listed rate');return}const existing=draftItems.find(i=>i.name===item.n&&i.size===size);if(existing)existing.qty+=qty;else draftItems.push({name:item.n,qty,size,rate,sizeLabel:item[size==='f'?'fLabel':'hLabel']||(size==='f'?'Full':'Half')});saveDraft();renderDraftDock();renderTakeCart();showToast(item.n+' added')}
function renderDraftDock(){const count=draftItems.reduce((s,i)=>s+(Number(i.qty)||0),0),total=draftItems.reduce((s,i)=>s+(Number(i.qty)||0)*(Number(i.rate)||0),0);$('draftDock').hidden=!draftItems.length||activeTab==='take';$('draftCount').textContent=count+' item'+(count===1?'':'s')+' in order';$('draftTotal').textContent='Order total · '+fmt(total);$('takeDock').hidden=!draftItems.length||activeTab!=='take';$('takeDockCount').textContent=count+' item'+(count===1?'':'s')+' in this order';$('takeDockTotal').textContent='Total · '+fmt(total)}
function addTakeLinesToDraft(){const entry=$('takeEntry'),lines=entry.value.split('\n').map(s=>s.trim()).filter(Boolean);if(!lines.length){entry.focus();return}const validated=[],issues=[];for(const line of lines){const p=parseLine(line),chosen=chosenByLine.take[line],found=chosen?{item:menu.find(m=>m.n===chosen),score:1}:matchesFor(line)[0];if(!found||!found.item||found.score<.48){issues.push(line+' — choose a dish');continue}const size=p.size||'h',rate=rateFor(found.item,size);if(rate==null){issues.push(line+' — price not listed');continue}validated.push({name:found.item.n,qty:p.qty,size,rate})}if(issues.length){alert('Please check these items before placing the order:\n\n'+issues.join('\n'));return}const combined=draftItems.map(i=>({...i}));for(const v of validated){const current=combined.find(i=>i.name===v.name&&i.size===v.size);if(current)current.qty+=v.qty;else combined.push(v)}const o=addOrderItems(combined);draftItems=[];saveDraft();entry.value='';entry.style.height='auto';chosenByLine.take={};renderComposer('take');renderTakeCart();renderDraftDock();renderOrders();renderHistory();setTab('orders',false);showToast('Order #'+o.id+' placed');setTimeout(()=>$('ordersSection').scrollIntoView({behavior:'smooth',block:'start'}),80)}
function renderTakeCart(){const host=$('takeCartList');if(!host)return;host.innerHTML='';const count=draftItems.reduce((sum,item)=>sum+(Number(item.qty)||0),0),total=draftItems.reduce((sum,item)=>sum+(Number(item.qty)||0)*(Number(item.rate)||0),0);$('takeCartMeta').textContent=draftItems.length?draftItems.length+' dish'+(draftItems.length===1?'':'es')+' · '+count+' total item'+(count===1?'':'s'):'Nothing added yet';$('takeCartTotal').textContent=fmt(total);$('takeClear').hidden=!draftItems.length;$('takeReview').disabled=!draftItems.length;if(!draftItems.length){host.innerHTML='<div class="take-cart-empty"><span class="take-empty-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span><strong>No items added</strong></div>';return}draftItems.forEach((item,index)=>{const row=document.createElement('div');row.className='take-cart-row';const img=document.createElement('img');img.className='take-cart-thumb';img.src=photoFor(item.name);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(item.name)};img.alt='';const info=document.createElement('div');info.className='take-cart-info';const name=document.createElement('div');name.className='take-cart-name';name.textContent=item.name;const detail=document.createElement('div');detail.className='take-cart-detail';detail.textContent=(item.sizeLabel||(item.size==='f'?'Full':'Half'))+' · '+fmt(item.rate)+' each';const qty=document.createElement('div');qty.className='take-qty-row';const minus=document.createElement('button');minus.type='button';minus.className='take-qty-btn';minus.textContent='−';minus.setAttribute('aria-label','Decrease '+item.name);minus.onclick=()=>{if(item.qty>1)item.qty--;else draftItems.splice(index,1);saveDraft();renderTakeCart();renderDraftDock()};const value=document.createElement('span');value.className='take-qty-value';value.textContent=item.qty;const plus=document.createElement('button');plus.type='button';plus.className='take-qty-btn';plus.textContent='+';plus.setAttribute('aria-label','Increase '+item.name);plus.onclick=()=>{item.qty++;saveDraft();renderTakeCart();renderDraftDock()};const remove=document.createElement('button');remove.type='button';remove.className='take-remove';remove.textContent='×';remove.setAttribute('aria-label','Remove '+item.name);remove.onclick=()=>{draftItems.splice(index,1);saveDraft();renderTakeCart();renderDraftDock()};qty.append(minus,value,plus,remove);info.append(name,detail,qty);const lineTotal=document.createElement('div');lineTotal.className='take-cart-line-total';lineTotal.textContent=fmt(item.qty*item.rate);row.append(img,info,lineTotal);host.append(row)})}
function openSizePicker(name){const item=menu.find(m=>m.n===name);if(!item)return;sizeItemName=name;$('sizeTitle').textContent=item.n;$('sizeSub').textContent='Choose size to add';$('sizeHalf').textContent=item.h!=null?`${item.hLabel||'Half'} · ${fmt(item.h)}`:`${item.hLabel||'Half'} · —`;$('sizeFull').textContent=item.f!=null?`${item.fLabel||'Full'} · ${fmt(item.f)}`:`${item.fLabel||'Full'} · —`;$('sizeHalf').disabled=item.h==null;$('sizeFull').disabled=item.f==null;$('sizeDialog').showModal()}
function renderPopular(){const host=$('popularGrid');host.innerHTML='';let items;if(homeCategory==='All')items=popularNames.map(n=>menu.find(m=>m.n===n)).filter(Boolean);else items=menu.filter(m=>categoryMatches(m,homeCategory)).slice(0,6);items.forEach(item=>{const card=document.createElement('article');card.className='food-card';const imgwrap=document.createElement('div');imgwrap.className='food-image-wrap';const img=document.createElement('img');img.className='food-image';img.src=photoFor(item.n);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(item.n)};img.alt=item.n;img.loading='lazy';const plus=document.createElement('button');plus.className='food-add';plus.type='button';plus.textContent='+';plus.setAttribute('aria-label','Choose size for '+item.n);plus.onclick=()=>openSizePicker(item.n);imgwrap.append(img,plus);const info=document.createElement('div');info.className='food-info';const title=document.createElement('div');title.className='food-name';title.textContent=item.n;const cat=document.createElement('div');cat.className='food-category';cat.textContent=categoryFor(item);const prices=document.createElement('div');prices.className='price-pair';[['h',item.hLabel||'Half'],['f',item.fLabel||'Full']].forEach(([size,label])=>{if(rateFor(item,size)==null)return;const b=document.createElement('button');b.type='button';b.className='price-choice';b.innerHTML='<strong></strong><small></small>';b.querySelector('strong').textContent=fmt(rateFor(item,size));b.querySelector('small').textContent=label.toUpperCase();b.onclick=()=>addToDraft(item,size);prices.append(b)});info.append(title,cat,prices);card.append(imgwrap,info);host.append(card)});document.querySelectorAll('#homeCategories [data-category]').forEach(b=>b.classList.toggle('selected',b.dataset.category===homeCategory))}
function renderCategoryPills(targetId,selected,onSelect){const host=$(targetId);host.innerHTML='';categoryTabs.forEach(cat=>{const b=document.createElement('button');b.type='button';b.className='pill'+(cat===selected?' selected':'');b.dataset.category=cat;b.textContent=cat;b.onclick=()=>onSelect(cat);host.append(b)})}
function orderStatus(o){return 'placed'}
function statusPill(status){const b=document.createElement('span');b.className='status pending';b.textContent='Placed';return b}
function orderMatchesFilter(o,filter){return true}
function orderMatchesSearch(o,q){if(!q)return true;return String(o.id).includes(q)||normalize(o.items.map(i=>i.name).join(' ')).includes(normalize(q))}
function renderOrderList(hostId,filter,search=''){const host=$(hostId);host.innerHTML='';const ccHistory=hostId==='historyList';let visible=orders.filter(o=>{const st=(typeof orderStatus==='function')?orderStatus(o):'pending';if(!ccHistory&&(st==='done'||st==='cancelled'))return false;return orderMatchesFilter(o,filter)&&orderMatchesSearch(o,search)}).sort((a,b)=>Number(b.id)-Number(a.id));if(!visible.length){const empty=document.createElement('div');empty.className='order-empty';empty.innerHTML='<div class="empty-symbol"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg></div><strong>'+(search?'No matching orders':'No orders yet')+'</strong><p>'+(search?'Try a different order number or dish.':'New orders will appear here.')+'</p>';if(filter!=='done'){const btn=document.createElement('button');btn.className='black-btn';btn.textContent='+ Add order';btn.onclick=()=>openQuickDialog();empty.append(btn)}host.append(empty);return}visible.forEach(o=>host.append(renderOrderCard(o)))}
function renderOrderCard(o){const card=document.createElement('article');card.className='order-card';card.tabIndex=0;card.setAttribute('aria-label','Open order '+o.id);card.onclick=()=>openOrderDetail(o.id);card.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openOrderDetail(o.id)}};const head=document.createElement('div');head.className='order-head';const meta=document.createElement('div');meta.className='order-meta';const num=document.createElement('div');num.className='order-number';num.textContent='ORDER #'+o.id;const count=document.createElement('div');count.className='order-count';count.textContent=o.items.length+' item'+(o.items.length===1?'':'s')+' · '+(o.time||'');const statusline=document.createElement('div');statusline.style.marginTop='6px';statusline.append(statusPill(orderStatus(o)));meta.append(num,count,statusline);const total=document.createElement('div');total.className='order-total';total.textContent=fmt(o.total);head.append(meta,total);card.append(head);const lines=document.createElement('div');lines.className='item-lines';o.items.slice(0,5).forEach(i=>{const row=document.createElement('div');row.className='item-line';const img=document.createElement('img');img.className='item-thumb';img.src=photoFor(i.name);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(i.name)};img.alt='';const info=document.createElement('div');info.className='item-line-info';const name=document.createElement('div');name.className='item-line-name';name.textContent=i.name;const det=document.createElement('div');det.className='item-line-detail';det.textContent=i.qty+' × '+(i.sizeLabel||(i.size==='f'?'Full':'Half'))+' · '+fmt(i.rate)+' each';info.append(name,det);const amount=document.createElement('div');amount.className='item-line-total';amount.textContent=fmt(i.qty*i.rate);row.append(img,info,amount);lines.append(row)});if(o.items.length>5){const more=document.createElement('div');more.className='item-line-detail';more.style.padding='6px 2px';more.textContent='+'+(o.items.length-5)+' more items';lines.append(more)}card.append(lines);const actions=document.createElement('div');actions.className='order-actions';const action=document.createElement('button');action.className='action-main';action.type='button';action.textContent='View order';action.onclick=e=>{e.stopPropagation();openOrderDetail(o.id)};const more=document.createElement('button');more.className='action-more';more.type='button';more.textContent='···';more.setAttribute('aria-label','Order details');more.onclick=e=>{e.stopPropagation();openOrderDetail(o.id)};actions.append(action,more);card.append(actions);return card}
function renderOrders(){$('activeCount').textContent=orders.length+' Orders';$('activeCount').className='status pending';renderOrderList('homeOrderList','all',$('orderSearch').value||'')}
function advanceStatus(id){const o=orders.find(o=>String(o.id)===String(id));if(!o)return;const st=orderStatus(o);o.status=st==='pending'?'preparing':st==='preparing'?'done':'pending';o.done=o.status==='done';recalcOrder(o);saveOrders();renderOrders();renderHistory();renderMoreStats();if(detailOrderId===o.id)renderOrderDetail();showToast(o.status==='done'?'Order completed':o.status==='preparing'?'Order is preparing':'Order reopened')}
function openQuickDialog(){setTab('take');setTimeout(()=>$('takeEntry').focus(),80)}
function renderMenu(){renderCategoryPills('menuCategories',menuCategory,cat=>{menuCategory=cat;renderMenu()});const q=normalize($('menuSearch').value),host=$('menuList');host.innerHTML='';let items=menu.filter(item=>categoryMatches(item,menuCategory)&&(!q||normalize(item.n+' '+item.c+' '+(item.a||[]).join(' ')).includes(q)));if(!items.length){host.innerHTML='<div class="order-empty"><strong>No menu items found</strong><p>Try another spelling or category.</p></div>';return}let lastCat='';items.forEach(item=>{const cat=categoryFor(item);if(cat!==lastCat){const h=document.createElement('h2');h.className='group-heading';h.textContent=cat;host.append(h);lastCat=cat}const row=document.createElement('article');row.className='menu-row';const img=document.createElement('img');img.className='menu-thumb';img.src=photoFor(item.n);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(item.n)};img.alt=item.n;img.loading='lazy';const main=document.createElement('div');main.className='menu-main';const tr=document.createElement('div');tr.className='menu-title-row';const title=document.createElement('div');title.className='menu-name';title.textContent=item.n;tr.append(title);const catText=document.createElement('div');catText.className='menu-cat';catText.textContent=item.c;const prices=document.createElement('div');prices.className='menu-prices';[['h',item.hLabel||'Half'],['f',item.fLabel||'Full']].forEach(([size,label])=>{if(rateFor(item,size)==null)return;const b=document.createElement('button');b.className='menu-price-btn';b.textContent=label+' · '+fmt(rateFor(item,size));b.onclick=()=>addToDraft(item,size);prices.append(b)});main.append(tr,catText,prices);row.append(img,main);host.append(row)})}
function renderHistory(){const total=orders.reduce((s,o)=>s+o.total,0);$('historyCount').textContent=orders.length;$('todayCount').textContent=orders.length;$('completedTotal').textContent=fmt(total);renderOrderList('historyList','all',$('historySearch').value||'')}
function renderMoreStats(){/* all summary numbers remain in the working views */}
function openDraft(){renderDraftDialog();$('draftDialog').showModal()}
function renderDraftDialog(){const host=$('draftLines');host.innerHTML='';if(!draftItems.length){host.innerHTML='<div class="order-empty"><strong>Your order is empty</strong><p>Choose items from the menu first.</p></div>';$('placeDraft').disabled=true;$('draftSummaryBox').innerHTML='';return}$('placeDraft').disabled=false;draftItems.forEach((it,index)=>{const row=document.createElement('div');row.className='draft-line';const img=document.createElement('img');img.src=photoFor(it.name);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(it.name)};img.alt='';const info=document.createElement('div');const name=document.createElement('div');name.className='draft-name';name.textContent=it.name;const meta=document.createElement('div');meta.className='draft-meta';meta.textContent=(it.sizeLabel||(it.size==='f'?'Full':'Half'))+' · '+fmt(it.rate)+' each';const qty=document.createElement('div');qty.className='qty-control';const minus=document.createElement('button');minus.textContent='−';minus.onclick=()=>{it.qty--;if(it.qty<1)draftItems.splice(index,1);saveDraft();renderDraftDock();renderTakeCart();renderDraftDialog()};const n=document.createElement('span');n.textContent=it.qty;const plus=document.createElement('button');plus.textContent='+';plus.onclick=()=>{it.qty++;saveDraft();renderDraftDock();renderTakeCart();renderDraftDialog()};qty.append(minus,n,plus);info.append(name,meta,qty);const price=document.createElement('div');price.className='draft-price';price.textContent=fmt(it.qty*it.rate);row.append(img,info,price);host.append(row)});const total=draftItems.reduce((s,i)=>s+i.qty*i.rate,0),count=draftItems.reduce((s,i)=>s+i.qty,0);$('draftSummaryBox').innerHTML=`<div class="summary-row"><span>Items (${count})</span><strong>${fmt(total)}</strong></div><div class="summary-row"><span>Discount</span><span>₹0</span></div><div class="summary-row total"><span>Total</span><strong>${fmt(total)}</strong></div>`}
function placeDraft(){if(!draftItems.length)return;const items=draftItems.map(i=>({...i}));const o=addOrderItems(items);draftItems=[];saveDraft();renderDraftDock();renderTakeCart();$('draftDialog').close();setTab('orders',false);renderOrders();showToast('Order #'+o.id+' placed');setTimeout(()=>$('ordersSection').scrollIntoView({behavior:'smooth',block:'start'}),80)}
function getOrder(id){return orders.find(o=>String(o.id)===String(id))}
function openOrderDetail(id){detailOrderId=id;detailEditing=false;renderOrderDetail();$('detailDialog').showModal()}
function renderOrderDetail(){const o=getOrder(detailOrderId);if(!o){$('detailDialog').close();return}const host=$('detailContent');host.innerHTML='';const head=document.createElement('div');head.className='dialog-head';const left=document.createElement('div');left.innerHTML='<div class="dialog-title"></div><div class="dialog-sub"></div>';left.querySelector('.dialog-title').textContent='Order #'+o.id;left.querySelector('.dialog-sub').textContent=(o.time||'')+' · '+o.items.length+' item'+(o.items.length===1?'':'s');const right=document.createElement('button');right.className='close-btn';right.textContent='×';right.setAttribute('aria-label','Close order details');right.onclick=()=>$('detailDialog').close();head.append(left,right);host.append(head);const statusRow=document.createElement('div');statusRow.style.cssText='display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px';statusRow.append(statusPill(orderStatus(o)));const total=document.createElement('div');total.className='order-total';total.textContent=fmt(o.total);statusRow.append(total);host.append(statusRow);o.items.forEach((it,index)=>{const row=document.createElement('div');row.className='detail-item';const img=document.createElement('img');img.src=photoFor(it.name);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(it.name)};img.alt='';const info=document.createElement('div');const name=document.createElement('div');name.className='detail-item-name';name.textContent=it.name;const sub=document.createElement('div');sub.className='detail-item-sub';sub.textContent=it.qty+' × '+(it.sizeLabel||(it.size==='f'?'Full':'Half'))+' · '+fmt(it.rate)+' each';info.append(name,sub);if(detailEditing){const ctrl=document.createElement('div');ctrl.className='qty-control detail-item-controls';const minus=document.createElement('button');minus.textContent='−';minus.onclick=()=>changeDetailQty(o.id,index,-1);const count=document.createElement('span');count.textContent=it.qty;const plus=document.createElement('button');plus.textContent='+';plus.onclick=()=>changeDetailQty(o.id,index,1);ctrl.append(minus,count,plus);info.append(ctrl)}const side=document.createElement('div');side.className='detail-item-side';const price=document.createElement('div');price.className='detail-item-price';price.textContent=fmt(it.qty*it.rate);side.append(price);if(detailEditing){const rm=document.createElement('button');rm.className='detail-remove';rm.textContent='Remove';rm.onclick=()=>{if(confirm('Remove '+it.name+' from order #'+o.id+'?')){o.items.splice(index,1);if(!o.items.length){orders=orders.filter(x=>x.id!==o.id);saveOrders();renderOrders();renderHistory();$('detailDialog').close();showToast('Order removed')}else{recalcOrder(o);saveOrders();renderOrders();renderOrderDetail()}}};side.append(rm)}row.append(img,info,side);host.append(row)});const summary=document.createElement('div');summary.className='detail-summary';const totalVal=o.items.reduce((s,i)=>s+i.qty*i.rate,0);summary.innerHTML=`<div class="summary-row"><span>Items (${o.items.reduce((s,i)=>s+i.qty,0)})</span><strong>${fmt(totalVal)}</strong></div><div class="summary-row"><span>Discount</span><span>₹0</span></div><div class="summary-row total"><span>Total</span><strong>${fmt(totalVal)}</strong></div>`;host.append(summary);const add=document.createElement('button');add.className='plain-btn add-another';add.style.cssText='width:100%;margin-top:8px';add.textContent='+ Add another item';add.onclick=()=>openMenuPickerForOrder(o.id);host.append(add);const toolbar=document.createElement('div');toolbar.className='detail-toolbar';[[IC.print,'Print',()=>printOrder()],[IC.share,'Share',()=>shareOrder(o)],[IC.edit,detailEditing?'Done editing':'Edit',()=>{detailEditing=!detailEditing;renderOrderDetail()}],[IC.trash,'Delete',()=>deleteOrder(o.id)]].forEach(([icon,label,fn])=>{const b=document.createElement('button');b.className='toolbar-btn'+(label==='Delete'?' danger':'');b.innerHTML='<span></span><label></label>';b.querySelector('span').innerHTML=icon;b.querySelector('label').textContent=label;b.onclick=fn;toolbar.append(b)});host.append(toolbar)}
function changeDetailQty(id,index,delta){const o=getOrder(id);if(!o||!o.items[index])return;o.items[index].qty+=delta;if(o.items[index].qty<=0)o.items.splice(index,1);if(!o.items.length){orders=orders.filter(x=>x.id!==o.id);saveOrders();renderOrders();renderHistory();$('detailDialog').close();showToast('Order removed');return}recalcOrder(o);saveOrders();renderOrders();renderOrderDetail()}
function openMenuPickerForOrder(id){pickerReturnDetailId=id;$('detailDialog').close();$('detailMenuSearch').value='';renderDetailMenuPicker('');$('menuPickerDialog').showModal()}
function renderDetailMenuPicker(term){const host=$('detailMenuPicker');host.innerHTML='';const q=normalize(term);menu.filter(item=>!q||normalize(item.n+' '+item.c+' '+(item.a||[]).join(' ')).includes(q)).forEach(item=>{const row=document.createElement('div');row.className='pick-item';const img=document.createElement('img');img.src=photoFor(item.n);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(item.n)};img.alt='';const main=document.createElement('div');main.className='pick-item-main';const title=document.createElement('div');title.className='pick-item-title';title.textContent=item.n;const prices=document.createElement('div');prices.className='pick-item-price';[['h',item.hLabel||'Half'],['f',item.fLabel||'Full']].forEach(([size,label])=>{if(rateFor(item,size)==null)return;const b=document.createElement('button');b.textContent=label+' · '+fmt(rateFor(item,size));b.onclick=()=>{const o=getOrder(pickerReturnDetailId);if(o){const existing=o.items.find(i=>i.name===item.n&&i.size===size);if(existing)existing.qty++;else o.items.push({name:item.n,qty:1,size,rate:rateFor(item,size)});recalcOrder(o);saveOrders();renderOrders();renderHistory();}const oid=pickerReturnDetailId;pickerReturnDetailId=null;$('menuPickerDialog').close();openOrderDetail(oid);showToast(item.n+' added')};prices.append(b)});main.append(title,prices);row.append(img,main);host.append(row)})}
function deleteOrder(id){if(!confirm('Delete order #'+id+'? This cannot be undone.'))return;orders=orders.filter(o=>String(o.id)!==String(id));saveOrders();renderOrders();renderHistory();$('detailDialog').close();showToast('Order deleted')}
function shareOrder(o){const text=`Charlie Chaap · Order #${o.id}\n${o.items.map(i=>`${i.qty} × ${i.name} (${i.sizeLabel||(i.size==='f'?'Full':'Half')}) — ${fmt(i.qty*i.rate)}`).join('\n')}\nTotal: ${fmt(o.total)}\nStatus: ${orderStatus(o)}`;if(navigator.share){navigator.share({title:'Charlie Chaap Order #'+o.id,text}).catch(()=>{})}else if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(()=>showToast('Order copied to clipboard')).catch(()=>prompt('Copy order details:',text))}else prompt('Copy order details:',text)}
function printOrder(){document.body.classList.add('print-mode');window.print();setTimeout(()=>document.body.classList.remove('print-mode'),500)}
function exportOrders(){if(!orders.length){showToast('No orders to export');return}const rows=[['Order','Status','Items','Total','Time'],...orders.map(o=>[o.id,orderStatus(o),o.items.map(i=>`${i.qty}x ${i.name} (${i.sizeLabel||(i.size==='f'?'Full':'Half')})`).join('; '),o.total,o.time])];const csv=rows.map(row=>row.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(',')).join('\r\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='charlie-chaap-orders.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);showToast('Orders exported')}
function clearDone(){showToast('Use order details to delete individual orders')}
function clearAll(){if(!orders.length){showToast('Order list is already empty');return}if(confirm('Delete ALL saved orders? This cannot be undone.')){orders=[];saveOrders();renderOrders();renderHistory();if($('detailDialog').open)$('detailDialog').close();showToast('All orders cleared')}}
function renderMoreStats(){}

// Event wiring
$('homeEntry').addEventListener('input',()=>{renderComposer('home');const el=$('homeEntry');el.style.height='auto';el.style.height=Math.min(el.scrollHeight,114)+'px'});$('takeEntry').addEventListener('input',()=>{renderComposer('take');const el=$('takeEntry');el.style.height='auto';el.style.height=Math.min(el.scrollHeight,114)+'px'});$('takeAdd').onclick=addTakeLinesToDraft;$('takeReview').onclick=openDraft;$('takeDockReview').onclick=openDraft;$('takeClear').onclick=()=>{if(!draftItems.length)return;if(confirm('Clear all items from this draft order?')){draftItems=[];saveDraft();renderTakeCart();renderDraftDock();showToast('Draft cleared')}};
$('modalEntry').addEventListener('input',()=>{renderComposer('modal');const el=$('modalEntry');el.style.height='auto';el.style.height=Math.min(el.scrollHeight,114)+'px'});
$('homeAdd').onclick=()=>commitComposer('home');$('modalAdd').onclick=()=>commitComposer('modal');$('modalAddBottom').onclick=()=>commitComposer('modal');
$('matchSearch').addEventListener('input',e=>renderMatchOptions(e.target.value));$('sizeHalf').onclick=()=>{const item=menu.find(m=>m.n===sizeItemName);if(item)addToDraft(item,'h');$('sizeDialog').close()};$('sizeFull').onclick=()=>{const item=menu.find(m=>m.n===sizeItemName);if(item)addToDraft(item,'f');$('sizeDialog').close()};
$('newOrderBtn').onclick=()=>setTab('orders');$('homeStartOrder').onclick=()=>setTab('orders');$('homeOpenMenu').onclick=()=>setTab('menu');['landingViewMenu','landingStoryMenu','landingFooterMenu'].forEach(id=>{const el=$(id);if(el)el.onclick=()=>setTab('menu')});['landingAboutOrder','landingReviewOrder','landingFooterOrder'].forEach(id=>{const el=$(id);if(el)el.onclick=()=>setTab('orders')});$('reviewDraft').onclick=openDraft;$('placeDraft').onclick=placeDraft;$('continueMenu').onclick=()=>{ $('draftDialog').close();setTab('menu') };

$('addCustomMenuItem').onclick=()=>{$('customItemForm').reset();$('customItemDialog').showModal();setTimeout(()=>$('customItemName').focus(),50)};
$('customItemForm').addEventListener('submit',e=>{e.preventDefault();const name=$('customItemName').value.trim(),category=$('customItemCategory').value,half=$('customItemHalf').value,full=$('customItemFull').value;if(!name){showToast('Enter an item name');return}if(half===''&&full===''){showToast('Enter a half or full price');return}if(menu.some(m=>m.n.toLowerCase()===name.toLowerCase())){showToast('That item is already in the menu');return}const item={n:name,c:category,h:half===''?null:Number(half),f:full===''?null:Number(full),a:[name.toLowerCase()]};menu.push(item);try{const extras=menu.filter(m=>m.custom===true);item.custom=true;localStorage.setItem(CUSTOM_MENU_KEY,JSON.stringify(extras.concat(item)))}catch(err){item.custom=true;showToast('Added for this session; storage may be unavailable')}menuCategory='All';renderMenu();renderPopular();renderTakeMenu();$('customItemDialog').close();showToast(name+' added to menu')});
$('menuSearch').addEventListener('input',renderMenu);$('detailMenuSearch').addEventListener('input',e=>renderDetailMenuPicker(e.target.value));
$('orderSearch').addEventListener('input',renderOrders);$('historySearch').addEventListener('input',renderHistory);
document.querySelectorAll('.nav-btn[data-tab]').forEach(b=>b.addEventListener('click',()=>setTab(b.dataset.tab)));
$('topSearch').onclick=()=>{setTab('orders',false);$('orderSearch').focus();$('ordersSection').scrollIntoView({behavior:'smooth',block:'start'})};$('topMore').onclick=()=>setTab('more');$('exportTop').onclick=exportOrders;$('exportHistory').onclick=exportOrders;$('exportMore').onclick=exportOrders;$('clearAllMore').onclick=clearAll;$('allHistory').onclick=()=>setTab('history');$('openMenuMore').onclick=()=>setTab('menu');$('rsUpdateMenu').onclick=()=>setTab('menu');
$('menuCategories').addEventListener('click',e=>{const b=e.target.closest('[data-category]');if(b){menuCategory=b.dataset.category;renderMenu()}});
$('menuPickerDialog').addEventListener('close',()=>{if(pickerReturnDetailId!=null&&getOrder(pickerReturnDetailId)&&!$('detailDialog').open){const id=pickerReturnDetailId;pickerReturnDetailId=null;openOrderDetail(id)}});
document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>$(b.dataset.close).close()));
// If the item picker was opened from order details, return to those details after a cancellation too.

renderOrders();renderMenu();renderHistory();renderTakeCart();renderDraftDock();

(function(){const sw=$('themeSwitch'),mq=matchMedia('(prefers-color-scheme: dark)');let saved=null;try{saved=localStorage.getItem('charlie-theme')}catch(e){}
const dark=()=>saved==='dark';
function paint(){const d=dark();document.documentElement.dataset.theme=d?'dark':'light';sw.setAttribute('aria-checked',d);const m=document.querySelector('meta[name=theme-color]');if(m)m.content=d?'#2a2c30':'#e3e4e7'}
sw.onclick=()=>{saved=dark()?'light':'dark';try{localStorage.setItem('charlie-theme',saved)}catch(e){}paint()};
if(mq.addEventListener)mq.addEventListener('change',()=>{if(!saved)paint()});paint()})();

(function(){const vv=window.visualViewport,B=document.body,fld=e=>e&&/^(INPUT|TEXTAREA)$/.test(e.tagName);
let base=Math.max(innerHeight,vv?vv.height:0),w=innerWidth,was=false;
document.addEventListener('focusin',e=>{if(fld(e.target))B.classList.add('kb')});
document.addEventListener('focusout',()=>setTimeout(()=>{if(!fld(document.activeElement)&&!was)B.classList.remove('kb')},150));
function chk(){if(innerWidth!==w){w=innerWidth;base=Math.max(innerHeight,vv?vv.height:0)}
const h=Math.min(innerHeight,vv?vv.height:innerHeight);base=Math.max(base,h);
if(h<base*.8){was=true;B.classList.add('kb')}else if(was){was=false;B.classList.remove('kb')}}
addEventListener('resize',chk);if(vv)vv.addEventListener('resize',chk)})();

/* Workflow fixes: order status, filters, dynamic categories, custom item validation/persistence */
(function(){
  const statusLabel = s => ({pending:'Placed',placed:'Placed',preparing:'Preparing',done:'Completed',completed:'Completed'}[String(s||'pending').toLowerCase()] || 'Placed');
  window.orderStatus = function(o){
    const raw=String(o && (o.status || (o.done?'done':'pending')) || 'pending').toLowerCase();
    if(raw==='completed') return 'done';
    if(raw==='placed') return 'pending';
    return ['pending','preparing','done'].includes(raw)?raw:'pending';
  };
  window.statusPill = function(status){
    const st=String(status||'pending').toLowerCase(); const label=statusLabel(st);
    const b=document.createElement('span'); b.className='status '+(st==='done'||st==='completed'?'done':st==='preparing'?'preparing':'pending'); b.textContent=label; return b;
  };
  window.orderMatchesFilter = function(o,filter){
    const st=window.orderStatus(o); if(!filter||filter==='all') return true;
    if(filter==='done'||filter==='completed') return st==='done';
    if(filter==='placed') return st==='pending';
    return st===filter;
  };
  // Category pills follow actual menu data, including custom categories.
  const oldPills=window.renderCategoryPills;
  window.renderCategoryPills=function(hostId,selected,onSelect){
    const host=document.getElementById(hostId); if(!host){if(oldPills)return oldPills(hostId,selected,onSelect);return;}
    const cats=['All',...new Set((window.menu||[]).map(m=>String(m.c||'Other').trim()).filter(Boolean))];
    host.innerHTML=''; cats.forEach(cat=>{const b=document.createElement('button');b.type='button';b.className='category-pill'+(cat===selected?' selected':'');b.textContent=cat;b.onclick=()=>onSelect(cat);host.append(b)});
  };
  // Make custom item saving safe: validate numeric prices, avoid duplicates, and persist atomically.
  const form=document.getElementById('customItemForm');
  if(form) form.addEventListener('submit',function(e){
    // Existing listener is retained for app compatibility; this guard blocks invalid numeric values.
    const h=document.getElementById('customItemHalf')?.value, f=document.getElementById('customItemFull')?.value;
    const valid=v=>v===''||(Number.isFinite(Number(v))&&Number(v)>=0&&Number(v)<=1000000);
    if(!valid(h)||!valid(f)){e.preventDefault();e.stopImmediatePropagation();if(typeof window.showToast==='function')window.showToast('Enter valid prices (₹0–₹10,00,000)');}
  },true);
  // Restore any legacy custom item records and make their category filters visible on next render.
  document.addEventListener('DOMContentLoaded',()=>{
    try{const key='charlie-custom-menu-v1';const extras=JSON.parse(localStorage.getItem(key)||'[]');
      if(Array.isArray(extras)) extras.forEach(x=>{if(x&&x.n&&!window.menu.some(m=>String(m.n).toLowerCase()===String(x.n).toLowerCase()))window.menu.push({...x,custom:true});});
    }catch(e){}
  });
})();

</script>

<script>
/* Charlie Chaap workflow hardening: persistent menu management + working order states */
(function () {
  const MENU_STATE_KEY = 'charlie-menu-management-v1';
  const clone = value => JSON.parse(JSON.stringify(value));
  const keyOf = name => normalize(String(name || ''));
  let menuManagement = (() => {
    const saved = safeLoad(MENU_STATE_KEY, {});
    return {
      unavailable: Array.isArray(saved && saved.unavailable) ? saved.unavailable.map(keyOf).filter(Boolean) : [],
      deleted: Array.isArray(saved && saved.deleted) ? saved.deleted.map(keyOf).filter(Boolean) : []
    };
  })();

  function isAvailable(item) {
    if (!item) return false;
    const key = keyOf(item._baseKey || item.n);
    return item.available !== false && !menuManagement.unavailable.includes(key) && !menuManagement.deleted.includes(key);
  }

  // Apply saved management settings to built-in and custom items before any new render.
  const keptMenu = menu.filter(item => !menuManagement.deleted.includes(keyOf(item.n)));
  menu.splice(0, menu.length, ...keptMenu.map(item => ({ ...item, available: !menuManagement.unavailable.includes(keyOf(item.n)) })));

  // Existing drafts keep price snapshots, but an item made unavailable cannot be placed as a new order.
  const originalPlaceDraft = placeDraft;
  placeDraft = function () {
    if (!draftItems.length) return;
    const blocked = draftItems.filter(entry => {
      const current = menu.find(item => keyOf(item.n) === keyOf(entry.name));
      return !current || !isAvailable(current);
    });
    if (blocked.length) { showToast('Remove unavailable items from the draft before placing the order'); return; }
    if (draftItems.some(entry => !Number.isFinite(Number(entry.rate)) || Number(entry.rate) < 0 || !Number.isFinite(Number(entry.qty)) || Number(entry.qty) < 1)) {
      showToast('Check item prices and quantities before placing the order'); return;
    }
    originalPlaceDraft();
  };

  const originalAddTakeLinesToDraft = addTakeLinesToDraft;
  addTakeLinesToDraft = function () {
    const blocked = draftItems.filter(entry => {
      const current = menu.find(item => keyOf(item.n) === keyOf(entry.name));
      return !current || !isAvailable(current);
    });
    if (blocked.length) { showToast('Remove unavailable items from the draft before adding more'); return; }
    originalAddTakeLinesToDraft();
  };

  function saveMenuData() {
    const customItems = menu.filter(item => item.custom === true).map(item => ({
      n: item.n, c: item.c, h: item.h == null ? null : Number(item.h),
      f: item.f == null ? null : Number(item.f), a: Array.isArray(item.a) ? item.a : [String(item.n).toLowerCase()],
      custom: true, available: isAvailable(item), image: item.image || '', hLabel:item.hLabel||'', fLabel:item.fLabel||''
    }));
    let oldCustom = null, oldState = null;
    try {
      oldCustom = localStorage.getItem(CUSTOM_MENU_KEY);
      oldState = localStorage.getItem(MENU_STATE_KEY);
      localStorage.setItem(CUSTOM_MENU_KEY, JSON.stringify(customItems));
      localStorage.setItem(MENU_STATE_KEY, JSON.stringify(menuManagement));
      try {
        if (window.__ccShared && window.__ccStaff) {
          const pushItems = menu.map(item => ({ n: item.n, c: item.c || 'Other', h: item.h == null ? null : Number(item.h), f: item.f == null ? null : Number(item.f), hLabel: item.hLabel || '', fLabel: item.fLabel || '', a: Array.isArray(item.a) ? item.a : [item.n], custom: !!item.custom, available: item.available !== false, image: item.image || '' }));
          clearTimeout(window.__ccMenuPushTimer);
          window.__ccMenuPushTimer = setTimeout(() => {
            fetch('/api/menu', { method: 'PUT', credentials: 'same-origin', cache: 'no-store', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: pushItems }) }).catch(() => {});
          }, 700);
        }
      } catch (_) {}
      return true;
    } catch (error) {
      try {
        if (oldCustom === null) localStorage.removeItem(CUSTOM_MENU_KEY); else localStorage.setItem(CUSTOM_MENU_KEY, oldCustom);
        if (oldState === null) localStorage.removeItem(MENU_STATE_KEY); else localStorage.setItem(MENU_STATE_KEY, oldState);
      } catch (_) {}
      return false;
    }
  }

  function refreshMenuViews() {
    if (menuCategory !== 'All' && !menu.some(item => categoryFor(item) === menuCategory)) menuCategory = 'All';
    if (homeCategory !== 'All' && !menu.some(item => categoryFor(item) === homeCategory)) homeCategory = 'All';
    renderMenu();
    renderPopular();
    try { renderComposer('home'); } catch (_) {}
    try { renderComposer('take'); } catch (_) {}
    try { renderComposer('modal'); } catch (_) {}
    try { renderTakeCart(); } catch (_) {}
    try { renderDraftDock(); } catch (_) {}
  }

  function allMenuCategories() {
    return ['All', ...Array.from(new Set(menu.map(categoryFor).filter(Boolean)))];
  }

  // Dynamic category pills include custom categories and preserve the current app's styling.
  renderCategoryPills = function (targetId, selected, onSelect) {
    const host = $(targetId);
    if (!host) return;
    host.innerHTML = '';
    const categories = allMenuCategories();
    if (!categories.includes(selected)) selected = 'All';
    categories.forEach(category => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'pill' + (category === selected ? ' selected' : '');
      button.dataset.category = category;
      button.textContent = category;
      button.onclick = () => onSelect(category);
      host.append(button);
    });
  };

  // Hidden/deleted items cannot be selected by the natural-language order composer.
  matchesFor = function (line) {
    const parsed = parseLine(line);
    if (!parsed.query) return [];
    return menu.filter(isAvailable)
      .map(item => ({ item, score: itemScore(parsed.query, item) }))
      .sort((a, b) => b.score - a.score).slice(0, 8);
  };

  addToDraft = function (item, size, qty = 1) {
    if (!isAvailable(item)) { showToast('This item is currently unavailable'); return; }
    const rate = rateFor(item, size);
    if (rate == null || !Number.isFinite(Number(rate)) || Number(rate) < 0) { showToast('This size has no valid listed price'); return; }
    const count = Math.max(1, Math.floor(Number(qty) || 1));
    const existing = draftItems.find(entry => keyOf(entry.name) === keyOf(item.n) && entry.size === size);
    if (existing) { existing.qty = Math.max(1, Number(existing.qty) || 1) + count; existing.rate = Number(rate); }
    else draftItems.push({ name: item.n, qty: count, size, rate: Number(rate) });
    saveDraft(); renderDraftDock(); renderTakeCart(); showToast(item.n + ' added');
  };

  openSizePicker = function (name) {
    const item = menu.find(entry => keyOf(entry.n) === keyOf(name));
    if (!item || !isAvailable(item)) { showToast('This item is currently unavailable'); return; }
    sizeItemName = item.n;
    $('sizeTitle').textContent = item.n;
    $('sizeSub').textContent = 'Choose size to add';
    $('sizeHalf').textContent = item.h != null ? `Half · ${fmt(item.h)}` : 'Half · —';
    $('sizeFull').textContent = item.f != null ? `Full · ${fmt(item.f)}` : 'Full · —';
    $('sizeHalf').disabled = item.h == null;
    $('sizeFull').disabled = item.f == null;
    $('sizeDialog').showModal();
  };

  renderPopular = function () {
    const host = $('popularGrid');
    const categoriesHost = $('homeCategories');
    if (!host) return;
    if (categoriesHost) {
      categoriesHost.innerHTML = '';
      allMenuCategories().forEach(category => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pill' + (category === homeCategory ? ' selected' : '');
        button.dataset.category = category;
        button.textContent = category;
        button.onclick = () => { homeCategory = category; renderPopular(); };
        categoriesHost.append(button);
      });
    }
    host.innerHTML = '';
    let items = homeCategory === 'All'
      ? popularNames.map(name => menu.find(item => keyOf(item.n) === keyOf(name))).filter(Boolean)
      : menu.filter(item => categoryFor(item) === homeCategory).slice(0, 8);
    items = items.filter(isAvailable);
    if (!items.length) {
      host.innerHTML = '<div class="order-empty"><strong>No available items in this category</strong><p>Choose another category or check the menu.</p></div>';
      return;
    }
    items.forEach(item => {
      const card = document.createElement('article'); card.className = 'food-card';
      const imageWrap = document.createElement('div'); imageWrap.className = 'food-image-wrap';
      const img = document.createElement('img'); img.className = 'food-image'; img.src = photoFor(item.n); img.alt = item.n; img.loading = 'lazy';
      img.onerror = () => { img.onerror = null; img.src = fallbackPhoto(item.n); };
      const plus = document.createElement('button'); plus.className = 'food-add'; plus.type = 'button'; plus.textContent = '+'; plus.setAttribute('aria-label', 'Choose size for ' + item.n); plus.onclick = () => openSizePicker(item.n);
      imageWrap.append(img, plus);
      const info = document.createElement('div'); info.className = 'food-info';
      const title = document.createElement('div'); title.className = 'food-name'; title.textContent = item.n;
      const category = document.createElement('div'); category.className = 'food-category'; category.textContent = categoryFor(item);
      const prices = document.createElement('div'); prices.className = 'price-pair';
      [['h',item.hLabel||'Half'],['f',item.fLabel||'Full']].forEach(([size,label]) => {
        if (rateFor(item, size) == null) return;
        const button = document.createElement('button'); button.type = 'button'; button.className = 'price-choice';
        button.innerHTML = '<strong></strong><small></small>'; button.querySelector('strong').textContent = fmt(rateFor(item,size)); button.querySelector('small').textContent = label.toUpperCase();
        button.onclick = () => addToDraft(item, size); prices.append(button);
      });
      info.append(title, category, prices); card.append(imageWrap, info); host.append(card);
    });
  };

  renderMenu = function () {
    renderCategoryPills('menuCategories', menuCategory, category => { menuCategory = category; renderMenu(); });
    const searchValue = normalize($('menuSearch') ? $('menuSearch').value : '');
    const host = $('menuList'); if (!host) return;
    host.innerHTML = '';
    const items = menu.filter(item => categoryMatches(item, menuCategory) && (!searchValue || normalize(item.n + ' ' + item.c + ' ' + (item.a || []).join(' ')).includes(searchValue)));
    if (!items.length) {
      host.innerHTML = '<div class="order-empty"><strong>No menu items found</strong><p>Try another spelling or category, or add a custom dish.</p></div>';
      return;
    }
    let lastCategory = '';
    items.forEach(item => {
      const available = isAvailable(item);
      const category = categoryFor(item);
      if (category !== lastCategory) { const heading = document.createElement('h2'); heading.className = 'group-heading'; heading.textContent = category; host.append(heading); lastCategory = category; }
      const row = document.createElement('article'); row.className = 'menu-row' + (available ? '' : ' menu-row-unavailable');
      const img = document.createElement('img'); img.className = 'menu-thumb'; img.src = photoFor(item.n); img.onerror = () => { img.onerror = null; img.src = fallbackPhoto(item.n); }; img.alt = item.n; img.loading = 'lazy';
      const main = document.createElement('div'); main.className = 'menu-main';
      const titleRow = document.createElement('div'); titleRow.className = 'menu-title-row';
      const titleWrap = document.createElement('div'); titleWrap.className = 'menu-title-wrap';
      const title = document.createElement('div'); title.className = 'menu-name'; title.textContent = item.n; titleWrap.append(title);
      if (!available) { const badge = document.createElement('span'); badge.className = 'availability-badge'; badge.textContent = 'Unavailable'; titleWrap.append(badge); }
      const categoryText = document.createElement('div'); categoryText.className = 'menu-cat'; categoryText.textContent = category + (item.custom ? ' · Custom item' : '');
      titleRow.append(titleWrap);
      const prices = document.createElement('div'); prices.className = 'menu-prices';
      [['h',item.hLabel||'Half'],['f',item.fLabel||'Full']].forEach(([size,label]) => {
        if (rateFor(item,size) == null) return;
        const button = document.createElement('button'); button.type = 'button'; button.className = 'menu-price-btn'; button.textContent = label + ' · ' + fmt(rateFor(item,size));
        button.disabled = !available; button.title = available ? 'Add ' + item.n + ' to the draft order' : 'This item is unavailable';
        button.onclick = () => addToDraft(item,size); prices.append(button);
      });
      const manage = document.createElement('div'); manage.className = 'menu-management-row';
      const toggle = document.createElement('button'); toggle.type = 'button'; toggle.className = 'menu-manage-btn' + (available ? '' : ' is-available');
      toggle.textContent = available ? 'Mark unavailable' : 'Make available';
      toggle.setAttribute('aria-label', (available ? 'Mark unavailable: ' : 'Make available: ') + item.n);
      toggle.onclick = () => setMenuAvailability(item.n, !isAvailable(item));
      const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'menu-manage-btn danger'; remove.textContent = 'Delete'; remove.setAttribute('aria-label', 'Delete menu item: ' + item.n);
      remove.onclick = () => deleteMenuItem(item.n);
      manage.append(toggle, remove);
      main.append(titleRow, categoryText, prices, manage); row.append(img,main); host.append(row);
    });
  };

  function setMenuAvailability(name, makeAvailable) {
    const item = menu.find(entry => keyOf(entry.n) === keyOf(name));
    if (!item) { showToast('Menu item not found'); return; }
    const key = keyOf(item._baseKey || item.n);
    const oldUnavailable = [...menuManagement.unavailable];
    const oldAvailable = item.available;
    if (makeAvailable) menuManagement.unavailable = menuManagement.unavailable.filter(value => value !== key);
    else if (!menuManagement.unavailable.includes(key)) menuManagement.unavailable.push(key);
    item.available = !!makeAvailable;
    if (!saveMenuData()) {
      menuManagement.unavailable = oldUnavailable; item.available = oldAvailable;
      showToast('Could not save menu changes. Check device storage.'); return;
    }
    // Clear any stale suggested selections so an unavailable dish cannot sneak into an order.
    Object.values(chosenByLine).forEach(map => Object.keys(map).forEach(line => { if (keyOf(map[line]) === key) delete map[line]; }));
    refreshMenuViews();
    showToast(item.n + (makeAvailable ? ' is available again' : ' marked unavailable'));
  }

  function deleteMenuItem(name) {
    const index = menu.findIndex(entry => keyOf(entry.n) === keyOf(name));
    if (index < 0) { showToast('Menu item not found'); return; }
    const item = menu[index];
    const countInDraft = draftItems.filter(entry => keyOf(entry.name) === keyOf(item.n)).reduce((sum,entry) => sum + (Number(entry.qty)||0),0);
    const message = `Delete “${item.n}” from the menu?${countInDraft ? ` It is also in the current draft (${countInDraft} item${countInDraft===1?'':'s'}) and will be removed from that draft.` : ''} Past orders will keep their saved item details.`;
    if (!confirm(message)) return;
    const previousMenu = menu.slice();
    const previousDraft = draftItems.map(entry => ({ ...entry }));
    const previousChosen = clone(chosenByLine);
    const oldUnavailable = [...menuManagement.unavailable], oldDeleted = [...menuManagement.deleted];
    const stableKey = keyOf(item._baseKey || item.n);
    menu.splice(index,1);
    menuManagement.unavailable = menuManagement.unavailable.filter(value => value !== stableKey);
    if (!menuManagement.deleted.includes(stableKey)) menuManagement.deleted.push(stableKey);
    draftItems = draftItems.filter(entry => keyOf(entry.name) !== keyOf(item.n));
    Object.values(chosenByLine).forEach(map => Object.keys(map).forEach(line => { if (keyOf(map[line]) === keyOf(item.n)) delete map[line]; }));
    if (!saveMenuData()) {
      menu.splice(0, menu.length, ...previousMenu); draftItems = previousDraft; chosenByLine = previousChosen;
      menuManagement.unavailable = oldUnavailable; menuManagement.deleted = oldDeleted;
      showToast('Could not save menu changes. Check device storage.'); return;
    }
    saveDraft(); refreshMenuViews(); showToast(item.n + ' deleted from menu');
  }

  function clearMenuFlags(name) {
    const previous = { unavailable: [...menuManagement.unavailable], deleted: [...menuManagement.deleted] };
    const key = keyOf(name);
    menuManagement.unavailable = menuManagement.unavailable.filter(value => value !== key);
    menuManagement.deleted = menuManagement.deleted.filter(value => value !== key);
    return previous;
  }
  function restoreMenuFlags(previous) {
    if (!previous) return;
    menuManagement.unavailable = [...previous.unavailable];
    menuManagement.deleted = [...previous.deleted];
  }
  window.ccMenuManagement = { isAvailable, setMenuAvailability, deleteMenuItem, saveMenuData, refreshMenuViews, keyOf, clearMenuFlags, restoreMenuFlags };

  // Replace custom item submission end-to-end so validation, deduplication and persistence are consistent.
  const customForm = $('customItemForm');
  if (customForm) customForm.addEventListener('submit', function (event) {
    event.preventDefault(); event.stopImmediatePropagation();
    const name = $('customItemName').value.trim();
    const category = $('customItemCategory').value.trim() || 'Other';
    const halfText = $('customItemHalf').value.trim(), fullText = $('customItemFull').value.trim();
    const validPrice = value => value === '' || (Number.isFinite(Number(value)) && Number(value) >= 0 && Number(value) <= 1000000);
    if (!name) { showToast('Enter an item name'); $('customItemName').focus(); return; }
    if (!validPrice(halfText) || !validPrice(fullText)) { showToast('Enter valid prices from ₹0 to ₹10,00,000'); return; }
    if (halfText === '' && fullText === '') { showToast('Enter a half price, full price, or both'); return; }
    if (menu.some(item => keyOf(item.n) === keyOf(name))) { showToast('That item is already in the menu'); return; }
    const item = { n:name, c:category, h:halfText===''?null:Number(halfText), f:fullText===''?null:Number(fullText), a:[name.toLowerCase()], custom:true, available:true };
    const oldDeleted = [...menuManagement.deleted], oldUnavailable = [...menuManagement.unavailable];
    menuManagement.deleted = menuManagement.deleted.filter(value => value !== keyOf(name));
    menuManagement.unavailable = menuManagement.unavailable.filter(value => value !== keyOf(name));
    menu.push(item);
    if (!saveMenuData()) {
      menu.splice(menu.indexOf(item),1); menuManagement.deleted = oldDeleted; menuManagement.unavailable = oldUnavailable;
      showToast('Could not save this item. Device storage may be full.'); return;
    }
    menuCategory = 'All'; homeCategory = 'All';
    refreshMenuViews();
    $('customItemDialog').close(); customForm.reset(); showToast(name + ' added to menu');
  }, true);

  renderDetailMenuPicker = function (term) {
    const host = $('detailMenuPicker'); if (!host) return;
    host.innerHTML = '';
    const query = normalize(term);
    const items = menu.filter(isAvailable).filter(item => !query || normalize(item.n + ' ' + item.c + ' ' + (item.a || []).join(' ')).includes(query));
    if (!items.length) { host.innerHTML = '<div class="order-empty"><strong>No available dishes found</strong><p>Mark a dish available in Menu, or add a new custom item.</p></div>'; return; }
    items.forEach(item => {
      const row = document.createElement('div'); row.className = 'pick-item';
      const img = document.createElement('img'); img.src = photoFor(item.n); img.onerror = () => { img.onerror = null; img.src = fallbackPhoto(item.n); }; img.alt = '';
      const main = document.createElement('div'); main.className = 'pick-item-main';
      const title = document.createElement('div'); title.className = 'pick-item-title'; title.textContent = item.n;
      const prices = document.createElement('div'); prices.className = 'pick-item-price';
      [['h',item.hLabel||'Half'],['f',item.fLabel||'Full']].forEach(([size,label]) => {
        if (rateFor(item,size) == null) return;
        const button = document.createElement('button'); button.type = 'button'; button.textContent = label + ' · ' + fmt(rateFor(item,size));
        button.onclick = () => {
          const order = getOrder(pickerReturnDetailId); if (!order || !isAvailable(item)) { showToast('This item is no longer available'); return; }
          const existing = order.items.find(entry => keyOf(entry.name) === keyOf(item.n) && entry.size === size);
          if (existing) { existing.qty = Math.max(1,Number(existing.qty)||1) + 1; existing.rate = Number(rateFor(item,size)); }
          else order.items.push({name:item.n,qty:1,size,rate:Number(rateFor(item,size))});
          recalcOrder(order); saveOrders(); renderOrders(); renderHistory(); const id = pickerReturnDetailId; pickerReturnDetailId = null; $('menuPickerDialog').close(); openOrderDetail(id); showToast(item.n + ' added');
        };
        prices.append(button);
      });
      main.append(title,prices); row.append(img,main); host.append(row);
    });
  };

  orderStatus = function (order) {
    const raw = String(order && (order.status || (order.done ? 'done' : 'pending')) || 'pending').toLowerCase();
    if (raw === 'placed' || raw === 'new' || raw === 'open') return 'pending';
    if (raw === 'completed' || raw === 'complete' || raw === 'finished' || raw === 'done' || order?.done === true) return 'done';
    if (raw === 'preparing' || raw === 'in_progress' || raw === 'in-progress') return 'preparing';
    return 'pending';
  };
  statusPill = function (status) {
    const normal = ['pending','preparing','done'].includes(status) ? status : 'pending';
    const pill = document.createElement('span'); pill.className = 'status ' + normal;
    pill.textContent = normal === 'pending' ? 'Placed' : normal === 'preparing' ? 'Preparing' : 'Completed';
    return pill;
  };
  orderMatchesFilter = function (order, filter) {
    if (!filter || filter === 'all') return true;
    return orderStatus(order) === (filter === 'completed' ? 'done' : filter === 'placed' ? 'pending' : filter);
  };
  advanceStatus = function (id) {
    const order = orders.find(entry => String(entry.id) === String(id)); if (!order) return;
    const current = orderStatus(order);
    order.status = current === 'pending' ? 'preparing' : current === 'preparing' ? 'done' : 'pending';
    order.done = order.status === 'done'; recalcOrder(order); saveOrders(); renderOrders(); renderHistory();
    if (detailOrderId != null && String(detailOrderId) === String(order.id) && $('detailDialog').open) renderOrderDetail();
    showToast(order.status === 'done' ? 'Order marked completed' : order.status === 'preparing' ? 'Order moved to preparing' : 'Order reopened');
  };

  // Keep the status transition available inside the order detail sheet as well as on order cards.
  const originalRenderOrderDetail = renderOrderDetail;
  renderOrderDetail = function () {
    originalRenderOrderDetail();
    const host = $('detailContent');
    const order = getOrder(detailOrderId);
    if (!host || !order || !host.children.length) return;
    const current = orderStatus(order);
    const action = document.createElement('button');
    action.type = 'button'; action.className = 'black-btn'; action.style.cssText = 'width:100%;margin:0 0 12px';
    action.textContent = current === 'pending' ? 'Start preparing' : current === 'preparing' ? 'Mark order completed' : 'Reopen order';
    action.onclick = () => advanceStatus(order.id);
    const statusRow = host.children[1];
    if (statusRow) statusRow.insertAdjacentElement('afterend', action); else host.prepend(action);
  };

  // Include a real status transition control on each order; tapping the card still opens details.
  renderOrderCard = function (order) {
    const card = document.createElement('article'); card.className = 'order-card'; card.tabIndex = 0; card.setAttribute('aria-label','Open order '+order.id);
    card.onclick = () => openOrderDetail(order.id);
    card.onkeydown = event => { if (event.target === card && (event.key === 'Enter' || event.key === ' ')) { event.preventDefault(); openOrderDetail(order.id); } };
    const head = document.createElement('div'); head.className = 'order-head';
    const meta = document.createElement('div'); meta.className = 'order-meta';
    const num = document.createElement('div'); num.className = 'order-number'; num.textContent = 'ORDER #' + order.id;
    const count = document.createElement('div'); count.className = 'order-count'; count.textContent = order.items.length + ' item' + (order.items.length === 1 ? '' : 's') + ' · ' + (order.time || '');
    const statusLine = document.createElement('div'); statusLine.style.marginTop = '6px'; statusLine.append(statusPill(orderStatus(order))); meta.append(num,count,statusLine);
    const total = document.createElement('div'); total.className = 'order-total'; total.textContent = fmt(order.total); head.append(meta,total); card.append(head);
    const lines = document.createElement('div'); lines.className = 'item-lines';
    order.items.slice(0,5).forEach(item => {
      const row = document.createElement('div'); row.className = 'item-line';
      const img = document.createElement('img'); img.className = 'item-thumb'; img.src = photoFor(item.name); img.onerror = () => { img.onerror = null; img.src = fallbackPhoto(item.name); }; img.alt = '';
      const info = document.createElement('div'); info.className = 'item-line-info';
      const name = document.createElement('div'); name.className = 'item-line-name'; name.textContent = item.name;
      const detail = document.createElement('div'); detail.className = 'item-line-detail'; detail.textContent = item.qty + ' × ' + (item.size === 'f' ? 'Full' : 'Half') + ' · ' + fmt(item.rate) + ' each'; info.append(name,detail);
      const amount = document.createElement('div'); amount.className = 'item-line-total'; amount.textContent = fmt(item.qty * item.rate); row.append(img,info,amount); lines.append(row);
    });
    if (order.items.length > 5) { const more = document.createElement('div'); more.className = 'item-line-detail'; more.style.padding = '6px 2px'; more.textContent = '+' + (order.items.length-5) + ' more items'; lines.append(more); }
    card.append(lines);
    const actions = document.createElement('div'); actions.className = 'order-actions';
    const view = document.createElement('button'); view.className = 'action-main'; view.type = 'button'; view.textContent = 'View order'; view.onclick = event => { event.stopPropagation(); openOrderDetail(order.id); };
    const state = document.createElement('button'); state.className = 'state-action'; state.type = 'button';
    const current = orderStatus(order);
    state.textContent = current === 'pending' ? 'Start preparing' : current === 'preparing' ? 'Mark completed' : 'Reopen';
    state.setAttribute('aria-label', current === 'pending' ? 'Start preparing order ' + order.id : current === 'preparing' ? 'Mark order ' + order.id + ' completed' : 'Reopen order ' + order.id);
    state.onclick = event => { event.stopPropagation(); advanceStatus(order.id); };
    const more = document.createElement('button'); more.className = 'action-more'; more.type = 'button'; more.textContent = '···'; more.setAttribute('aria-label','Order details'); more.onclick = event => { event.stopPropagation(); openOrderDetail(order.id); };
    actions.append(view,state,more); card.append(actions); return card;
  };

  renderOrders = function () {
    const openCount = orders.filter(order => orderStatus(order) !== 'done').length;
    $('activeCount').textContent = openCount + ' Open'; $('activeCount').className = 'status ' + (openCount ? 'pending' : 'done');
    renderOrderList('homeOrderList','all',$('orderSearch').value || '');
  };
  renderHistory = function () {
    const completed = orders.filter(order => orderStatus(order) === 'done');
    $('historyCount').textContent = orders.length; $('todayCount').textContent = orders.length;
    $('completedTotal').textContent = fmt(completed.reduce((sum,order) => sum + order.total,0));
    renderOrderList('historyList','all',$('historySearch').value || '');
  };

  // Improve menu-related visuals and mobile tap targets without changing the overall visual language.
  const style = document.createElement('style');
  style.textContent = `
    .menu-row{align-items:start}
    .menu-title-wrap{display:flex;align-items:center;gap:7px;flex-wrap:wrap;min-width:0}
    .availability-badge{display:inline-flex;align-items:center;border-radius:99px;padding:4px 7px;background:#fff0df;color:#a95508;font-size:9px;font-weight:850;letter-spacing:.02em}
    .menu-row-unavailable .menu-thumb{filter:grayscale(.45);opacity:.72}
    .menu-price-btn:disabled{opacity:.42;cursor:not-allowed;text-decoration:line-through}
    .menu-management-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}
    .menu-manage-btn{border:1px solid #e6e6e3;border-radius:10px;background:#f8f8f6;color:#2b2b2b;font-size:10px;font-weight:800;padding:8px 10px;min-height:34px}
    .menu-manage-btn.is-available{background:#edf7ef;border-color:#dceee0;color:#246b3d}
    .menu-manage-btn.danger{background:#fffafa;border-color:#f1dede;color:#a72e2e}
    .state-action{flex:1;min-width:0;min-height:43px;padding:9px 10px;border-radius:14px;border:1px solid #e4e4e1;background:#f3f3f1;color:#202020;font-size:11px;font-weight:800}
    .state-action:active,.menu-manage-btn:active{transform:scale(.985)}
    @media(max-width:390px){.menu-row{grid-template-columns:58px minmax(0,1fr);gap:9px}.menu-thumb{width:58px;height:58px}.menu-manage-btn{padding:8px;font-size:9px}.order-actions{gap:5px}.state-action{font-size:10px;padding:8px 6px}}
  `;
  document.head.append(style);

  // A safer status migration for legacy saved orders.
  orders = orders.map(order => {
    const status = orderStatus(order);
    return { ...order, status, done: status === 'done' };
  });
  saveOrders();
  // Rebind controls whose original handlers captured function references before these fixes loaded.
  $('placeDraft').onclick = placeDraft;
  $('takeAdd').onclick = addTakeLinesToDraft;
  $('menuSearch').addEventListener('input', renderMenu);
  $('orderSearch').addEventListener('input', renderOrders);
  $('historySearch').addEventListener('input', renderHistory);
  refreshMenuViews();
  renderOrders();
  renderHistory();
})();

</script>

<style id="dedicated-menu-editor-style">
  .menu-page-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .custom-menu-trigger{width:auto;min-height:40px;padding:0 13px;white-space:nowrap;font-size:12px}
  .menu-management-row{display:none!important}
  .menu-editor-header{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px;padding:12px 0 17px}
  .menu-editor-back{min-height:42px;padding:0 12px;border-radius:13px;background:var(--n-bg);box-shadow:var(--rm);color:var(--n-ink);font-weight:800;display:flex;align-items:center;gap:7px;white-space:nowrap}
  .menu-editor-back span{font-size:12px}
  .menu-editor-heading{min-width:0}
  .menu-editor-heading h1{margin:0;font-size:clamp(22px,5vw,30px);letter-spacing:-.7px}
  .menu-editor-heading p{font-size:11px;color:var(--n-mute);margin:4px 0 0;line-height:1.35}
  .menu-editor-add{white-space:nowrap;min-height:42px;padding:0 13px;font-size:11px}
  .menu-editor-tools{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:9px;margin-bottom:10px}
  .menu-editor-search{display:flex;align-items:center;gap:9px;min-width:0;background:var(--n-bg);border-radius:14px;box-shadow:var(--in);padding:0 12px;min-height:45px}
  .menu-editor-search svg{width:18px;height:18px;stroke:var(--n-mute);fill:none;stroke-width:2;flex:0 0 auto}
  .menu-editor-search input{border:0;outline:0;background:transparent;width:100%;min-width:0;color:var(--n-ink);font-size:12px}
  #editorStatusFilter{height:45px;max-width:130px;border:0;border-radius:13px;padding:0 10px;background:var(--n-bg);box-shadow:var(--rm);color:var(--n-ink);font-size:11px;font-weight:750}
  .editor-menu-stats{font-size:11px;color:var(--n-mute);margin:3px 2px 12px}
  .editor-menu-list{display:grid;grid-template-columns:minmax(0,1fr);gap:9px}
  .editor-menu-card{display:grid;grid-template-columns:74px minmax(0,1fr);align-items:center;gap:12px;padding:10px;background:var(--n-bg);border:1px solid var(--n-line);border-radius:17px;box-shadow:var(--rm);min-width:0}
  .editor-menu-image{width:74px;height:74px;object-fit:cover;border-radius:13px;background:var(--n-well);box-shadow:var(--in)}
  .editor-menu-body{min-width:0}
  .editor-menu-name{font-size:13px;font-weight:850;overflow-wrap:anywhere;line-height:1.28}
  .editor-menu-meta{font-size:10px;color:var(--n-mute);margin-top:4px;overflow-wrap:anywhere}
  .editor-menu-price{font-size:10px;font-weight:800;margin-top:6px;color:var(--n-ink)}
  .editor-menu-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:9px}
  .editor-action{min-height:34px;padding:7px 10px;border-radius:10px;background:var(--n-bg);color:var(--n-ink);box-shadow:var(--rm);border:1px solid var(--n-line);font-size:10px;font-weight:850}
  .editor-action.primary{background:var(--or-grad);color:#fff;border-color:transparent;box-shadow:var(--or-in)}
  .editor-action.unavail{color:var(--n-ort)}
  .editor-action.danger{color:#b02d28}
  .editor-status{display:inline-flex;font-size:9px;font-weight:850;border-radius:99px;padding:4px 7px;margin-left:6px;background:#e7f6eb;color:#247447;vertical-align:middle;white-space:nowrap}
  .editor-status.off{background:#fff0df;color:#a95508}
  #menuItemEditorDialog{width:min(100% - 24px,560px);max-width:560px;max-height:min(90dvh,920px);padding:0;overflow:auto;border:1px solid var(--n-line);border-radius:23px;background:var(--n-bg);color:var(--n-ink);box-shadow:0 20px 70px #0003}
  #menuItemEditorDialog::backdrop{background:rgba(20,20,22,.52);backdrop-filter:blur(4px)}
  .menu-item-editor-form{padding:18px;display:grid;gap:10px}
  .editor-dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:4px}
  .editor-dialog-head h2{font-size:21px;letter-spacing:-.5px;margin:0;font-weight:850}
  .editor-dialog-head p{font-size:11px;color:var(--n-mute);margin:5px 0 0}
  .editor-close{width:35px;height:35px;border-radius:50%;background:var(--n-bg);box-shadow:var(--rm);color:var(--n-ink);font-size:22px;flex:0 0 auto}
  .editor-field{display:grid;gap:5px;min-width:0}
  .editor-field label,.editor-section-label{font-size:10px;font-weight:850;color:var(--n-mute);letter-spacing:.2px}
  .editor-input,.editor-textarea{width:100%;min-height:43px;border:1px solid var(--n-line);border-radius:12px;background:var(--n-bg);box-shadow:var(--in);padding:10px 12px;color:var(--n-ink);outline:none;font-size:12px}
  .editor-textarea{min-height:66px;resize:vertical}
  .editor-price-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .editor-photo-preview-wrap{display:grid;grid-template-columns:110px minmax(0,1fr);align-items:center;gap:12px;padding:10px;border:1px solid var(--n-line);border-radius:15px;background:var(--n-bg);box-shadow:var(--in)}
  .editor-photo-preview{width:110px;height:100px;object-fit:cover;border-radius:11px;background:var(--n-well)}
  .editor-photo-copy{min-width:0;display:grid;gap:7px}
  .editor-photo-copy strong{font-size:11px}
  .editor-photo-copy small{font-size:10px;color:var(--n-mute);line-height:1.4}
  .editor-photo-controls{display:flex;gap:7px;flex-wrap:wrap}
  .editor-photo-controls .editor-action{min-height:31px}
  .editor-file-input{max-width:100%;font-size:10px;color:var(--n-mute)}
  .editor-form-actions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:9px;margin-top:4px}
  .editor-save-btn{min-height:46px;border-radius:13px;background:var(--or-grad);color:#fff;box-shadow:var(--or-in);font-size:12px;font-weight:900}
  .editor-cancel-btn{min-height:46px;border-radius:13px;background:var(--n-bg);color:var(--n-ink);box-shadow:var(--rm);font-size:12px;font-weight:850}
  .editor-form-footer{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:5px;padding-top:12px;border-top:1px solid var(--n-line)}
  .editor-delete-btn{min-height:36px;border:1px solid #e8bdbc;border-radius:10px;background:transparent;color:#b02d28;padding:7px 11px;font-size:10px;font-weight:850}
  .editor-help{font-size:10px;line-height:1.45;color:var(--n-mute);margin:0}
  @media(min-width:680px){.editor-menu-list{grid-template-columns:repeat(2,minmax(0,1fr))}.editor-menu-card{grid-template-columns:68px minmax(0,1fr);gap:10px}.editor-menu-image{width:68px;height:68px}}
  @media(max-width:420px){.menu-editor-header{grid-template-columns:auto minmax(0,1fr);gap:10px}.menu-editor-add{grid-column:1/-1;width:100%}.menu-editor-tools{grid-template-columns:minmax(0,1fr)}#editorStatusFilter{max-width:none;width:100%}.editor-menu-card{grid-template-columns:62px minmax(0,1fr);gap:9px;padding:8px}.editor-menu-image{width:62px;height:62px}.editor-menu-actions{gap:5px}.editor-action{padding:7px 8px}.menu-item-editor-form{padding:14px}.editor-photo-preview-wrap{grid-template-columns:86px minmax(0,1fr)}.editor-photo-preview{width:86px;height:86px}}
</style>

<dialog id="menuItemEditorDialog">
  <form id="menuItemEditorForm" class="menu-item-editor-form">
    <div class="editor-dialog-head"><div><h2 id="menuItemEditorTitle">Add menu item</h2><p>Edit every detail in one place.</p></div><button class="editor-close" id="menuItemEditorClose" type="button" aria-label="Close editor">×</button></div>
    <div class="editor-photo-preview-wrap"><img id="menuEditorImagePreview" class="editor-photo-preview" alt="Dish image preview"><div class="editor-photo-copy"><strong>Dish photo</strong><small>Upload a photo or paste an image URL. Uploaded photos are resized to keep the app lightweight.</small><div class="editor-photo-controls"><label class="editor-action" for="menuEditorImageFile">Upload image</label><button class="editor-action" id="menuEditorRemoveImage" type="button">Use default</button></div><input id="menuEditorImageFile" class="editor-file-input" type="file" accept="image/*"></div></div>
    <div class="editor-field"><label for="menuEditorImageUrl">Image URL (optional)</label><input id="menuEditorImageUrl" class="editor-input" type="url" placeholder="https://…"></div>
    <div class="editor-field"><label for="menuEditorName">Item name</label><input id="menuEditorName" class="editor-input" maxlength="80" required placeholder="e.g. Special Afghani Chaap"></div>
    <div class="editor-field"><label for="menuEditorCategory">Category</label><input id="menuEditorCategory" class="editor-input" maxlength="50" required list="menuEditorCategoryOptions" placeholder="e.g. Chaap Dry"><datalist id="menuEditorCategoryOptions"></datalist></div>
    <div class="editor-price-grid"><div class="editor-field"><label for="menuEditorHalf">Half price (₹)</label><input id="menuEditorHalf" class="editor-input" type="number" min="0" max="1000000" step="0.5" placeholder="Optional"></div><div class="editor-field"><label for="menuEditorFull">Full price (₹)</label><input id="menuEditorFull" class="editor-input" type="number" min="0" max="1000000" step="0.5" placeholder="Optional"></div></div>
    <div class="editor-field"><label for="menuEditorAliases">Search names / spelling variations</label><textarea id="menuEditorAliases" class="editor-textarea" placeholder="Separate aliases with commas"></textarea></div>
    <p class="editor-help">Enter at least one valid price. Leave the image blank to use the app's matching default food photo. Saved menu changes apply to future orders; past orders retain their recorded name and price.</p>
    <div class="editor-form-actions"><button class="editor-cancel-btn" id="menuEditorCancel" type="button">Cancel</button><button class="editor-save-btn" id="menuEditorSave" type="submit">Save changes</button></div>
    <div class="editor-form-footer"><span class="editor-help" id="menuEditorItemKind">Menu item</span><button class="editor-delete-btn" id="menuEditorDelete" type="button" hidden>Delete item</button></div>
  </form>
</dialog>

<script id="dedicated-menu-editor-logic">
(function(){
  const $id = id => document.getElementById(id);
  const OVERRIDES_KEY = 'charlie-menu-item-overrides-v1';
  const MENU_STATE_KEY = 'charlie-menu-management-v1';
  const CUSTOM_KEY = 'charlie-custom-menu-v1';
  const keyOf = value => normalize(String(value || ''));
  const oldPhotoFor = photoFor;
  let overrides = {};
  let editingItem = null;
  let addingNew = false;
  let editingImage = '';
  let defaultPreview = '';
  let loadedOverrides = false;

  try { const value = JSON.parse(localStorage.getItem(OVERRIDES_KEY) || '{}'); if (value && typeof value === 'object' && !Array.isArray(value)) overrides = value; } catch (_) { overrides = {}; }

  // A built-in item's original key never changes, even if its display name is edited.
  menu.forEach(item => { if (!item.custom && !item._baseKey) item._baseKey = item.n; });
  menu.forEach(item => {
    if (item.custom) return;
    const base = item._baseKey;
    const value = overrides[keyOf(base)];
    if (value && typeof value === 'object') {
      ['n','c','h','f','a','image'].forEach(key => { if (Object.prototype.hasOwnProperty.call(value, key)) item[key] = value[key]; });
      if (!Array.isArray(item.a)) item.a = [String(item.n).toLowerCase()];
    }
  });
  loadedOverrides = true;

  // A single image resolver powers menu cards and any view that renders a current menu item.
  photoFor = function(name){
    const text = typeof name === 'string' ? name : (name && (name.n || name.name)) || '';
    const item = menu.find(entry => keyOf(entry.n) === keyOf(text));
    if (item && typeof item.image === 'string' && item.image.trim()) return item.image;
    return oldPhotoFor(text);
  };

  function itemAvailable(item){ return !!(window.ccMenuManagement && window.ccMenuManagement.isAvailable(item)); }
  function currentMenuItems(){ return menu.slice().sort((a,b)=>String(a.c||'Other').localeCompare(String(b.c||'Other'))||String(a.n).localeCompare(String(b.n))); }
  function allCategories(){ return Array.from(new Set(menu.map(item=>String(item.c||'Other').trim()).filter(Boolean))).sort((a,b)=>a.localeCompare(b)); }
  function imageSource(item){ return item && item.image ? item.image : oldPhotoFor(item ? item.n : ''); }

  // The normal menu is intentionally uncluttered: selection and prices only, no edit/delete controls.
  renderMenu = function(){
    renderCategoryPills('menuCategories', menuCategory, category=>{menuCategory=category;renderMenu();});
    const search = keyOf($id('menuSearch') ? $id('menuSearch').value : '');
    const host = $id('menuList'); if(!host) return; host.innerHTML='';
    let items = menu.filter(item=>categoryMatches(item,menuCategory)&&(!search||keyOf(item.n+' '+item.c+' '+(item.a||[]).join(' ')).includes(search)));
    items.sort((a,b)=>String(a.c||'').localeCompare(String(b.c||''))||String(a.n).localeCompare(String(b.n)));
    if(!items.length){host.innerHTML='<div class="order-empty"><strong>No menu items found</strong><p>Try another spelling or category.</p></div>';return;}
    let last='';
    items.forEach(item=>{
      const available=itemAvailable(item), category=categoryFor(item);
      if(category!==last){const heading=document.createElement('h2');heading.className='group-heading';heading.textContent=category;host.append(heading);last=category;}
      const row=document.createElement('article');row.className='menu-row'+(available?'':' menu-row-unavailable');
      const img=document.createElement('img');img.className='menu-thumb';img.src=imageSource(item);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(item.n);};img.alt=item.n;img.loading='lazy';
      const main=document.createElement('div');main.className='menu-main';
      const top=document.createElement('div');top.className='menu-title-row';
      const titleWrap=document.createElement('div');titleWrap.className='menu-title-wrap';
      const title=document.createElement('div');title.className='menu-name';title.textContent=item.n;titleWrap.append(title);
      if(!available){const badge=document.createElement('span');badge.className='availability-badge';badge.textContent='Unavailable';titleWrap.append(badge);}
      top.append(titleWrap);
      const categoryText=document.createElement('div');categoryText.className='menu-cat';categoryText.textContent=category;
      const prices=document.createElement('div');prices.className='menu-prices';
      [['h',item.hLabel||'Half'],['f',item.fLabel||'Full']].forEach(([size,label])=>{const rate=rateFor(item,size);if(rate==null)return;const button=document.createElement('button');button.type='button';button.className='menu-price-btn';button.textContent=label+' · '+fmt(rate);button.disabled=!available;button.onclick=()=>addToDraft(item,size);prices.append(button);});
      main.append(top,categoryText,prices);row.append(img,main);host.append(row);
    });
  };

  function renderEditor(){
    const host=$id('editorMenuList'); if(!host)return;
    const query=keyOf($id('editorSearch')?.value||'');
    const status=$id('editorStatusFilter')?.value||'all';
    let items=currentMenuItems().filter(item=>{
      const available=itemAvailable(item);
      const match=!query||keyOf(item.n+' '+item.c+' '+(item.a||[]).join(' ')).includes(query);
      return match&&(status==='all'||(status==='available'&&available)||(status==='unavailable'&&!available));
    });
    host.innerHTML='';
    const availableCount=menu.filter(itemAvailable).length;
    $id('editorMenuStats').textContent=`${menu.length} items · ${availableCount} available · ${menu.length-availableCount} unavailable`;
    if(!items.length){host.innerHTML='<div class="order-empty"><strong>No matching items</strong><p>Change the search or filter, or add a new dish.</p></div>';return;}
    items.forEach(item=>{
      const available=itemAvailable(item), card=document.createElement('article');card.className='editor-menu-card';
      const img=document.createElement('img');img.className='editor-menu-image';img.src=imageSource(item);img.onerror=()=>{img.onerror=null;img.src=fallbackPhoto(item.n);};img.alt=item.n;img.loading='lazy';
      const body=document.createElement('div');body.className='editor-menu-body';
      const name=document.createElement('div');name.className='editor-menu-name';name.textContent=item.n;
      const statusBadge=document.createElement('span');statusBadge.className='editor-status'+(available?'':' off');statusBadge.textContent=available?'Available':'Unavailable';name.append(statusBadge);
      const meta=document.createElement('div');meta.className='editor-menu-meta';meta.textContent=String(item.c||'Other')+(item.custom?' · Custom item':' · Menu item');
      const price=document.createElement('div');price.className='editor-menu-price';const parts=[];if(rateFor(item,'h')!=null)parts.push('Half '+fmt(rateFor(item,'h')));if(rateFor(item,'f')!=null)parts.push('Full '+fmt(rateFor(item,'f')));price.textContent=parts.join('  ·  ')||'No valid price';
      const actions=document.createElement('div');actions.className='editor-menu-actions';
      const edit=document.createElement('button');edit.type='button';edit.className='editor-action primary';edit.textContent='Edit details';edit.onclick=()=>openEditor(item);
      const toggle=document.createElement('button');toggle.type='button';toggle.className='editor-action unavail';toggle.textContent=available?'Mark unavailable':'Make available';toggle.onclick=()=>{window.ccMenuManagement.setMenuAvailability(item.n,!available);renderEditor();};
      const remove=document.createElement('button');remove.type='button';remove.className='editor-action danger';remove.textContent='Delete';remove.onclick=()=>{window.ccMenuManagement.deleteMenuItem(item.n);renderEditor();};
      actions.append(edit,toggle,remove);body.append(name,meta,price,actions);card.append(img,body);host.append(card);
    });
  }

  function setEditorImagePreview(src){
    const preview=$id('menuEditorImagePreview');
    preview.onerror=()=>{preview.onerror=null;preview.src=fallbackPhoto($id('menuEditorName').value||'chaap');};
    preview.src=src||oldPhotoFor($id('menuEditorName').value||'chaap');
  }

  function openEditor(item=null){
    editingItem=item; addingNew=!item; editingImage=item&&item.image?item.image:'';
    $id('menuItemEditorTitle').textContent=item?'Edit menu item':'Add menu item';
    $id('menuEditorName').value=item?item.n:'';
    $id('menuEditorCategory').value=item?item.c:(allCategories()[0]||'Other');
    $id('menuEditorHalf').value=item&&item.h!=null?item.h:'';
    $id('menuEditorFull').value=item&&item.f!=null?item.f:'';
    $id('menuEditorAliases').value=item?(item.a||[]).filter(a=>keyOf(a)!==keyOf(item.n)).join(', '):'';
    $id('menuEditorImageUrl').value=editingImage&&!editingImage.startsWith('data:')?editingImage:'';
    $id('menuEditorImageFile').value='';
    $id('menuEditorItemKind').textContent=item?(item.custom?'Custom item':'Built-in menu item'):'New custom item';
    $id('menuEditorDelete').hidden=!item;
    $id('menuEditorSave').textContent=item?'Save changes':'Add to menu';
    setEditorImagePreview(editingImage||oldPhotoFor(item?item.n:'chaap'));
    $id('menuItemEditorDialog').showModal();
  }

  function saveAllMenuData(){
    const keys=[CUSTOM_KEY,MENU_STATE_KEY,OVERRIDES_KEY];const previous={};
    try{keys.forEach(k=>previous[k]=localStorage.getItem(k));
      if(!window.ccMenuManagement.saveMenuData())throw new Error('menu storage');
      const next={};
      menu.filter(item=>!item.custom).forEach(item=>{
        const base=String(item._baseKey||item.n);
        next[keyOf(base)]={n:item.n,c:item.c,h:item.h==null?null:Number(item.h),f:item.f==null?null:Number(item.f),a:Array.isArray(item.a)?item.a:[item.n.toLowerCase()],image:item.image||''};
      });
      localStorage.setItem(OVERRIDES_KEY,JSON.stringify(next));overrides=next;return true;
    }catch(error){keys.forEach(k=>{try{if(previous[k]===null||previous[k]===undefined)localStorage.removeItem(k);else localStorage.setItem(k,previous[k]);}catch(_){}});return false;}
  }

  function refreshAfterEdit(oldName,newName){
    if(oldName!==newName){
      draftItems.forEach(entry=>{if(keyOf(entry.name)===keyOf(oldName)){entry.name=newName;const current=menu.find(item=>keyOf(item.n)===keyOf(newName));const rate=current&&rateFor(current,entry.size);if(rate==null)entry._remove=true;else entry.rate=Number(rate);}});
      draftItems=draftItems.filter(entry=>!entry._remove);draftItems.forEach(entry=>delete entry._remove);
      Object.values(chosenByLine).forEach(map=>Object.keys(map).forEach(line=>{if(keyOf(map[line])===keyOf(oldName))map[line]=newName;}));
      if(Array.isArray(popularNames)){for(let i=0;i<popularNames.length;i++)if(keyOf(popularNames[i])===keyOf(oldName))popularNames[i]=newName;}
    }else{
      draftItems.forEach(entry=>{if(keyOf(entry.name)===keyOf(newName)){const current=menu.find(item=>keyOf(item.n)===keyOf(newName));const rate=current&&rateFor(current,entry.size);if(rate==null)entry._remove=true;else entry.rate=Number(rate);}});
      draftItems=draftItems.filter(entry=>!entry._remove);draftItems.forEach(entry=>delete entry._remove);
    }
    if(typeof saveDraft==='function')saveDraft();
    window.ccMenuManagement.refreshMenuViews();
    renderEditor();
  }

  $id('menuEditorImageUrl').addEventListener('input',()=>{
    const value=$id('menuEditorImageUrl').value.trim();
    if(value){editingImage=value;setEditorImagePreview(value);}else if(!editingImage.startsWith('data:')){editingImage='';setEditorImagePreview('');}
  });
  $id('menuEditorImageFile').addEventListener('change',async event=>{
    const file=event.target.files&&event.target.files[0];if(!file)return;
    if(!file.type.startsWith('image/')){showToast('Choose an image file');event.target.value='';return;}
    if(file.size>12*1024*1024){showToast('Please choose an image smaller than 12 MB');event.target.value='';return;}
    try{
      const source=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(new Error('read'));reader.readAsDataURL(file);});
      const image=await new Promise((resolve,reject)=>{const img=new Image();img.onload=()=>resolve(img);img.onerror=()=>reject(new Error('image'));img.src=source;});
      const max=720,scale=Math.min(1,max/Math.max(image.naturalWidth,image.naturalHeight));
      const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(image.naturalWidth*scale));canvas.height=Math.max(1,Math.round(image.naturalHeight*scale));
      const ctx=canvas.getContext('2d');if(!ctx)throw new Error('canvas');ctx.drawImage(image,0,0,canvas.width,canvas.height);
      let output=canvas.toDataURL('image/jpeg',.72);
      if(output.length>420000)output=canvas.toDataURL('image/jpeg',.58);
      editingImage=output;$id('menuEditorImageUrl').value='';setEditorImagePreview(output);showToast('Image added — save the item to keep it');
    }catch(_){showToast('Could not read that image. Try another photo.');}
  });
  $id('menuEditorRemoveImage').addEventListener('click',()=>{editingImage='';$id('menuEditorImageUrl').value='';$id('menuEditorImageFile').value='';setEditorImagePreview('');});
  $id('menuItemEditorClose').onclick=$id('menuEditorCancel').onclick=()=>{$id('menuItemEditorDialog').close();};
  $id('editorAddItem').onclick=()=>openEditor(null);
  $id('menuEditorBack').onclick=()=>setTab('menu');
  $id('editorSearch').addEventListener('input',renderEditor);
  $id('editorStatusFilter').addEventListener('change',renderEditor);
  $id('menuEditorDelete').onclick=()=>{if(!editingItem)return;const name=editingItem.n;$id('menuItemEditorDialog').close();window.ccMenuManagement.deleteMenuItem(name);renderEditor();};

  $id('menuItemEditorForm').addEventListener('submit',event=>{
    event.preventDefault();
    const name=$id('menuEditorName').value.trim();
    const category=$id('menuEditorCategory').value.trim();
    const halfText=$id('menuEditorHalf').value.trim(),fullText=$id('menuEditorFull').value.trim();
    const valid=value=>value===''||(Number.isFinite(Number(value))&&Number(value)>=0&&Number(value)<=1000000);
    if(!name){showToast('Enter an item name');$id('menuEditorName').focus();return;}
    if(!category){showToast('Enter a category');$id('menuEditorCategory').focus();return;}
    if(!valid(halfText)||!valid(fullText)){showToast('Enter valid prices from ₹0 to ₹10,00,000');return;}
    if(halfText===''&&fullText===''){showToast('Enter at least one price');return;}
    const duplicate=menu.find(item=>keyOf(item.n)===keyOf(name)&&item!==editingItem);
    if(duplicate){showToast('Another item already uses that name');return;}
    const aliases=[name,...$id('menuEditorAliases').value.split(',').map(v=>v.trim()).filter(Boolean)];
    const uniqueAliases=[...new Map(aliases.map(v=>[keyOf(v),v])).values()];
    const oldName=editingItem?editingItem.n:'';
    const previousMenu=menu.slice();
    const previousItemSnapshots=new Map(previousMenu.map(entry=>[entry,{...entry,a:Array.isArray(entry.a)?entry.a.slice():[]} ]));
    const previousDraft=draftItems.map(item=>({...item}));
    const previousChosen=JSON.parse(JSON.stringify(chosenByLine));
    const previousPopular=Array.isArray(popularNames)?popularNames.slice():[];
    let item=editingItem;
    let previousFlags=null;
    if(!item){previousFlags=window.ccMenuManagement.clearMenuFlags(name);item={n:name,c:category,h:null,f:null,a:[],custom:true,available:true};menu.push(item);}
    item.n=name;item.c=category;item.h=halfText===''?null:Number(halfText);item.f=fullText===''?null:Number(fullText);item.a=uniqueAliases;
    item.image=editingImage||'';
    if(!item.custom&&!item._baseKey)item._baseKey=oldName||name;
    if(!saveAllMenuData()){
      previousItemSnapshots.forEach((snapshot,entry)=>{for(const k of Object.keys(entry))if(!(k in snapshot))delete entry[k];Object.assign(entry,snapshot);});
      menu.splice(0,menu.length,...previousMenu);draftItems=previousDraft;chosenByLine=previousChosen;
      if(Array.isArray(popularNames)){popularNames.splice(0,popularNames.length,...previousPopular);}
      window.ccMenuManagement.restoreMenuFlags(previousFlags);
      showToast('Could not save. Device storage may be full; no changes were kept.');return;
    }
    // A renamed item keeps its prior availability state via the stable _baseKey.
    $id('menuItemEditorDialog').close();
    refreshAfterEdit(oldName,name);
    showToast((addingNew?'Added ':'Saved ')+name);
  });

  // Make the top-right button the sole entry point to the dedicated edit space.
  $id('addCustomMenuItem').textContent='✎ Edit menu';
  $id('addCustomMenuItem').setAttribute('aria-label','Open menu editor');
  function openMenuEditorSpace(){
    activeTab='menuEditor';document.body.dataset.tab='menu';
    document.querySelectorAll('.view').forEach(view=>view.classList.toggle('active',view.id==='menuEditorView'));
    document.querySelectorAll('.nav-btn').forEach(button=>button.classList.toggle('active',button.dataset.tab==='menu'));
    renderEditor();renderDraftDock();window.scrollTo({top:0,behavior:'smooth'});
  }
  $id('addCustomMenuItem').onclick=openMenuEditorSpace;
  const baseSetTab=setTab;
  setTab=function(tab,scroll=true){
    if(tab==='menuEditor'){openMenuEditorSpace();return;}
    baseSetTab(tab,scroll);
  };
  renderCategoryPills('menuCategories',menuCategory,category=>{menuCategory=category;renderMenu();});
  renderMenu();renderEditor();
  if(!loadedOverrides) menu.forEach(item=>{if(!item.custom&&!item._baseKey)item._baseKey=item.n;});
})();
</script>


<dialog class="service-dialog" id="customerCheckoutDialog" aria-labelledby="customerCheckoutTitle">
  <form id="customerCheckoutForm" class="service-dialog-inner">
    <div class="service-dialog-head"><div><span class="service-settings-kicker">CHECKOUT</span><h2 id="customerCheckoutTitle">Complete your order</h2><p id="customerCheckoutSubtitle">Confirm the details before placing your order.</p></div><button type="button" class="service-dialog-close" data-service-close="customerCheckoutDialog" aria-label="Close checkout">×</button></div>
    <div id="customerCheckoutFormBody">
      <div class="service-checkout-lines" id="customerCheckoutLines"></div>
      <div class="service-checkout-totals" id="customerCheckoutTotals"></div>
      <div class="service-form-grid">
        <label class="service-form-field"><span>Your name *</span><input id="customerName" name="customerName" required maxlength="80" autocomplete="name" placeholder="Name for the order"></label>
        <label class="service-form-field"><span>Mobile number *</span><input id="customerPhone" name="customerPhone" required maxlength="16" autocomplete="tel" inputmode="tel" placeholder="10-digit mobile number"></label>
      </div>
      <label class="service-form-field"><span>Order type *</span><select id="customerOrderType" name="customerOrderType" required><option value="dine-in">Dine-in</option><option value="takeaway">Takeaway</option><option value="delivery">Delivery</option></select></label>
      <label class="service-form-field" id="customerTableField"><span>Table number *</span><input id="customerTable" name="customerTable" maxlength="20" placeholder="e.g. Table 4"></label>
      <label class="service-form-field" id="customerAddressField" hidden><span>Delivery address *</span><textarea id="customerAddress" name="customerAddress" maxlength="400" rows="3" placeholder="House number, street, area and landmark"></textarea></label>
      <label class="service-form-field"><span>Payment method</span><select id="customerPaymentMethod" name="customerPaymentMethod"><option value="Cash at counter">Cash at counter</option><option value="UPI at counter">UPI at counter</option><option value="Cash on delivery">Cash on delivery</option></select><small>Payment is not collected by this page. Staff must verify and mark payment received.</small></label>
      <label class="service-form-field"><span>Preparation notes (optional)</span><textarea id="customerOrderNotes" name="customerOrderNotes" maxlength="300" rows="2" placeholder="Spice level, no onion, etc."></textarea></label>
      <div class="service-checkout-warning" id="customerCheckoutWarning" hidden></div>
      <button class="service-place-order" type="submit" id="customerPlaceOrder">Place order · ₹0</button>
      <p class="service-terms-note">Submitting sends the order to this browser’s order list. This standalone file does not send orders to another device or process online payments.</p>
    </div>
    <div id="customerCheckoutSuccess" hidden class="service-checkout-success">
      <div class="service-success-icon">✓</div><span class="service-settings-kicker">ORDER RECEIVED</span><h3 id="customerSuccessTitle">Order placed</h3><p id="customerSuccessText">Your order has been added to the order list.</p><div class="service-receipt-card" id="customerReceipt"></div>
      <div class="service-success-actions"><button type="button" id="customerContinueShopping" class="service-secondary-btn">Continue browsing</button><button type="button" id="customerPrintReceipt" class="service-primary-btn">Print receipt</button></div>
    </div>
  </form>
</dialog>

<dialog class="service-dialog service-track-dialog" id="customerTrackDialog" aria-labelledby="customerTrackTitle">
  <div class="service-dialog-inner"><div class="service-dialog-head"><div><span class="service-settings-kicker">ORDER STATUS</span><h2 id="customerTrackTitle">Track an order</h2><p>Enter the order number shown on your receipt.</p></div><button type="button" class="service-dialog-close" data-service-close="customerTrackDialog" aria-label="Close tracking">×</button></div>
    <form id="customerTrackForm" class="service-track-form"><label class="service-form-field"><span>Order number</span><input id="customerTrackId" inputmode="numeric" required placeholder="e.g. 104"></label><button class="service-primary-btn" type="submit">Check status</button></form>
    <div id="customerTrackResult" class="service-track-result" aria-live="polite"></div>
  </div>
</dialog>


<script id="service-ready-logic">
(function(){
  'use strict';
  const $s=id=>document.getElementById(id);
  const SERVICE_CONFIG_KEY='charlie-service-config-v1';
  const CUSTOMER_CART_KEY='charlie-customer-cart-v1';
  const BACKUP_KEYS=['charlie-orders-v1','charlie-draft-v1','charlie-custom-menu-v1','charlie-menu-management-v1','charlie-menu-item-overrides-v1','charlie-service-config-v1','charlie-theme','charlie-customer-cart-v1'];
  const readJSON=(key,fallback)=>{try{const raw=localStorage.getItem(key);return raw==null?fallback:JSON.parse(raw)}catch(_){return fallback}};
  const defaultConfig={isOpen:true,taxPercent:0,deliveryFee:0};
  let serviceConfig={...defaultConfig,...(readJSON(SERVICE_CONFIG_KEY,{})||{})};
  let customerCart=readJSON(CUSTOMER_CART_KEY,[]);if(!Array.isArray(customerCart))customerCart=[];
  let customerCategory='All',lastCustomerOrderId=null,customerMode=(new URLSearchParams(location.search).get('mode')==='customer'||location.pathname==='/customer'||location.pathname==='/customer/');
  let sharedServiceActive=false,staffAuthenticated=false,serviceSyncTimer=null,remoteMenuLoaded=false;
  const money=n=>'₹'+Number(n||0).toLocaleString('en-IN',{minimumFractionDigits:0,maximumFractionDigits:2});
  const keyName=s=>String(s||'').toLowerCase().trim().replace(/\s+/g,' ');
  const safeText=(node,text)=>{if(node)node.textContent=String(text??'')};
  const itemAvailable=item=>!!item&&(sharedServiceActive?item.available!==false:(!window.ccMenuManagement||window.ccMenuManagement.isAvailable(item))&&item.available!==false);
  const customerCategoryOf=item=>typeof categoryFor==='function'?categoryFor(item):(item.c||'Other');
  const itemSizeOptions=item=>[['h',item.hLabel||'Half'],['f',item.fLabel||'Full']].filter(([size])=>item[size]!=null&&Number.isFinite(Number(item[size]))&&Number(item[size])>=0);
  function persistServiceConfig(){try{localStorage.setItem(SERVICE_CONFIG_KEY,JSON.stringify(serviceConfig));return true}catch(_){if(typeof showToast==='function')showToast('Could not save settings in this browser');return false}}
  function persistCustomerCart(){try{localStorage.setItem(CUSTOMER_CART_KEY,JSON.stringify(customerCart))}catch(_){if(typeof showToast==='function')showToast('Cart could not be saved on this device')}}
  function currentCustomerTotal(){return customerCart.reduce((s,line)=>s+(Number(line.qty)||0)*(Number(line.rate)||0),0)}
  function updateCustomerFees(){
    const subtotal=currentCustomerTotal(),type=$s('customerOrderType')?.value||'dine-in';
    const tax=Math.round(subtotal*(Number(serviceConfig.taxPercent)||0))/100;
    const delivery=type==='delivery'?Math.max(0,Number(serviceConfig.deliveryFee)||0):0;
    return {subtotal,tax,delivery,total:Math.round((subtotal+tax+delivery)*100)/100};
  }
  function showServiceToast(message){if(typeof showToast==='function')showToast(message);else console.log(message)}
  function renderCustomerCategories(){
    const host=$s('customerCategories');if(!host)return;host.innerHTML='';
    const cats=['All',...new Set(menu.map(customerCategoryOf).filter(Boolean))];
    if(!cats.includes(customerCategory))customerCategory='All';
    cats.forEach(cat=>{const b=document.createElement('button');b.type='button';b.className='customer-category'+(cat===customerCategory?' active':'');b.textContent=cat;b.setAttribute('aria-pressed',String(cat===customerCategory));b.onclick=()=>{customerCategory=cat;renderCustomerCategories();renderCustomerMenu()};host.append(b)});
  }
  function addCustomerItem(item,size){
    if(!itemAvailable(item)){showServiceToast('This item is currently unavailable');renderCustomerMenu();return}
    const rate=Number(item[size]);if(!Number.isFinite(rate)||rate<0){showServiceToast('This size does not have a valid price');return}
    const sizeLabel=item[size==='f'?'fLabel':'hLabel']||(size==='f'?'Full':'Half');
    const existing=customerCart.find(line=>keyName(line.name)===keyName(item.n)&&line.size===size);
    if(existing){if(existing.qty>=99){showServiceToast('Maximum quantity is 99 per size');return}existing.qty+=1}
    else customerCart.push({name:item.n,qty:1,size,sizeLabel,rate});
    persistCustomerCart();renderCustomerCart();showServiceToast(item.n+' added to your cart');
  }
  function renderCustomerMenu(){
    const host=$s('customerProducts');if(!host)return;host.innerHTML='';
    const term=keyName($s('customerSearch')?.value||'');
    const items=menu.filter(item=>(customerCategory==='All'||customerCategoryOf(item)===customerCategory)&&(!term||keyName([item.n,item.c,...(item.a||[])].join(' ')).includes(term)));
    safeText($s('customerMenuTitle'),customerCategory==='All'?'Our menu':customerCategory);
    safeText($s('customerMenuCount'),`${items.length} item${items.length===1?'':'s'} · Choose a size to add`);
    if(!items.length){host.innerHTML='<div class="order-empty"><strong>No items found</strong><p>Try another search or choose a different category.</p></div>';return}
    items.forEach(item=>{
      const available=itemAvailable(item);const card=document.createElement('article');card.className='customer-product-card'+(available?'':' customer-product-unavailable');
      const img=document.createElement('img');img.className='customer-product-photo';img.alt=item.n;img.loading='lazy';img.src=item.image|| (typeof photoFor==='function'?photoFor(item.n):'');img.onerror=()=>{img.onerror=null;img.src=typeof fallbackPhoto==='function'?fallbackPhoto(item.n):''};
      const body=document.createElement('div');body.className='customer-product-body';const cat=document.createElement('span');cat.className='customer-product-category';cat.textContent=customerCategoryOf(item);
      const title=document.createElement('h3');title.className='customer-product-name';title.textContent=item.n;const options=document.createElement('div');options.className='customer-product-options';
      itemSizeOptions(item).forEach(([size,label])=>{const b=document.createElement('button');b.type='button';b.className='customer-add-option';b.disabled=!available;
        const left=document.createElement('span');left.textContent=label;const price=document.createElement('strong');price.textContent=money(item[size]);b.append(left,price);b.setAttribute('aria-label',`Add ${item.n}, ${label}, ${money(item[size])}`);b.onclick=()=>addCustomerItem(item,size);options.append(b)});
      body.append(cat,title,options);card.append(img,body);host.append(card);
    });
  }
  function renderCustomerCart(){
    let dock=$s('customerCartDock');if(!dock){dock=document.createElement('div');dock.id='customerCartDock';dock.className='customer-cart-dock';dock.hidden=true;dock.innerHTML='<div class="customer-cart-info"><strong id="customerCartCount">0 items</strong><span id="customerCartTotal">₹0</span></div><button class="customer-cart-checkout" id="customerCartCheckout" type="button">Review cart →</button>';document.body.append(dock);$s('customerCartCheckout').onclick=openCustomerCheckout;}
    const count=customerCart.reduce((n,line)=>n+(Number(line.qty)||0),0);dock.hidden=count===0;
    safeText($s('customerCartCount'),`${count} item${count===1?'':'s'} in your cart`);safeText($s('customerCartTotal'),money(currentCustomerTotal()));
    if($s('customerCartCheckout'))$s('customerCartCheckout').textContent=`Review cart · ${money(currentCustomerTotal())}`;
  }
  function renderCheckoutLines(){
    const lines=$s('customerCheckoutLines');if(!lines)return;lines.innerHTML='';
    customerCart.forEach((line,index)=>{const row=document.createElement('div');row.className='service-checkout-line';const info=document.createElement('div');const name=document.createElement('strong');name.textContent=line.name;const sub=document.createElement('small');sub.textContent=`${line.qty} × ${line.sizeLabel||line.size||''} · ${money(line.rate)} each`;info.append(name,sub);const controls=document.createElement('div');controls.style.cssText='display:flex;align-items:center;gap:5px;flex:0 0 auto';
      const minus=document.createElement('button');minus.type='button';minus.className='service-secondary-btn';minus.style.cssText='min-height:28px;padding:0 8px';minus.textContent='−';minus.setAttribute('aria-label','Decrease '+line.name);minus.onclick=()=>changeCustomerQty(index,-1);
      const plus=document.createElement('button');plus.type='button';plus.className='service-secondary-btn';plus.style.cssText='min-height:28px;padding:0 8px';plus.textContent='+';plus.setAttribute('aria-label','Increase '+line.name);plus.onclick=()=>changeCustomerQty(index,1);
      const price=document.createElement('strong');price.textContent=money(line.qty*line.rate);controls.append(minus,plus,price);row.append(info,controls);lines.append(row)});
    const f=updateCustomerFees(),totals=$s('customerCheckoutTotals');totals.innerHTML='';
    const addTotal=(label,value,grand=false)=>{const row=document.createElement('div');row.className='service-total-line'+(grand?' grand':'');const l=document.createElement('span');l.textContent=label;const v=document.createElement('strong');v.textContent=money(value);row.append(l,v);totals.append(row)};
    addTotal('Subtotal',f.subtotal);if(f.tax>0)addTotal(`Tax (${Number(serviceConfig.taxPercent)||0}%)`,f.tax);if(f.delivery>0)addTotal('Delivery fee',f.delivery);addTotal('Total',f.total,true);
    safeText($s('customerPlaceOrder'),`Place order · ${money(f.total)}`);
  }
  function changeCustomerQty(index,delta){const line=customerCart[index];if(!line)return;line.qty+=delta;if(line.qty<=0)customerCart.splice(index,1);else if(line.qty>99)line.qty=99;persistCustomerCart();renderCustomerCart();renderCheckoutLines();if(!customerCart.length){$s('customerCheckoutDialog').close();showServiceToast('Your cart is empty')}}
  function updateCheckoutOrderType(){const type=$s('customerOrderType')?.value||'dine-in';const table=$s('customerTableField'),address=$s('customerAddressField');if(table)table.hidden=type!=='dine-in';if(address)address.hidden=type!=='delivery';if($s('customerTable'))$s('customerTable').required=type==='dine-in';if($s('customerAddress'))$s('customerAddress').required=type==='delivery';const pay=$s('customerPaymentMethod');if(pay){const cod=pay.querySelector('option[value="Cash on delivery"]');if(cod)cod.hidden=type!=='delivery';if(type!=='delivery'&&pay.value==='Cash on delivery')pay.value='Cash at counter'}if($s('customerCheckoutDialog')?.open)renderCheckoutLines()}
  function showCheckoutWarning(text){const w=$s('customerCheckoutWarning');if(w){w.hidden=!text;safeText(w,text||'')}}
  function openCustomerCheckout(){
    if(!customerCart.length){showServiceToast('Add items to your cart first');return}
    if(!serviceConfig.isOpen){showServiceToast('The restaurant is not accepting orders right now');return}
    const dlg=$s('customerCheckoutDialog');$s('customerCheckoutFormBody').hidden=false;$s('customerCheckoutSuccess').hidden=true;$s('customerCheckoutForm').reset();$s('customerOrderType').value='dine-in';updateCheckoutOrderType();renderCheckoutLines();showCheckoutWarning('');dlg.showModal();
  }
  function updateCustomerOpenState(){
    const el=$s('customerOpenState'),text=$s('customerOpenText'),btn=$s('toggleBusinessOpen');if(el){el.classList.toggle('is-closed',!serviceConfig.isOpen);safeText(text,serviceConfig.isOpen?'Accepting orders':'Currently closed — orders paused')}
    if(btn){btn.classList.toggle('is-closed',!serviceConfig.isOpen);btn.setAttribute('aria-pressed',String(!!serviceConfig.isOpen));safeText(btn,serviceConfig.isOpen?'Open':'Closed')}
    safeText($s('serviceStatusText'),serviceConfig.isOpen?'Customers can place orders':'New orders are paused');
    if($s('customerPlaceOrder'))$s('customerPlaceOrder').disabled=!serviceConfig.isOpen;
  }
  function showCustomerReceipt(order){
    lastCustomerOrderId=order.id;$s('customerCheckoutFormBody').hidden=true;$s('customerCheckoutSuccess').hidden=false;
    safeText($s('customerSuccessTitle'),`Order #${order.id} placed`);safeText($s('customerSuccessText'),'Your order has been added successfully. Keep this order number for reference.');
    const r=$s('customerReceipt');r.innerHTML='';const h=document.createElement('h4');h.textContent=`CHARLIE CHAAP · ORDER #${order.id}`;r.append(h);
    [[`Customer`,order.customerName],[`Type`,order.orderType==='dine-in'?`Dine-in · ${order.tableNumber||'Table not set'}`:order.orderType==='delivery'?'Delivery':'Takeaway'],['Items',order.items.map(i=>`${i.qty} × ${i.name} (${i.sizeLabel||i.size})`).join(' · ')],['Payment',`${order.paymentMethod} · pending verification`],['Status','Placed'],['Total',money(order.total)]].forEach(([label,value])=>{const p=document.createElement('p');const b=document.createElement('strong');b.textContent=label+': ';p.append(b,document.createTextNode(String(value||'—')));r.append(p)});
  }
  function submitCustomerOrder(event){
    event.preventDefault();showCheckoutWarning('');
    if(!serviceConfig.isOpen){showCheckoutWarning('The restaurant has paused new orders. Please try again later.');return}
    if(!customerCart.length){showCheckoutWarning('Your cart is empty. Add at least one item.');return}
    const name=$s('customerName').value.trim(),phone=$s('customerPhone').value.trim(),type=$s('customerOrderType').value,table=$s('customerTable').value.trim(),address=$s('customerAddress').value.trim();
    const digits=phone.replace(/\D/g,'');
    if(name.length<2){showCheckoutWarning('Enter the customer name.');$s('customerName').focus();return}
    if(digits.length<10||digits.length>15){showCheckoutWarning('Enter a valid phone number (at least 10 digits).');$s('customerPhone').focus();return}
    if(type==='dine-in'&&!table){showCheckoutWarning('Enter your table number for dine-in.');$s('customerTable').focus();return}
    if(type==='delivery'&&!address){showCheckoutWarning('Enter the delivery address.');$s('customerAddress').focus();return}
    const invalid=customerCart.some(line=>{const current=menu.find(item=>keyName(item.n)===keyName(line.name));return !current||!itemAvailable(current)||!Number.isFinite(Number(current[line.size]))||Number(current[line.size])!==Number(line.rate)});
    if(invalid){showCheckoutWarning('A menu item or price has changed. Please review your cart.');return}
    const fees=updateCustomerFees();
    if(type==='delivery'&&fees.subtotal<=0){showCheckoutWarning('The order total must be greater than zero.');return}
    if(sharedServiceActive){
      const payload={customerName:name,phone,orderType:type,tableNumber:type==='dine-in'?table:'',address:type==='delivery'?address:'',notes:$s('customerOrderNotes').value.trim(),paymentMethod:$s('customerPaymentMethod').value,items:customerCart.map(line=>({name:line.name,size:line.size,qty:line.qty}))};
      $s('customerPlaceOrder').disabled=true;$s('customerPlaceOrder').textContent='Submitting order…';
      apiFetch('/api/orders',{method:'POST',body:JSON.stringify(payload)}).then(result=>{const order=result.order||result;orders=[order,...orders.filter(o=>String(o.id)!==String(order.id))];saveOrders();customerCart=[];persistCustomerCart();renderCustomerCart();renderCustomerMenu();showCustomerReceipt(order);updateCustomerOpenState();}).catch(error=>{showCheckoutWarning(error.message||'Could not submit the order. Please try again.');}).finally(()=>{if($s('customerPlaceOrder')){ $s('customerPlaceOrder').disabled=!serviceConfig.isOpen;$s('customerPlaceOrder').textContent=`Place order · ${money(updateCustomerFees().total)}`}});
      return;
    }
    const order={id:nextOrderId(),items:customerCart.map(line=>({...line})),subtotal:fees.subtotal,taxAmount:fees.tax,taxPercent:Number(serviceConfig.taxPercent)||0,deliveryFee:fees.delivery,total:fees.total,done:false,status:'pending',time:getOrderTime(),createdAt:new Date().toISOString(),source:'customer',customerName:name,phone,orderType:type,tableNumber:type==='dine-in'?table:'',address:type==='delivery'?address:'',notes:$s('customerOrderNotes').value.trim(),paymentMethod:$s('customerPaymentMethod').value,paymentStatus:'unpaid'};
    orders.push(order);saveOrders();
    customerCart=[];persistCustomerCart();renderCustomerCart();
    try{renderOrders()}catch(_){}try{renderHistory()}catch(_){}try{renderCustomerMenu()}catch(_){}
    showCustomerReceipt(order);updateCustomerOpenState();
  }
  function showTrackedOrder(order){
    const host=$s('customerTrackResult');if(!host)return;host.innerHTML='';if(!order){host.textContent='No order with that number was found in this browser. In local preview mode, orders from another device are not synced.';return}
    const h=document.createElement('strong');h.textContent=`Order #${order.id} · ${orderStatus(order)==='done'?'Completed':orderStatus(order)==='preparing'?'Preparing':orderStatus(order)==='cancelled'?'Cancelled':'Placed'}`;const p=document.createElement('p');p.style.cssText='margin:5px 0 0;color:var(--service-muted)';p.textContent=`${(order.items||[]).reduce((n,i)=>n+(Number(i.qty)||0),0)} item(s) · ${money(order.total)} · ${order.time||''}`;host.append(h,p);
  }
  async function trackCustomerOrder(id){
    const host=$s('customerTrackResult');if(!sharedServiceActive){showTrackedOrder(orders.find(o=>String(o.id)===String(id)));return}
    host.textContent='Checking the latest status…';try{const result=await apiFetch('/api/orders/'+encodeURIComponent(id)+'/status');const o=result.order;if(!o){showTrackedOrder(null);return}host.innerHTML='';const h=document.createElement('strong');const st=o.status==='done'?'Completed':o.status==='preparing'?'Preparing':o.status==='cancelled'?'Cancelled':'Placed';h.textContent=`Order #${o.id} · ${st}`;const p=document.createElement('p');p.style.cssText='margin:5px 0 0;color:var(--service-muted)';p.textContent=`${o.itemCount} item(s) · ${money(o.total)} · ${o.time||''}`;host.append(h,p)}catch(_){host.textContent='Could not fetch status right now. Check the order number and try again.'}
  }
  function cancelServiceOrder(id){const order=getOrder(id);if(!order||['done','cancelled'].includes(orderStatus(order))){showServiceToast('This order can no longer be cancelled here');return}if(!confirm(`Cancel order #${order.id}?`))return;order.status='cancelled';order.done=false;order.cancelledAt=new Date().toISOString();saveOrders();renderOrders();renderHistory();if(sharedServiceActive&&staffAuthenticated)syncRemoteOrder(order).catch(()=>showServiceToast('Cancelled locally; server sync failed'));if($s('detailDialog')?.open)renderOrderDetail();showServiceToast(`Order #${order.id} cancelled`)}
  function markPaymentReceived(id){const order=getOrder(id);if(!order)return;if(order.paymentStatus==='paid'){showServiceToast('Payment is already marked received');return}if(!confirm(`Confirm you have received ${money(order.total)} for order #${order.id}?`))return;order.paymentStatus='paid';order.paidAt=new Date().toISOString();saveOrders();renderOrders();renderHistory();if(sharedServiceActive&&staffAuthenticated)syncRemoteOrder(order).catch(()=>showServiceToast('Payment marked locally; server sync failed'));renderOrderDetail();showServiceToast('Payment marked received')}

  // Include metadata and an exact total in the existing order-detail sheet.
  const originalDetail=renderOrderDetail;
  renderOrderDetail=function(){
    originalDetail();const host=$s('detailContent'),order=getOrder(detailOrderId);if(!host||!order)return;
    const action=host.querySelector(':scope > .black-btn');if(action){if(orderStatus(order)==='cancelled'){action.textContent='Order cancelled';action.disabled=true}else if(orderStatus(order)==='done'){action.textContent='Reopen order'} }
    const oldContext=host.querySelector('.service-order-context');if(oldContext)oldContext.remove();
    if(order.source==='customer'){
      const box=document.createElement('section');box.className='service-order-context';const h=document.createElement('h4');h.textContent='Customer order';box.append(h);
      const type=order.orderType==='dine-in'?`Dine-in · Table ${order.tableNumber||'—'}`:order.orderType==='delivery'?'Delivery':'Takeaway';
      [[`Customer`,order.customerName||'—'],['Phone',order.phone||'—'],['Fulfilment',type],['Address',order.address||'—'],['Notes',order.notes||'None'],['Payment',`${order.paymentMethod||'—'} · ${order.paymentStatus==='paid'?'Received':'Not yet verified'}`]].forEach(([label,value])=>{if(label==='Address'&&!order.address)return;const p=document.createElement('p');const b=document.createElement('strong');b.textContent=label+': ';p.append(b,document.createTextNode(String(value)));box.append(p)});
      const actions=document.createElement('div');actions.className='service-order-context-actions';
      if(order.paymentStatus!=='paid'){const paid=document.createElement('button');paid.type='button';paid.textContent='Mark payment received';paid.onclick=()=>markPaymentReceived(order.id);actions.append(paid)}
      if(!['done','cancelled'].includes(orderStatus(order))){const cancel=document.createElement('button');cancel.type='button';cancel.className='service-cancel-order';cancel.textContent='Cancel order';cancel.onclick=()=>cancelServiceOrder(order.id);actions.append(cancel)}
      if(actions.children.length)box.append(actions);
      const head=host.querySelector(':scope > .dialog-head');if(head)head.insertAdjacentElement('afterend',box);else host.prepend(box);
    }
    const summary=host.querySelector('.detail-summary');if(summary){summary.innerHTML='';const subtotal=Number(order.subtotal??(order.items||[]).reduce((sum,i)=>sum+(Number(i.qty)||0)*(Number(i.rate)||0),0));const tax=Number(order.taxAmount)||0,delivery=Number(order.deliveryFee)||0;
      const row=(label,value,grand=false)=>{const d=document.createElement('div');d.className='summary-row'+(grand?' total':'');const l=document.createElement('span');l.textContent=label;const v=document.createElement('strong');v.textContent=money(value);d.append(l,v);summary.append(d)};
      row(`Items (${(order.items||[]).reduce((n,i)=>n+(Number(i.qty)||0),0)})`,subtotal);if(tax)row('Tax',tax);if(delivery)row('Delivery fee',delivery);row('Total',Number(order.total)||subtotal+tax+delivery,true);
    }
    if(sharedServiceActive&&staffAuthenticated){
      host.querySelectorAll('.detail-item-controls button,.detail-remove').forEach(button=>{if(button.dataset.remoteSyncWrapped)return;const original=button.onclick;if(typeof original!=='function')return;button.dataset.remoteSyncWrapped='1';button.onclick=function(event){original.call(this,event);setTimeout(()=>{const updated=getOrder(order.id);if(updated)syncRemoteOrder(updated,true).catch(()=>showServiceToast('Order edit was not synced'));else apiFetch('/api/orders/'+encodeURIComponent(order.id),{method:'DELETE'}).catch(()=>showServiceToast('Order deletion was not synced'))},50)}})
    }
  };

  // Preserve the existing card layout but label incoming customer orders.
  const oldCard=renderOrderCard;
  renderOrderCard=function(order){const card=oldCard(order);if(order.source==='customer'){
    const meta=card.querySelector('.order-meta');if(meta){const who=document.createElement('div');who.className='order-count';who.style.marginTop='4px';who.textContent=`${order.customerName||'Customer'} · ${order.orderType==='dine-in'?`Table ${order.tableNumber||'—'}`:order.orderType==='delivery'?'Delivery':'Takeaway'}`;meta.append(who)}
    const state=card.querySelector('.state-action');if(orderStatus(order)==='cancelled'&&state){state.textContent='Cancelled';state.disabled=true}
  }return card};

  // Status support for cancelled orders, without removing the original transitions.
  orderStatus=function(order){const raw=String(order&&(order.status||(order.done?'done':'pending'))||'pending').toLowerCase();if(['cancelled','canceled','void'].includes(raw))return'cancelled';if(['done','completed','complete','finished'].includes(raw)||order?.done===true)return'done';if(['preparing','in_progress','in-progress'].includes(raw))return'preparing';return'pending'};
  statusPill=function(status){const st=String(status||'pending');const b=document.createElement('span');b.className='status '+(st==='done'?'done':st==='preparing'?'preparing':st==='cancelled'?'cancelled':'pending');b.textContent=st==='done'?'Completed':st==='preparing'?'Preparing':st==='cancelled'?'Cancelled':'Placed';return b};
  orderMatchesFilter=function(order,filter){const st=orderStatus(order);if(!filter||filter==='all')return true;if(['completed','done'].includes(filter))return st==='done';if(['placed','pending'].includes(filter))return st==='pending';return st===filter};
  advanceStatus=function(id){const order=getOrder(id);if(!order)return;const current=orderStatus(order);if(current==='cancelled'){showServiceToast('Cancelled orders cannot be reopened from the quick action');return}order.status=current==='pending'?'preparing':current==='preparing'?'done':'pending';order.done=order.status==='done';if(!order.createdAt)order.createdAt=new Date().toISOString();recalcOrder(order);saveOrders();renderOrders();renderHistory();if(sharedServiceActive&&staffAuthenticated)syncRemoteOrder(order).catch(()=>showServiceToast('Status changed locally; server sync failed'));if(detailOrderId!=null&&String(detailOrderId)===String(order.id)&&$s('detailDialog').open)renderOrderDetail();showServiceToast(order.status==='done'?'Order marked completed':order.status==='preparing'?'Order moved to preparing':'Order reopened')};

  // Keep service fees separate from item subtotal when orders are edited or advanced.
  const oldRecalc=recalcOrder;
  recalcOrder=function(order){const subtotal=(order.items||[]).reduce((sum,i)=>sum+(Number(i.qty)||0)*(Number(i.rate)||0),0);order.subtotal=subtotal;let tax=Number(order.taxAmount)||0;if(order.taxPercent!==undefined&&Number.isFinite(Number(order.taxPercent)))tax=Math.round(subtotal*(Number(order.taxPercent)||0))/100;order.taxAmount=tax;const fee=Number(order.deliveryFee)||0;order.total=Math.round((subtotal+tax+fee)*100)/100;order.done=order.status==='done';return order};
  const oldAddOrder=addOrderItems;
  addOrderItems=function(items){const order=oldAddOrder(items);if(order&&!order.createdAt){order.createdAt=new Date().toISOString();saveOrders();try{renderHistory()}catch(_){}}return order};
  const oldHistory=renderHistory;
  renderHistory=function(){oldHistory();const today=new Date().toDateString();const count=orders.filter(o=>{if(!o.createdAt)return false;const d=new Date(o.createdAt);return !Number.isNaN(d.getTime())&&d.toDateString()===today}).length;safeText($s('todayCount'),count);const completed=orders.filter(o=>orderStatus(o)==='done').reduce((sum,o)=>sum+(Number(o.total)||0),0);safeText($s('completedTotal'),money(completed))};
  const oldRenderOrders=renderOrders;
  renderOrders=function(){oldRenderOrders();const open=orders.filter(o=>!['done','cancelled'].includes(orderStatus(o))).length;const badge=$s('activeCount');if(badge){safeText(badge,open+' Open');badge.className='status '+(open?'pending':'done')}};

  function exportFullBackup(){
    const data={app:'Charlie Chaap Service Ready',version:1,exportedAt:new Date().toISOString(),storage:{}};
    BACKUP_KEYS.forEach(key=>{try{const value=localStorage.getItem(key);if(value!==null)data.storage[key]=value}catch(_){}});
    const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`charlie-chaap-backup-${new Date().toISOString().slice(0,10)}.json`;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);showServiceToast('Full backup exported');
  }
  function importFullBackup(file){
    if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const data=JSON.parse(String(reader.result||''));if(!data||data.app!=='Charlie Chaap Service Ready'||!data.storage||typeof data.storage!=='object')throw new Error('invalid');
      const ordersRaw=data.storage['charlie-orders-v1'];if(ordersRaw){const parsed=JSON.parse(ordersRaw);if(!Array.isArray(parsed))throw new Error('orders')}if(!confirm('Restore this backup? Current local orders and menu settings will be replaced. Export a backup first if needed.'))return;
      BACKUP_KEYS.forEach(key=>{try{if(Object.prototype.hasOwnProperty.call(data.storage,key))localStorage.setItem(key,data.storage[key]);else localStorage.removeItem(key)}catch(_){}});alert('Backup restored. The app will reload to apply all saved menu and order data.');location.reload();
    }catch(_){showServiceToast('That backup file is invalid or unsupported')}};reader.onerror=()=>showServiceToast('Could not read the backup file');reader.readAsText(file);
  }
  function copyCustomerLink(){
  if(location.protocol==='file:'){showServiceToast('Host this HTML on the server first; a file:// link cannot be shared with customers');return}
  const finish=(link)=>{
    if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(link).then(()=>showServiceToast('Customer link copied')).catch(()=>prompt('Copy this customer link:',link))}
    else prompt('Copy this customer link:',link);
  };
  let link=new URL('/customer', location.origin).toString();
  fetch('/api/health',{cache:'no-store'}).then(r=>r.json()).then(h=>{
    const ip=Array.isArray(h.addresses)&&h.addresses.length?h.addresses[0]:null;
    const port=h.port||location.port||'3000';
    if(ip) link='http://'+ip+':'+port+'/customer';
    finish(link);
  }).catch(()=>finish(link));
}
function applyServiceSettingsToUI(){if($s('serviceTaxRate'))$s('serviceTaxRate').value=Number(serviceConfig.taxPercent)||0;if($s('serviceDeliveryFee'))$s('serviceDeliveryFee').value=Number(serviceConfig.deliveryFee)||0;updateCustomerOpenState()}

  // Shared backend mode: activated automatically when served by the included Node.js server.
  async function apiFetch(path,options={}){
    const opts={method:options.method||'GET',credentials:'same-origin',cache:'no-store',headers:{...(options.body?{'Content-Type':'application/json'}:{}),...(options.headers||{})},...options};
    const response=await fetch(path,opts);let data={};try{data=await response.json()}catch(_){throw new Error('The service server returned an unreadable response')}
    if(!response.ok)throw new Error(data.error||`Service request failed (${response.status})`);return data;
  }
  function setConnectionLabel(title,description,state='offline'){
    safeText($s('serviceAuthTitle'),title);safeText($s('serviceAuthDescription'),description);const dot=$s('serviceAuthIndicator');if(dot)dot.className='service-auth-indicator '+state;
  }
  function updateStaffAuthUI(){window.__ccStaff=!!staffAuthenticated;
    const password=$s('serviceAdminPassword'),login=$s('serviceStaffLogin'),logout=$s('serviceStaffLogout'),publish=$s('servicePublishMenu');
    const note=document.querySelector('.service-connection-note');
    if(note){const heading=note.querySelector('strong'),paragraph=note.querySelector('p');if(!sharedServiceActive){if(heading)heading.textContent='Single-browser storage';if(paragraph)paragraph.textContent='Orders and menu changes save in this browser. Public multi-device ordering needs the included shared service server.'}else{if(heading)heading.textContent='Shared server storage';if(paragraph)paragraph.textContent='Orders, menu and service settings sync through the shared server. Use persistent hosting storage and export regular backups.'}}
    if(!sharedServiceActive){setConnectionLabel('Local preview mode','This file is not connected to a server. Orders stay in the current browser; use the included server package for shared customer orders.','offline');if(login)login.hidden=true;if(password)password.parentElement.hidden=true;if(logout)logout.hidden=true;if(publish)publish.disabled=true;return}
    if(login)login.hidden=staffAuthenticated;if(password)password.parentElement.hidden=staffAuthenticated;if(logout)logout.hidden=!staffAuthenticated;if(publish)publish.disabled=!staffAuthenticated;
    if(staffAuthenticated)setConnectionLabel('Shared service connected · Staff signed in','Customer orders and service settings are syncing with the hosted server.','connected');
    else setConnectionLabel('Shared service connected · Staff sign-in required','Customer ordering is connected. Sign in to view orders, change settings and publish the menu.','locked');
  }
  async function pullRemoteMenu(admin=false){
    const result=await apiFetch('/api/menu'+(admin?'?all=1':''));if(!Array.isArray(result.items))throw new Error('Server menu is unavailable');
    const remote=result.items.map(item=>({...item,n:String(item.n||''),c:String(item.c||'Other'),h:item.h==null?null:Number(item.h),f:item.f==null?null:Number(item.f),a:Array.isArray(item.a)?item.a:[],available:item.available!==false,custom:!!item.custom})).filter(item=>item.n);
    menu.splice(0,menu.length,...remote);remoteMenuLoaded=true;
    try{if(admin&&window.ccMenuManagement){remote.forEach(item=>{if(window.ccMenuManagement.isAvailable(item)!==(item.available!==false))window.ccMenuManagement.setMenuAvailability(item.n,item.available!==false)});window.ccMenuManagement.refreshMenuViews()}}catch(_){}
    try{renderMenu()}catch(_){}try{renderEditor()}catch(_){}renderCustomerCategories();renderCustomerMenu();
  }
  function ccNotifyNewOrder(list){
  const first=list[0]||{};
  let wrap=document.getElementById('ccNewOrderBanner');
  if(!wrap){wrap=document.createElement('div');wrap.id='ccNewOrderBanner';document.body.appendChild(wrap);}
  const title=list.length>1?('New orders: '+list.length+' — latest #'+first.id):('New order #'+first.id+(first.tableNumber?(' · Table '+first.tableNumber):''));
  const qty=Array.isArray(first.items)?first.items.reduce((n,i)=>n+(Number(i.qty)||1),0):0;
  const sub=(qty?(qty+' item'+(qty===1?'':'s')+' · '):'')+(first.total!=null?((typeof fmt==='function')?fmt(first.total):'₹'+first.total):'');
  wrap.innerHTML='<span class="cc-nob-dot"></span><div class="cc-nob-text"><strong></strong><small></small></div>';
  wrap.querySelector('strong').textContent=title;
  wrap.querySelector('small').textContent=sub;
  wrap.classList.add('on');
  wrap.onclick=()=>{try{openOrderDetail(first.id);wrap.classList.remove('on')}catch(_){}};
  clearTimeout(window.__ccNobTimer);
  window.__ccNobTimer=setTimeout(()=>wrap.classList.remove('on'),9000);
  try{if(navigator.vibrate)navigator.vibrate(120)}catch(_){}
}
async function pullRemoteOrders(silent=false){
    if(!sharedServiceActive||!staffAuthenticated)return;
    const result=await apiFetch('/api/orders');if(!Array.isArray(result.orders))throw new Error('Server orders are unavailable');
    const ccSeen=window.__ccKnownOrders;
    orders=result.orders;try{saveOrders()}catch(_){}renderOrders();renderHistory();
    try{const ccIds=new Set((result.orders||[]).map(o=>String(o.id)));
      if(ccSeen instanceof Set){const ccFresh=(result.orders||[]).filter(o=>!ccSeen.has(String(o.id))&&!['done','cancelled'].includes(orderStatus(o)));
        if(ccFresh.length)ccNotifyNewOrder(ccFresh);}
      window.__ccKnownOrders=ccIds;}catch(_){}
    if($s('detailDialog')?.open&&detailOrderId!=null&&getOrder(detailOrderId))renderOrderDetail();
    if(!silent)showServiceToast('Orders synced');
  }
  async function syncRemoteOrder(order,includeItems=false){if(!sharedServiceActive||!staffAuthenticated||!order)return;const payload={status:order.status,paymentStatus:order.paymentStatus};if(includeItems)payload.items=(order.items||[]).map(i=>({name:i.name,size:i.size||'h',qty:i.qty}));await apiFetch('/api/orders/'+encodeURIComponent(order.id),{method:'PATCH',body:JSON.stringify(payload)})}
  async function saveRemoteConfig(){if(!sharedServiceActive||!staffAuthenticated)return;await apiFetch('/api/service-config',{method:'PUT',body:JSON.stringify({isOpen:!!serviceConfig.isOpen,taxPercent:Number(serviceConfig.taxPercent)||0,deliveryFee:Number(serviceConfig.deliveryFee)||0})})}
  async function publishCurrentMenu(){
    if(!sharedServiceActive){showServiceToast('Start the included Node.js server to publish a shared menu');return}
    if(!staffAuthenticated){showServiceToast('Sign in as staff before publishing the menu');return}
    const items=menu.map(item=>({n:item.n,c:item.c||'Other',h:item.h==null?null:Number(item.h),f:item.f==null?null:Number(item.f),hLabel:item.hLabel||'',fLabel:item.fLabel||'',a:Array.isArray(item.a)?item.a:[item.n],custom:!!item.custom,available:!!itemAvailable(item),image:item.image||''}));
    const b=$s('servicePublishMenu');b.disabled=true;b.textContent='Publishing…';
    try{await apiFetch('/api/menu',{method:'PUT',body:JSON.stringify({items})});await pullRemoteMenu(true);showServiceToast('Menu published to customer devices')}catch(error){showServiceToast(error.message||'Could not publish the menu')}finally{b.disabled=!staffAuthenticated;b.textContent='Publish current menu to customers'}
  }
  async function startStaffSync(){if(serviceSyncTimer)clearInterval(serviceSyncTimer);await pullRemoteOrders(true).catch(e=>showServiceToast(e.message));serviceSyncTimer=setInterval(()=>{if(sharedServiceActive&&staffAuthenticated)pullRemoteOrders(true).catch(()=>{})},750)}
  async function sendStaffOrder(items,onSuccess,onFailure){
    const payload={items:(items||[]).map(i=>({name:i.name,size:i.size||'h',qty:Math.max(1,Number(i.qty)||1)})),orderType:'takeaway',customerName:'Walk-in',phone:'',notes:''};
    try{const result=await apiFetch('/api/orders/manual',{method:'POST',body:JSON.stringify(payload)});const order=result.order||result;orders=[order,...orders.filter(o=>String(o.id)!==String(order.id))];saveOrders();renderOrders();renderHistory();if(typeof onSuccess==='function')onSuccess(order);showServiceToast(`Order #${order.id} placed and synced`);return order}
    catch(error){showServiceToast(error.message||'Order could not be saved to the shared service');if(typeof onFailure==='function')onFailure(error);return null}
  }
  const offlineCommitComposer=commitComposer;
  commitComposer=function(prefix){
    if(!sharedServiceActive||!staffAuthenticated)return offlineCommitComposer(prefix);
    const entry=$s(prefix+'Entry'),lines=entry.value.split('\n').map(s=>s.trim()).filter(Boolean);if(!lines.length){entry.focus();return}
    const items=[],issues=[];for(const line of lines){const parsed=parseLine(line),chosen=chosenByLine[prefix][line],found=chosen?{item:menu.find(m=>m.n===chosen),score:1}:matchesFor(line)[0];if(!found||!found.item||found.score<.48){issues.push(line+' — choose a dish');continue}const size=parsed.size||'h',rate=rateFor(found.item,size);if(rate==null){issues.push(line+' — price not listed');continue}if(!itemAvailable(found.item)){issues.push(line+' — currently unavailable');continue}items.push({name:found.item.n,qty:parsed.qty,size,rate})}
    if(issues.length){alert('Please check these items before placing the order:\n\n'+issues.join('\n'));return}
    const button=prefix==='home'?$s('homeAdd'):prefix==='take'?$s('takeAdd'):$s('modalAdd');if(button){button.disabled=true;button.textContent='Saving…'}
    sendStaffOrder(items,()=>{entry.value='';chosenByLine[prefix]={};renderComposer(prefix);if(prefix==='modal')$s('quickDialog').close();setTab('orders',false);},()=>{}).finally(()=>{if(button){button.disabled=false;button.textContent=prefix==='home'?'Place order':prefix==='take'?'Place order':'Add'}})
  };
  const offlineAddTakeLines=addTakeLinesToDraft;
  addTakeLinesToDraft=function(){
    if(!sharedServiceActive||!staffAuthenticated)return offlineAddTakeLines();
    const entry=$s('takeEntry'),lines=entry.value.split('\n').map(s=>s.trim()).filter(Boolean);if(!lines.length){entry.focus();return}
    const validated=[],issues=[];for(const line of lines){const parsed=parseLine(line),chosen=chosenByLine.take[line],found=chosen?{item:menu.find(m=>m.n===chosen),score:1}:matchesFor(line)[0];if(!found||!found.item||found.score<.48){issues.push(line+' — choose a dish');continue}const size=parsed.size||'h',rate=rateFor(found.item,size);if(rate==null||!itemAvailable(found.item)){issues.push(line+' — price unavailable');continue}validated.push({name:found.item.n,qty:parsed.qty,size,rate})}
    if(issues.length){alert('Please check these items before placing the order:\n\n'+issues.join('\n'));return}
    const combined=draftItems.map(i=>({...i}));for(const item of validated){const present=combined.find(i=>keyName(i.name)===keyName(item.name)&&i.size===item.size);if(present)present.qty+=item.qty;else combined.push(item)}
    $s('takeAdd').disabled=true;sendStaffOrder(combined,()=>{draftItems=[];saveDraft();entry.value='';chosenByLine.take={};renderComposer('take');renderTakeCart();renderDraftDock();setTab('orders',false)},()=>{}).finally(()=>$s('takeAdd').disabled=false)
  };
  const offlinePlaceDraft=placeDraft;
  placeDraft=function(){
    if(!sharedServiceActive||!staffAuthenticated)return offlinePlaceDraft();if(!draftItems.length)return;
    const items=draftItems.map(i=>({...i})),blocked=items.some(line=>{const item=menu.find(m=>keyName(m.n)===keyName(line.name));return !item||!itemAvailable(item)||rateFor(item,line.size)==null});
    if(blocked){showServiceToast('Remove unavailable items before placing the order');return}
    $s('placeDraft').disabled=true;$s('placeDraft').textContent='Saving…';
    sendStaffOrder(items,()=>{draftItems=[];saveDraft();renderDraftDock();renderTakeCart();$s('draftDialog').close();setTab('orders',false)},()=>{}).finally(()=>{$s('placeDraft').disabled=false;$s('placeDraft').textContent='Place order'})
  };
  // Existing buttons captured earlier function references; rebind to the remote-aware handlers.
  $s('homeAdd').onclick=()=>commitComposer('home');$s('modalAdd').onclick=()=>commitComposer('modal');$s('modalAddBottom').onclick=()=>commitComposer('modal');$s('takeAdd').onclick=addTakeLinesToDraft;$s('placeDraft').onclick=placeDraft;
  async function initializeSharedService(){
    if(!['http:','https:'].includes(location.protocol)){updateStaffAuthUI();return}
    try{
      const healthRes=await fetch('/api/health',{cache:'no-store'});if(!healthRes.ok)return;const health=await healthRes.json();if(health.service!=='Charlie Chaap Service API')return;
      sharedServiceActive=true;window.__ccShared=true;
      const publicData=await apiFetch('/api/public-config');if(publicData.config&&typeof publicData.config==='object')serviceConfig={...defaultConfig,...publicData.config};persistServiceConfig();applyServiceSettingsToUI();
      const session=await apiFetch('/api/auth/session');staffAuthenticated=!!session.authenticated;updateStaffAuthUI();
      await pullRemoteMenu(staffAuthenticated).catch(()=>{});
      try{refreshMenuViews();renderCustomerCategories();renderCustomerMenu();renderCustomerCart();}catch(_){}
      if(customerMode){}
      else if(staffAuthenticated){await startStaffSync()}
      else {orders=[];renderOrders();renderHistory()}
      updateCustomerOpenState();
    }catch(_){/* Static hosting keeps the local-only mode and remains usable. */updateStaffAuthUI()}
  }
  async function staffSignIn(){
    if(!sharedServiceActive){showServiceToast('The server connection is not active. Run the included Node.js service first.');return}
    const password=$s('serviceAdminPassword').value;if(!password){showServiceToast('Enter the staff password');return}
    const button=$s('serviceStaffLogin');button.disabled=true;button.textContent='Signing in…';
    try{await apiFetch('/api/auth/login',{method:'POST',body:JSON.stringify({password})});staffAuthenticated=true;$s('serviceAdminPassword').value='';updateStaffAuthUI();await pullRemoteMenu(true);await startStaffSync();setTab('orders');showServiceToast('Staff sign-in successful')}
    catch(error){showServiceToast(error.message||'Sign-in failed')}
    finally{button.disabled=false;button.textContent='Enter as staff'}
  }
  async function staffSignOut(){try{await apiFetch('/api/auth/logout',{method:'POST',body:'{}'})}catch(_){}staffAuthenticated=false;if(serviceSyncTimer)clearInterval(serviceSyncTimer);serviceSyncTimer=null;orders=[];saveOrders();renderOrders();renderHistory();updateStaffAuthUI();setTab('more');showServiceToast('Signed out')}
  async function exportFullBackupRemote(){const data=await apiFetch('/api/backup');const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`charlie-chaap-server-backup-${new Date().toISOString().slice(0,10)}.json`;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);showServiceToast('Server backup exported')}
  const oldExportBackup=exportFullBackup;
  exportFullBackup=function(){if(sharedServiceActive&&staffAuthenticated){exportFullBackupRemote().catch(e=>showServiceToast(e.message||'Backup failed'));return}oldExportBackup()};
  const oldImportBackup=importFullBackup;
  importFullBackup=function(file){
    if(!file)return;const reader=new FileReader();reader.onload=async()=>{try{const data=JSON.parse(String(reader.result||''));
      if(data&&data.app==='Charlie Chaap Remote Backup'){
        if(!sharedServiceActive||!staffAuthenticated)throw new Error('Sign in to the shared service before restoring its backup');
        if(!confirm('Restore this SERVER backup? This replaces all server menu, order and service data.'))return;
        await apiFetch('/api/backup/restore',{method:'POST',body:JSON.stringify({data:data.data})});await pullRemoteMenu(true);await pullRemoteOrders(true);const pub=await apiFetch('/api/public-config');serviceConfig={...defaultConfig,...pub.config};applyServiceSettingsToUI();showServiceToast('Server backup restored');return;
      }
      oldImportBackup(file);
    }catch(error){showServiceToast(error.message||'That backup file is invalid or unsupported')}};reader.onerror=()=>showServiceToast('Could not read the backup file');reader.readAsText(file);
  };
  $s('serviceStaffLogin').onclick=staffSignIn;$s('serviceStaffLogout').onclick=staffSignOut;$s('servicePublishMenu').onclick=publishCurrentMenu;
  const baseSetTabForService=setTab;
  setTab=function(tab,scroll=true){
    if(sharedServiceActive&&!customerMode&&!staffAuthenticated&&['orders','history','menuEditor'].includes(tab)){showServiceToast('Staff sign-in required to access live orders and menu management');baseSetTabForService('more',scroll);return}
    baseSetTabForService(tab,scroll);
    if(tab==='customer'){renderCustomerCategories();renderCustomerMenu();renderCustomerCart()}
  };

  // Wire customer experience.
  $s('customerSearch').addEventListener('input',renderCustomerMenu);
  $s('customerBack').onclick=()=>setTab('home');
  $s('customerTrackOpen').onclick=()=>{$s('customerTrackResult').innerHTML='';$s('customerTrackId').value=lastCustomerOrderId==null?'':String(lastCustomerOrderId);$s('customerTrackDialog').showModal()};
  $s('customerCheckoutForm').addEventListener('submit',submitCustomerOrder);
  $s('customerOrderType').addEventListener('change',updateCheckoutOrderType);
  $s('customerPlaceOrder').disabled=false;
  $s('customerContinueShopping').onclick=()=>{$s('customerCheckoutDialog').close();setTab('customer')};
  $s('customerPrintReceipt').onclick=()=>{document.body.classList.add('print-customer-receipt');window.print();setTimeout(()=>document.body.classList.remove('print-customer-receipt'),600)};
  $s('customerTrackForm').addEventListener('submit',event=>{event.preventDefault();const id=$s('customerTrackId').value.trim();trackCustomerOrder(id)});
  document.querySelectorAll('[data-service-close]').forEach(btn=>btn.addEventListener('click',()=>{$s(btn.dataset.serviceClose)?.close()}));
  $s('toggleBusinessOpen').onclick=()=>{if(sharedServiceActive&&!staffAuthenticated){showServiceToast('Sign in as staff to change live service settings');return}const previous=!!serviceConfig.isOpen;serviceConfig.isOpen=!serviceConfig.isOpen;persistServiceConfig();updateCustomerOpenState();if(sharedServiceActive&&staffAuthenticated)saveRemoteConfig().catch(()=>{serviceConfig.isOpen=previous;persistServiceConfig();updateCustomerOpenState();showServiceToast('Could not update the live service setting')});showServiceToast(serviceConfig.isOpen?'Accepting new orders':'New orders paused')};
  const saveFees=()=>{if(sharedServiceActive&&!staffAuthenticated){showServiceToast('Sign in as staff to change live checkout fees');applyServiceSettingsToUI();return}const tax=Number($s('serviceTaxRate').value),fee=Number($s('serviceDeliveryFee').value);if(!Number.isFinite(tax)||tax<0||tax>100||!Number.isFinite(fee)||fee<0||fee>100000){showServiceToast('Enter valid tax (0–100%) and delivery fee');applyServiceSettingsToUI();return}const prev={...serviceConfig};serviceConfig.taxPercent=tax;serviceConfig.deliveryFee=fee;persistServiceConfig();renderCheckoutLines();if(sharedServiceActive&&staffAuthenticated)saveRemoteConfig().then(()=>showServiceToast('Live checkout settings saved')).catch(()=>{serviceConfig=prev;persistServiceConfig();applyServiceSettingsToUI();showServiceToast('Could not update live fees')});else showServiceToast('Checkout settings saved')};
  $s('serviceTaxRate').addEventListener('change',saveFees);$s('serviceDeliveryFee').addEventListener('change',saveFees);
  $s('openCustomerPreview').onclick=()=>setTab('customer');$s('copyCustomerLink').onclick=copyCustomerLink;
  $s('downloadServiceBackup').onclick=exportFullBackup;$s('restoreServiceBackup').onclick=()=>$s('serviceBackupFile').click();$s('serviceBackupFile').addEventListener('change',e=>{importFullBackup(e.target.files&&e.target.files[0]);e.target.value=''});
  const oldExport=exportOrders;
  exportOrders=function(){
    if(!orders.length){showServiceToast('No orders to export');return}
    const rows=[['Order','Status','Created At','Time','Source','Customer','Phone','Order Type','Table','Address','Items','Subtotal','Tax','Delivery Fee','Total','Payment Method','Payment Status','Notes'],...orders.map(o=>[o.id,orderStatus(o),o.createdAt||'',o.time||'',o.source||'staff',o.customerName||'',o.phone||'',o.orderType||'',o.tableNumber||'',o.address||'',(o.items||[]).map(i=>`${i.qty}x ${i.name} (${i.sizeLabel||(i.size==='f'?'Full':'Half')})`).join('; '),o.subtotal??(o.items||[]).reduce((v,i)=>v+i.qty*i.rate,0),o.taxAmount||0,o.deliveryFee||0,o.total,o.paymentMethod||'',o.paymentStatus||'',o.notes||''])];
    const csv=rows.map(row=>row.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(',')).join('\r\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='charlie-chaap-orders.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);showServiceToast('Orders exported with customer and payment details')
  };
  // Route existing order entry buttons to the customer checkout flow; staff order desk remains under Orders.
  $s('homeStartOrder').onclick=()=>setTab('customer');
  ['landingAboutOrder','landingReviewOrder','landingFooterOrder'].forEach(id=>{const el=$s(id);if(el)el.onclick=()=>setTab('customer')});
  // Tag cards from customer ordering source after the base card is created; see the order detail for receipt metadata.
  applyServiceSettingsToUI();renderCustomerCategories();renderCustomerMenu();renderCustomerCart();
  if(customerMode){document.body.classList.add('customer-mode');setTab('customer',false);$s('customerBack').hidden=true;document.title='Order Online · Charlie Chaap'}
  else{document.body.classList.remove('customer-mode')}
  updateStaffAuthUI();initializeSharedService();
  if(!customerMode){try{setTab('orders',false)}catch(e){}}
  // Keep cart totals and availability fresh if staff modifies the menu or tab focus returns.
  document.addEventListener('visibilitychange',()=>{if(!document.hidden){renderCustomerCart();renderCustomerMenu();updateCustomerOpenState()}});
})();
</script>

</body></html>