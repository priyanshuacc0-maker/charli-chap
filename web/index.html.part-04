{n:"Kurkure Spring Roll",c:"Chinese",h:80,f:150,a:["kurkure spring roll"]},
{n:"Kabab",c:"Chinese",h:60,f:120,a:["kabab","kebab"]},
{n:"Hara Bhara Kabab",c:"Chinese",h:70,f:130,a:["hara bhara kabab","hara bhara kebab"]},
