{n:"Hakka Noodles",c:"Chinese",h:90,f:170,a:["hakka noodles","haka noodles"]},
{n:"Singapore Noodles",c:"Chinese",h:90,f:170,a:["singapore noodles","singapuri noodles"]},
{n:"Manchurian",c:"Chinese",h:100,f:180,a:["manchurian","manchurian dry"]},
