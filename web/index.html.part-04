const CUSTOM_MENU_KEY="charlie-custom-menu-v1";
function loadCustomMenu(){try{const extra=JSON.parse(localStorage.getItem(CUSTOM_MENU_KEY)||"[]");if(Array.isArray(extra))extra.forEach(x=>{if(x&&x.n&&!menu.some(m=>m.n.toLowerCase()===String(x.n).toLowerCase()))menu.push(x)})}catch(e){}}
loadCustomMenu();
