")}
 .premium-restaurant-hero:before{inset:8px;border-radius:17px}
 .premium-hero-copy h1{font-size:clamp(47px,13vw,68px);letter-spacing:-1.8px}
 .premium-hero-copy>p{max-width:310px;font-size:14px}
 .premium-restaurant-hero .home-actions{flex-direction:column;align-items:stretch;max-width:340px}
 .premium-restaurant-hero .home-primary,.premium-restaurant-hero .home-secondary{width:100%;min-width:0}
 .hero-image-caption{display:none}
}


.menu-page-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.custom-menu-trigger{min-height:42px;padding:0 14px;white-space:nowrap;font-size:13px}.custom-label{display:block;margin:13px 0 7px;font-size:13px;font-weight:700;color:var(--muted,#777)}.custom-price-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.custom-help,.dialog-sub{font-size:12px;line-height:1.5;color:var(--muted,#777);margin:10px 0}.custom-save{width:100%;justify-content:center;margin-top:12px;min-height:48px}.custom-price-grid input,.custom-item-form input{width:100%;box-sizing:border-box}

/* Editorial restaurant landing page inspired by the supplied fine-dining layout */
.landing-content{padding:clamp(22px,4vw,46px) 0 8px;color:#242019}
.landing-section{padding:clamp(18px,3vw,34px) 0 42px}
.landing-section-head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:22px}
.landing-eyebrow{display:block;font-size:9px;letter-spacing:2px;font-weight:850;color:#9b7040;margin-bottom:10px}
.landing-section h2,.landing-about h2,.landing-story-card h2{font-family:Georgia,'Times New Roman',serif;font-weight:500;letter-spacing:-.8px;font-size:clamp(26px,4vw,42px);line-height:1.05;margin:0 0 10px;color:#282117}
.landing-section-head p,.landing-about-copy p,.landing-story-card p{color:#756d61;line-height:1.65;margin:0;max-width:480px;font-size:13px}
.landing-link,.landing-text-link{background:transparent;color:#30271c;font-weight:750;padding:10px 0;white-space:nowrap;border-bottom:1px solid #c6b89f}
.landing-food-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}
.landing-food-card{min-width:0;border:1px solid #e9e0d3;border-radius:19px;overflow:hidden;background:#fffdf8;box-shadow:0 12px 28px rgba(49,35,17,.055)}
.landing-food-image{height:clamp(130px,20vw,230px);background-color:#e8dfd0;background-size:cover;background-position:center}
.landing-food-one{background-image:linear-gradient(135deg,#7b4b2a,#d8ad78)}
.landing-food-two{background-image:linear-gradient(135deg,#7c3325,#e2a46a)}
.landing-food-three{background-image:linear-gradient(135deg,#385744,#b7a16b)}
.landing-food-copy{padding:17px 17px 19px}.landing-food-copy span{font-size:8px;letter-spacing:1.4px;font-weight:850;color:#a27b4a}.landing-food-copy h3{font-family:Georgia,'Times New Roman',serif;font-weight:500;font-size:clamp(17px,2vw,23px);margin:8px 0 5px;color:#2a2118}.landing-food-copy p{margin:0;color:#81766a;font-size:12px;line-height:1.5}
.landing-about{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(22px,5vw,62px);align-items:center;margin:4px 0 44px;padding:clamp(16px,2vw,24px);background:#eae2d4;border-radius:25px}
.landing-about-image{min-height:310px;height:100%;border-radius:18px;background:#222 url("data:image/jpeg;base64,") center/cover no-repeat;position:relative;overflow:hidden}
.landing-about-image:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.14),transparent 60%)}
.landing-about-copy{padding:14px 6px}.landing-about-copy h2{font-size:clamp(32px,5vw,53px);margin-bottom:16px}.landing-about-copy h2 em{color:#9b6d3e;font-weight:400}.landing-dark-btn{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;margin-top:22px;background:#211b15;color:#fff;border-radius:999px;padding:13px 18px;font-weight:750;font-size:12px}
.landing-story-row{display:grid;grid-template-columns:1fr 1.12fr 1fr;gap:14px;margin-bottom:38px}.landing-story-card{min-height:220px;border-radius:20px;overflow:hidden;background:#f0e9de;border:1px solid #e5dbcc;padding:22px;position:relative}.landing-story-text{display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.landing-story-card h2{font-size:clamp(23px,3vw,32px)}.landing-text-link{margin-top:16px;font-size:12px}.landing-gallery-card{padding:0;background:#211b15;color:#fff;display:flex;flex-direction:column;justify-content:flex-end}.landing-gallery-photo{position:absolute;inset:0;background:linear-gradient(135deg,#30251c,#8b5b36 55%,#c79d67)}.landing-gallery-card>div:last-child{position:relative;padding:22px}.landing-gallery-card .landing-eyebrow{color:#e3c18d}.landing-gallery-card h3{font-family:Georgia,'Times New Roman',serif;font-size:24px;font-weight:500;margin:0;line-height:1.1}.landing-review-card{background:#f7f3eb}.landing-review-mark{font-family:Georgia,serif;font-size:54px;color:#ba8c51;line-height:.8;margin-bottom:14px}.landing-review-card h2{font-size:clamp(22px,2.6vw,29px)}.landing-review-card p{font-size:12px}.landing-review-card .landing-dark-btn{margin-top:14px}
.landing-footer{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:25px 5px 12px;border-top:1px solid #e4dbce}.landing-footer-brand{display:flex;align-items:center;gap:12px}.landing-footer-mark{width:43px;height:43px;border:1px solid #b9a88e;border-radius:50%;display:grid;place-items:center;font-family:Georgia,serif;font-weight:bold;color:#8d6334}.landing-footer-brand strong{font-size:11px;letter-spacing:1.8px}.landing-footer-brand p{font-size:11px;color:#83786a;margin:3px 0 0}.landing-footer-links{display:flex;align-items:center;gap:20px}.landing-footer-links button{background:transparent;color:#443a2e;font-size:11px;font-weight:700}.landing-footer-links span{font-size:10px;color:#8b8174}
@media(max-width:680px){.landing-content{padding-top:10px}.landing-section-head{align-items:flex-start;flex-direction:column}.landing-food-grid{grid-template-columns:1fr;gap:12px}.landing-food-card{display:grid;grid-template-columns:42% 1fr;align-items:stretch}.landing-food-image{height:100%;min-height:142px}.landing-food-copy{padding:15px 13px;align-self:center}.landing-about{grid-template-columns:1fr;gap:15px;padding:12px;border-radius:20px}.landing-about-image{min-height:210px;max-height:250px}.landing-about-copy{padding:14px 8px 18px}.landing-story-row{grid-template-columns:1fr;gap:12px}.landing-story-card{min-height:180px}.landing-gallery-card{min-height:210px}.landing-footer{align-items:flex-start;flex-direction:column}.landing-footer-links{flex-wrap:wrap;gap:14px}}

</style>
<style id="responsive-polish">

/* Responsive refinement: editorial home + full order desk */
:root{--cc-page-gutter:clamp(12px,3.2vw,34px);--cc-content-max:1440px}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{min-width:320px;overflow-x:hidden}
img,svg,video,canvas{max-width:100%}
button,input,textarea,select{font:inherit}
button{touch-action:manipulation}
.app{width:min(100%,var(--cc-content-max));margin-inline:auto;box-sizing:border-box}
.app *{box-sizing:border-box}
.view{min-width:0;width:100%}
.view.active{overflow-wrap:anywhere}
.home-grid{grid-template-columns:minmax(0,1fr)}
.premium-restaurant-hero{width:100%;min-height:clamp(520px,calc(100svh - 125px),790px);min-height:clamp(520px,calc(100dvh - 125px),790px);padding:clamp(18px,3.5vw,46px);border-radius:clamp(18px,2.8vw,32px);gap:clamp(18px,3vw,34px)}
.premium-hero-copy{width:min(100%,760px)}
.premium-hero-copy h1{font-size:clamp(2.35rem,6.3vw,6rem);line-height:.98;letter-spacing:-.045em;text-wrap:balance}
.premium-hero-copy p,.premium-hero-copy .hero-description{max-width:46ch;font-size:clamp(.95rem,1.3vw,1.12rem);line-height:1.65}
.home-actions{display:flex;flex-direction:row;flex-wrap:wrap;gap:10px;max-width:100%}
.home-primary,.home-secondary{min-height:48px;min-width:0}
/* Keep hero overlays readable on narrow phones */
@media(max-width:600px){
  .app{padding-left:12px;padding-right:12px;padding-bottom:calc(100px + env(safe-area-inset-bottom,0px))}
  .topbar{margin-inline:-12px;padding:10px 12px 12px;grid-template-columns:40px minmax(0,1fr) 40px;gap:6px}
  .brand-name{font-size:clamp(12px,3.5vw,16px);letter-spacing:.07em}
  .brand-sub{font-size:8px;letter-spacing:.06em}
  .round-action{width:40px;height:40px;min-width:40px}
  .premium-restaurant-hero{min-height:clamp(540px,calc(100svh - 145px),720px);min-height:clamp(540px,calc(100dvh - 145px),720px);padding:20px 17px;border-radius:22px;gap:22px;background-position:center}
  .hero-topline{font-size:9px;letter-spacing:.12em;gap:7px;flex-wrap:wrap}
  .premium-hero-copy{margin:auto 0;max-width:100%}
  .premium-hero-copy .home-kicker{font-size:9px;letter-spacing:1.7px;margin-bottom:12px}
  .premium-hero-copy h1{font-size:clamp(2.65rem,12vw,4.4rem);line-height:.98;margin:0 0 16px;letter-spacing:-.05em}
  .premium-hero-copy p,.premium-hero-copy .hero-description{font-size:15px;line-height:1.55;max-width:34ch}
  .home-actions{flex-direction:column;align-items:stretch;width:100%}
  .home-actions>*{width:100%;justify-content:space-between}
  .home-feature{margin-top:18px;padding-top:14px;gap:10px}
  .home-feature strong{font-size:14px;line-height:1.35}
  .section-head{gap:10px;align-items:flex-start;flex-wrap:wrap}
  .section-title{font-size:clamp(18px,5vw,23px)}
  .popular-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .food-card{min-width:0}
  .food-name,.menu-name{overflow-wrap:anywhere}
  .menu-row{gap:10px}
  .menu-thumb{width:68px;height:68px;flex:0 0 68px;object-fit:cover}
  .menu-prices{display:flex;flex-wrap:wrap;gap:6px}
  .menu-price-btn{max-width:100%;white-space:normal}
  .order-panel,.quick-card,.order-entry-card{min-width:0}
  .quick-row{gap:8px}
  .quick-entry{min-width:0;width:100%;font-size:16px}
  .black-btn{flex:0 0 auto;padding-inline:12px}
  .filter-group,.category-row{max-width:100%;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none}
  .filter-group::-webkit-scrollbar,.category-row::-webkit-scrollbar{display:none}
  .filter-btn,.category-pill{flex:0 0 auto}
  .dialog,.modal,.editor-panel{max-width:calc(100vw - 24px)}
  input,select,textarea{max-width:100%;font-size:16px}
}
@media(min-width:601px) and (max-width:900px){
  .app{padding-inline:20px}
  .premium-restaurant-hero{min-height:clamp(580px,calc(100svh - 140px),760px);padding:clamp(24px,4vw,38px)}
  .premium-hero-copy h1{font-size:clamp(3.4rem,8vw,5rem)}
  .popular-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
}
@media(min-width:901px){
  .app{padding-inline:clamp(24px,3vw,44px)}
  .premium-restaurant-hero{min-height:min(760px,calc(100svh - 145px));padding:clamp(34px,4vw,60px)}
  .home-grid{grid-template-columns:minmax(0,1.4fr) minmax(340px,.9fr);align-items:start}
  .popular-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(min-width:1200px){
  .app{padding-inline:36px}
  .home-grid{grid-template-columns:minmax(0,1.45fr) minmax(370px,.85fr);gap:24px}
  .popular-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
}
@media(orientation:landscape) and (max-height:520px){
  .premium-restaurant-hero{min-height:480px;gap:14px;padding:18px 24px}
  .premium-hero-copy h1{font-size:clamp(2.5rem,7vh,4rem)}
  .premium-hero-copy .home-kicker{margin-bottom:8px}
  .premium-hero-copy p,.premium-hero-copy .hero-description{font-size:14px}
  .app{padding-bottom:80px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}

</style>

<style id="service-ready-style">
  :root{--service-ink:var(--ink,#171717);--service-muted:var(--muted,#858585);--service-line:var(--line,#ededeb);--service-paper:var(--paper,#fff);--service-soft:var(--soft,#f5f5f3);--service-accent:var(--gold,#c5a15a)}
  #customerView{padding-bottom:30px}
  .customer-head{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px;padding:13px 0 18px}
  .customer-back,.customer-track-trigger{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:0 12px;border-radius:13px;border:1px solid var(--service-line);background:var(--service-paper);color:var(--service-ink);font-size:11px;font-weight:850;white-space:nowrap}
  .customer-eyebrow,.service-settings-kicker{font-size:9px;letter-spacing:1.5px;font-weight:900;color:var(--service-accent);text-transform:uppercase}
  .customer-head h1{font-size:clamp(22px,4.8vw,34px);line-height:1.05;letter-spacing:-1.2px;margin:6px 0 5px;font-weight:900}
  .customer-head p{font-size:11px;color:var(--service-muted);margin:0;line-height:1.4}
  .customer-open-state{display:flex;align-items:center;gap:7px;margin-bottom:14px;padding:11px 13px;border:1px solid var(--service-line);border-radius:13px;background:var(--service-paper);font-size:11px;font-weight:850}
  .customer-open-dot{width:8px;height:8px;border-radius:50%;background:#26935f;box-shadow:0 0 0 3px #26935f1a;flex:0 0 auto}
  .customer-open-state.is-closed .customer-open-dot{background:#d24a43;box-shadow:0 0 0 3px #d24a431a}
  .customer-open-note{font-size:10px;font-weight:600;color:var(--service-muted);margin-left:auto}
  .customer-search{display:flex;align-items:center;gap:10px;min-height:49px;padding:0 14px;border-radius:15px;background:var(--service-paper);border:1px solid var(--service-line);box-shadow:var(--shadow,none);margin-bottom:13px}
  .customer-search svg{width:19px;height:19px;stroke:var(--service-muted);fill:none;stroke-width:2;flex:0 0 auto}
  .customer-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--service-ink);font-size:13px}
  .customer-category-strip{display:flex;gap:7px;overflow:auto;padding:1px 1px 12px;margin-bottom:6px;scrollbar-width:none}.customer-category-strip::-webkit-scrollbar{display:none}
  .customer-category{flex:0 0 auto;min-height:34px;border-radius:100px;padding:0 14px;border:1px solid var(--service-line);background:var(--service-paper);color:var(--service-muted);font-size:10px;font-weight:850}
  .customer-category.active{background:var(--black,#111);border-color:var(--black,#111);color:#fff}
  .customer-menu-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 1px 13px}
  .customer-menu-heading h2{font-size:19px;letter-spacing:-.4px;margin:0;font-weight:900}.customer-menu-heading p{font-size:10px;color:var(--service-muted);margin:4px 0 0}
  .customer-menu-badge{border:1px solid var(--service-line);border-radius:100px;padding:6px 9px;font-size:8px;letter-spacing:1.2px;font-weight:900;color:var(--service-muted)}
  .customer-product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .customer-product-card{min-width:0;overflow:hidden;background:var(--service-paper);border:1px solid var(--service-line);border-radius:17px;box-shadow:var(--shadow,none);display:flex;flex-direction:column}
  .customer-product-photo{width:100%;aspect-ratio:1.24;object-fit:cover;background:var(--service-soft);display:block}
  .customer-product-body{padding:10px;display:flex;flex-direction:column;gap:5px;flex:1}
  .customer-product-category{font-size:8px;letter-spacing:.7px;text-transform:uppercase;color:var(--service-muted);font-weight:900}
  .customer-product-name{font-size:12px;line-height:1.3;font-weight:900;overflow-wrap:anywhere;margin:0}
  .customer-product-options{display:grid;grid-template-columns:1fr;gap:6px;margin-top:auto;padding-top:5px}
  .customer-add-option{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0;min-height:36px;padding:7px 9px;border-radius:10px;background:var(--service-soft);border:1px solid var(--service-line);color:var(--service-ink);font-size:10px;font-weight:850;text-align:left}
  .customer-add-option strong{font-size:11px;white-space:nowrap}.customer-add-option span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--service-muted);font-size:9px}
  .customer-add-option:disabled{opacity:.4;text-decoration:line-through}.customer-product-unavailable .customer-product-photo{filter:grayscale(.6);opacity:.65}
  .customer-product-unavailable:after{content:'SOLD OUT';font-size:8px;letter-spacing:1px;font-weight:900;color:#a33;text-align:center;padding:0 0 9px}
  .customer-help-note{margin-top:15px;padding:13px 14px;border:1px solid var(--service-line);border-radius:14px;display:grid;gap:4px;background:var(--service-paper)}.customer-help-note strong{font-size:11px}.customer-help-note span{font-size:10px;color:var(--service-muted);line-height:1.5}
  .customer-cart-dock{position:fixed;z-index:24;left:50%;transform:translateX(-50%);bottom:calc(80px + env(safe-area-inset-bottom));width:min(650px,calc(100% - 24px));display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 11px 10px 15px;border:1px solid #ffffff1f;border-radius:17px;background:#171717;color:#fff;box-shadow:0 15px 38px #0002}
  .customer-cart-dock[hidden]{display:none!important}.customer-cart-info{display:grid;gap:2px;min-width:0}.customer-cart-info strong{font-size:12px}.customer-cart-info span{font-size:10px;color:#c2c2c2}.customer-cart-checkout{min-height:43px;padding:0 17px;border-radius:12px;background:#fff;color:#111;font-size:11px;font-weight:900;white-space:nowrap}
  body.customer-mode .customer-cart-dock{bottom:calc(12px + env(safe-area-inset-bottom))}body.customer-mode .bottom-wrap,body.customer-mode #draftDock,body.customer-mode #takeDock{display:none!important}body.customer-mode #app{padding-bottom:calc(95px + env(safe-area-inset-bottom))}body.customer-mode .topbar #topSearch,body.customer-mode .topbar #topMore{visibility:hidden;pointer-events:none}body.customer-mode .customer-back{display:none}
  body[data-tab="customer"] #draftDock,body[data-tab="customer"] #takeDock{display:none!important}
  .service-settings-card{margin-top:16px;padding:17px;border:1px solid var(--service-line);border-radius:20px;background:var(--service-paper);box-shadow:var(--shadow,none)}
  .service-settings-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px}.service-settings-title h2{font-size:20px;letter-spacing:-.5px;margin:4px 0 4px}.service-settings-title p{font-size:10px;color:var(--service-muted);margin:0;line-height:1.5}.service-settings-mark{width:38px;height:38px;border-radius:13px;display:grid;place-items:center;background:var(--black,#111);color:#fff;font-family:Georgia,serif;font-size:12px;font-weight:900;flex:0 0 auto}
  .service-setting-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-top:1px solid var(--service-line);border-bottom:1px solid var(--service-line)}.service-setting-row>div{display:grid;gap:4px}.service-setting-row strong{font-size:12px}.service-setting-row small{font-size:10px;color:var(--service-muted)}.service-toggle{min-width:74px;min-height:36px;border-radius:11px;padding:0 12px;background:#e7f6eb;color:#247447;font-size:11px;font-weight:900}.service-toggle.is-closed{background:#fff0ed;color:#b82d29}
  .service-fee-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:13px 0}.service-fee-grid label{display:grid;gap:6px}.service-fee-grid label span{font-size:10px;font-weight:850;color:var(--service-muted)}.service-fee-grid input{width:100%;height:42px;border:1px solid var(--service-line);border-radius:11px;background:var(--service-soft);color:var(--service-ink);padding:0 10px;font-size:12px;font-weight:800}
  .service-settings-help{font-size:10px;color:var(--service-muted);line-height:1.55;margin:4px 0 14px}.service-quick-actions,.service-backup-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.service-quick-actions button,.service-backup-grid button{min-height:42px;border:1px solid var(--service-line);border-radius:11px;background:var(--service-soft);color:var(--service-ink);font-size:10px;font-weight:900;padding:8px}.service-backup-grid{margin-top:8px}.service-backup-grid button:first-child{background:var(--black,#111);color:#fff;border-color:var(--black,#111)}
  .service-connection-note{display:flex;align-items:flex-start;gap:10px;margin-top:14px;padding:12px;border-radius:13px;background:var(--service-soft);border:1px solid var(--service-line)}.service-connection-dot{width:8px;height:8px;flex:0 0 auto;margin-top:4px;border-radius:50%;background:#c88b27}.service-connection-note strong{font-size:10px}.service-connection-note p{font-size:10px;line-height:1.5;color:var(--service-muted);margin:4px 0 0}
  .service-dialog{width:min(100% - 22px,550px);max-width:550px;max-height:min(92dvh,920px);padding:0;border:1px solid var(--service-line);border-radius:23px;background:var(--service-paper);color:var(--service-ink);box-shadow:0 24px 85px #0004;overflow:auto}.service-dialog::backdrop{background:#12121280;backdrop-filter:blur(4px)}.service-dialog-inner{padding:18px;display:grid;gap:12px}.service-dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding-bottom:11px;border-bottom:1px solid var(--service-line)}.service-dialog-head h2{font-size:22px;letter-spacing:-.7px;margin:4px 0 4px}.service-dialog-head p{font-size:10px;line-height:1.5;color:var(--service-muted);margin:0}.service-dialog-close{width:35px;height:35px;border-radius:50%;background:var(--service-soft);color:var(--service-ink);font-size:22px;flex:0 0 auto}
  .service-checkout-lines{display:grid;gap:8px}.service-checkout-line{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;font-size:11px}.service-checkout-line>div{display:grid;gap:3px}.service-checkout-line small{font-size:9px;color:var(--service-muted)}.service-checkout-line strong{font-size:11px;white-space:nowrap}.service-checkout-totals{border-top:1px solid var(--service-line);border-bottom:1px solid var(--service-line);padding:9px 0;display:grid;gap:7px}.service-total-line{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:10px;color:var(--service-muted)}.service-total-line strong{color:var(--service-ink);font-size:11px}.service-total-line.grand{padding-top:5px;border-top:1px dashed var(--service-line);font-size:12px;color:var(--service-ink);font-weight:900}.service-total-line.grand strong{font-size:16px}
  .service-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.service-form-field{display:grid;gap:6px;min-width:0}.service-form-field>span{font-size:10px;font-weight:900;color:var(--service-ink)}.service-form-field input,.service-form-field select,.service-form-field textarea{width:100%;min-width:0;border:1px solid var(--service-line);border-radius:11px;background:var(--service-soft);color:var(--service-ink);padding:11px 12px;min-height:42px;font-size:12px;outline:0}.service-form-field textarea{resize:vertical}.service-form-field small{font-size:9px;color:var(--service-muted);line-height:1.45}.service-form-field[hidden]{display:none!important}.service-place-order,.service-primary-btn{min-height:47px;border-radius:13px;padding:0 15px;background:var(--black,#111);color:#fff;font-size:12px;font-weight:900}.service-place-order:disabled{opacity:.45}.service-secondary-btn{min-height:44px;border:1px solid var(--service-line);border-radius:12px;background:var(--service-soft);color:var(--service-ink);font-size:11px;font-weight:850;padding:0 12px}.service-terms-note{font-size:9px;line-height:1.5;color:var(--service-muted);margin:0;text-align:center}.service-checkout-warning{padding:10px 12px;border-radius:11px;background:#fff0ed;color:#a52924;font-size:10px;font-weight:800;line-height:1.5}.service-checkout-success{text-align:center;padding-top:10px}.service-success-icon{width:52px;height:52px;margin:0 auto 11px;border-radius:50%;display:grid;place-items:center;background:#e3f6e9;color:#1f8548;font-size:26px;font-weight:900}.service-checkout-success h3{font-size:24px;letter-spacing:-.6px;margin:6px 0}.service-checkout-success p{font-size:11px;color:var(--service-muted);line-height:1.55}.service-receipt-card{padding:13px;margin:14px 0;border:1px dashed var(--service-line);border-radius:14px;text-align:left;background:var(--service-soft)}.service-receipt-card h4{font-size:13px;margin:0 0 8px}.service-receipt-card p{margin:4px 0;font-size:10px}.service-success-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.service-track-form{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:9px}.service-track-result:empty{display:none}.service-track-result{margin-top:11px;padding:12px;border-radius:12px;background:var(--service-soft);border:1px solid var(--service-line);font-size:11px;line-height:1.6}.service-order-context{padding:12px;margin:0 0 12px;background:var(--service-soft);border:1px solid var(--service-line);border-radius:13px;display:grid;gap:6px}.service-order-context h4{font-size:12px;margin:0 0 2px}.service-order-context p{font-size:10px;line-height:1.5;margin:0;color:var(--service-muted);overflow-wrap:anywhere}.service-order-context strong{color:var(--service-ink)}.service-order-context-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:4px}.service-order-context-actions button{min-height:34px;border-radius:10px;padding:0 10px;background:var(--service-paper);border:1px solid var(--service-line);color:var(--service-ink);font-size:10px;font-weight:850}.service-order-context-actions .service-cancel-order{color:#ac2929;border-color:#efcece}.service-order-context-actions button:disabled{opacity:.5}
  @media(min-width:620px){.customer-product-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.customer-product-body{padding:12px}.customer-product-name{font-size:13px}.customer-product-options{grid-template-columns:1fr}.customer-product-photo{aspect-ratio:1.35}}
  @media(min-width:900px){.customer-product-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.customer-head{padding-top:20px}.customer-product-body{padding:13px}}
  @media(max-width:420px){.customer-head{grid-template-columns:auto minmax(0,1fr);gap:9px}.customer-track-trigger{grid-column:1/-1;width:100%}.customer-head h1{font-size:23px}.customer-back{min-height:37px;padding:0 9px}.customer-product-grid{gap:8px}.customer-product-body{padding:8px}.customer-product-photo{aspect-ratio:1.18}.customer-product-name{font-size:11px}.customer-add-option{padding:7px;min-height:34px}.service-dialog-inner{padding:14px}.service-form-grid{grid-template-columns:1fr}.service-track-form{grid-template-columns:1fr}.service-track-form .service-primary-btn{width:100%}.service-settings-card{padding:13px}}
  @media print{body *{visibility:hidden!important}#customerCheckoutDialog[open],#customerCheckoutDialog[open] *{visibility:visible!important}#customerCheckoutDialog[open]{position:absolute;inset:0;width:100%;max-width:none;max-height:none;box-shadow:none;border:0}#customerCheckoutFormBody,#customerCheckoutFormBody button,.service-dialog-close,.service-terms-note{display:none!important}#customerCheckoutSuccess{display:block!important}}
</style>


<style id="shared-service-ui-style">
  .service-auth-panel{margin:12px 0;padding:12px;border:1px solid var(--service-line);border-radius:14px;background:var(--service-soft);display:grid;gap:9px}
  .service-auth-status{display:flex;gap:9px;align-items:flex-start}.service-auth-indicator{width:9px;height:9px;border-radius:50%;background:#c98a26;margin-top:4px;flex:0 0 auto}.service-auth-indicator.connected{background:#26935f}.service-auth-indicator.offline{background:#c98a26}.service-auth-indicator.locked{background:#cc5147}
  .service-auth-status>div{display:grid;gap:4px;min-width:0}.service-auth-status strong{font-size:10px}.service-auth-status small{font-size:9px;line-height:1.5;color:var(--service-muted)}.service-admin-password-field input{width:100%;height:42px;border:1px solid var(--service-line);border-radius:11px;background:var(--service-paper);color:var(--service-ink);padding:0 11px;font-size:12px}
  #serviceStaffLogin,#serviceStaffLogout{min-height:40px;border:1px solid var(--service-line);border-radius:11px;background:var(--service-paper);color:var(--service-ink);font-size:10px;font-weight:900;padding:8px}.service-publish-menu{min-height:42px;border-radius:11px;padding:8px 12px;background:var(--black,#111);color:#fff;font-size:10px;font-weight:900}.service-publish-menu:disabled{opacity:.4}
  .status.cancelled{background:#f9e8e7;color:#9f2925}
</style>


<style id="rs-setup-styles">
/* Restaurant setup card — matches the approved design */
.service-settings-card{background:var(--service-paper);border:0!important;border-radius:20px;padding:20px;
  margin:0 0 16px;box-shadow:0 1px 3px rgba(17,17,20,.07),0 10px 26px rgba(17,17,20,.05);display:block}
.rs-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;
  padding-bottom:14px;border-bottom:1px solid var(--service-line);margin-bottom:14px}
.rs-head-text{min-width:0}
.rs-head h2{margin:0;font-size:26px;line-height:1.1;font-weight:800;letter-spacing:-.7px;color:var(--service-ink)}
.rs-head p{margin:5px 0 0;font-size:13.5px;font-weight:500;color:var(--service-muted)}
.rs-mark{flex:0 0 auto;width:60px;height:60px;border-radius:18px;background:#111114;color:#fff;
  display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;letter-spacing:.6px}

.rs-orders{display:flex;align-items:center;gap:11px}
.rs-dot{width:12px;height:12px;border-radius:50%;background:#1B7F4B;box-shadow:0 0 0 4px rgba(27,127,75,.14);flex:0 0 auto}
.rs-orders-text{flex:1;min-width:0}
.rs-orders-text strong{display:block;font-size:17px;font-weight:800;color:var(--service-ink)}
.rs-orders-text small{display:block;font-size:12.5px;color:var(--service-muted);margin-top:2px}
#toggleBusinessOpen.rs-pill{flex:0 0 auto;background:#E7F4EA;color:#1B7F4B;border:0;border-radius:12px;
  padding:9px 15px;font-size:14px;font-weight:800;min-height:0;line-height:1.1}
#toggleBusinessOpen.rs-pill[aria-pressed="false"]{background:#FBE9E9;color:#9A2A2A}
.rs-switch{flex:0 0 auto;width:52px;height:30px;border-radius:999px;background:#C9C9D0;position:relative;
  cursor:pointer;transition:background .18s ease}
.rs-switch::after{content:"";position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;
  background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:transform .18s ease}
#toggleBusinessOpen[aria-pressed="true"] + .rs-switch{background:#1B7F4B}
#toggleBusinessOpen[aria-pressed="true"] + .rs-switch::after{transform:translateX(22px)}

.rs-tiles{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.rs-tile{background:var(--service-paper);border:1px solid var(--service-line);border-radius:18px;padding:14px;
  text-align:left;cursor:pointer;box-shadow:0 1px 2px rgba(17,17,20,.04)}
.rs-tile-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.rs-icon{width:44px;height:44px;border-radius:15px;background:#FDF0DC;display:flex;align-items:center;justify-content:center}
.rs-icon svg{width:24px;height:24px;stroke:#111114;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round}
.rs-chev{color:#B4B4BE;display:inline-flex}
.rs-chev svg{width:16px;height:16px;stroke:currentColor;stroke-width:2.2;fill:none;stroke-linecap:round;stroke-linejoin:round}
.rs-tile strong{display:block;font-size:15px;font-weight:800;letter-spacing:-.2px;color:var(--service-ink)}
.rs-tile small{display:block;font-size:11.5px;color:var(--service-muted);margin-top:2px}

.rs-gold{display:flex;align-items:center;gap:14px;width:100%;margin-top:12px;border:0;border-radius:20px;
  padding:16px 18px;cursor:pointer;text-align:left;background:linear-gradient(180deg,#F8D190 0%,#F2BE6C 100%)}
.rs-icon-dark{display:flex;align-items:center;justify-content:center}
.rs-icon-dark svg{width:28px;height:28px;stroke:#111114;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round}
.rs-gold-text{flex:1;min-width:0}
.rs-gold-text strong{display:block;font-size:17px;font-weight:800;color:#111114;letter-spacing:-.2px}
.rs-gold-text small{display:block;font-size:11.5px;color:#6B5320;margin-top:1px}
.rs-chev.dark{color:#6B5320}

.rs-staff{background:var(--service-paper);border:1px solid var(--service-line);border-radius:20px;padding:16px;margin-top:12px}
.rs-staff-row{display:flex;align-items:center;gap:12px}
.rs-avatar{width:46px;height:46px;border-radius:50%;background:#EFEFF5;display:flex;align-items:center;
  justify-content:center;flex:0 0 auto}
.rs-avatar svg{width:23px;height:23px;stroke:#111114;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round}
.rs-staff-text{flex:1;min-width:0}
.rs-staff-text strong{display:block;font-size:16px;font-weight:800;color:var(--service-ink)}
.rs-staff-text small{display:block;font-size:11.5px;color:var(--service-muted);margin-top:2px;line-height:1.35}
#serviceStaffLogin,#serviceStaffLogout{flex:0 0 auto;background:#111114;color:#fff;border:0;border-radius:13px;
  padding:12px 14px;font-size:13px;font-weight:800;min-height:0;line-height:1.1}
.rs-pass{display:block;margin-top:12px}
.rs-pass span{display:block;font-size:11px;font-weight:700;color:var(--service-muted);margin-bottom:5px}
.rs-pass input{width:100%;background:var(--service-soft);border:1px solid var(--service-line);border-radius:12px;
  padding:11px 12px;font-size:13px;color:var(--service-ink)}
.rs-status{display:flex;align-items:center;gap:8px;margin-top:10px}
.rs-status .service-auth-indicator{width:8px;height:8px;border-radius:50%;background:#C9A227;display:block;flex:0 0 auto}
.rs-status small{font-size:11px;color:var(--service-muted);line-height:1.35}
.rs-publish{width:100%;margin-top:10px;background:var(--service-soft);border:1px solid var(--service-line);
  border-radius:12px;padding:11px;font-size:12.5px;font-weight:700;color:var(--service-ink);min-height:0}

.rs-backup{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:var(--service-paper);
  border:1px solid var(--service-line);border-radius:20px;padding:14px 16px;margin-top:12px}
.rs-backup-btns{display:flex;gap:8px;margin-left:auto}
.rs-backup-btns button{display:inline-flex;align-items:center;gap:6px;background:transparent;
  border:1px solid var(--service-line);border-radius:12px;padding:10px 12px;font-size:12.5px;font-weight:700;
  color:var(--service-ink);min-height:0}
.rs-backup-btns svg{width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}

.rs-fees{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.rs-fees span{display:block;font-size:11px;font-weight:700;color:var(--service-muted);margin-bottom:5px}
.rs-fees input{width:100%;background:var(--service-soft);border:1px solid var(--service-line);border-radius:12px;
  padding:10px 12px;font-size:13px;color:var(--service-ink)}
.rs-help{font-size:11px;color:var(--service-muted);line-height:1.45;margin:8px 0 0}

.service-settings-card .service-connection-note{margin-top:12px;padding:10px 12px;border-radius:14px;
  background:var(--service-soft);display:flex;gap:9px;align-items:flex-start}
.service-settings-card .service-connection-note strong{font-size:11.5px}
.service-settings-card .service-connection-note p{font-size:11px;margin:2px 0 0;line-height:1.4;color:var(--service-muted)}
.rs-backup .rs-staff-text{flex:1 1 96px;min-width:96px}
@media (max-width:430px){
  .rs-head h2{font-size:22px}
  .rs-tile strong{font-size:13.5px}
  .rs-tile small{font-size:10.5px}
  .rs-gold-text strong{font-size:15px}
  .rs-staff-text strong{font-size:14.5px}
  .rs-backup-btns{width:100%;margin-left:0;margin-top:10px;justify-content:flex-end}
  .rs-staff{flex-wrap:wrap}
}
</style>

<style id="cc-new-order-style">
#ccNewOrderBanner{position:fixed;left:12px;right:12px;top:12px;z-index:9999;display:flex;gap:10px;align-items:center;
  background:#111114;color:#fff;border-radius:16px;padding:12px 14px;box-shadow:0 14px 34px rgba(17,17,20,.35);
  transform:translateY(-200%);transition:transform .3s cubic-bezier(.2,.8,.2,1);cursor:pointer}
#ccNewOrderBanner.on{transform:translateY(0)}
#ccNewOrderBanner .cc-nob-dot{width:10px;height:10px;border-radius:50%;background:#F2B23E;
  box-shadow:0 0 0 4px rgba(242,178,62,.25);flex:0 0 auto;animation:ccNobPulse 1.4s ease-in-out infinite}
@keyframes ccNobPulse{0%,100%{opacity:1}50%{opacity:.4}}
#ccNewOrderBanner .cc-nob-text{min-width:0}
#ccNewOrderBanner strong{display:block;font-size:13.5px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#ccNewOrderBanner small{display:block;font-size:11.5px;color:#B9B9C4;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
</style>
</head>
<body data-tab="orders">
<div id="app" class="app">
  <header class="topbar">
    <button class="round-action" id="topSearch" aria-label="Search orders"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button>
    <div class="brand">
      <svg class="crown" viewBox="0 0 32 24" aria-hidden="true"><path d="M3 18 1 5l7 5 8-9 8 9 7-5-2 13H3Zm1 3h24v2H4z"/></svg>
      <div class="brand-name">CHARLIE CHAAP</div>
    </div>
    <button class="round-action" id="topMore" aria-label="More options"><svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg></button>
  </header>

  <section class="view" id="homeView" data-view="home">
    <div class="restaurant-home premium-restaurant-hero">
      <div class="hero-topline"><span class="hero-live-dot"></span> CHARLIE CHAAP <span class="hero-topline-rule"></span><span class="hero-open-label">OPEN</span></div>
      <div class="premium-hero-copy">
        <div class="home-kicker">GOOD FOOD. GREAT MOMENTS.</div>
        <h1>Big flavour.<br><em>Real cravings.</em></h1>
        <p>Your favourite chaap, momos and more — freshly prepared, always worth coming back for.</p>
        <div class="home-actions"><button class="home-primary" id="homeStartOrder">Start an order <span>↗</span></button><button class="home-secondary" id="homeOpenMenu">Explore the menu <span>↓</span></button></div>
      </div>
      <div class="home-feature"><div><span class="feature-label">MADE FRESH, SERVED HOT</span><strong>A little street-food magic.</strong></div><div class="feature-mark">CC</div></div>
      <div class="hero-image-caption"><span>YOUR LOCAL FAVOURITE</span><span>EST. WITH FLAVOUR</span></div>
    </div>
    <div class="landing-content">
      <section class="landing-section landing-menu-preview" aria-labelledby="landingMenuTitle">
        <div class="landing-section-head"><div><span class="landing-eyebrow">FRESH FROM OUR KITCHEN</span><h2 id="landingMenuTitle">A menu worth craving.</h2><p>Street-food favourites, made fresh and served with flavour.</p></div><button class="landing-link" id="landingViewMenu">Explore menu <span>↗</span></button></div>
        <div class="landing-food-grid" id="landingFoodGrid">
          <article class="landing-food-card"><div class="landing-food-image landing-food-one"></div><div class="landing-food-copy"><span>CHARLIE'S FAVOURITE</span><h3>Signature Chaap</h3><p>Smoky, rich and full of flavour.</p></div></article>
          <article class="landing-food-card"><div class="landing-food-image landing-food-two"></div><div class="landing-food-copy"><span>MADE TO SHARE</span><h3>Momos &amp; bites</h3><p>Little bites. Big happiness.</p></div></article>
          <article class="landing-food-card"><div class="landing-food-image landing-food-three"></div><div class="landing-food-copy"><span>ALWAYS A GOOD IDEA</span><h3>Indo-Chinese favourites</h3><p>Your go-to comfort cravings.</p></div></article>
        </div>
      </section>
      <section class="landing-about">
        <div class="landing-about-image" role="img" aria-label="Charlie Chaap restaurant at night"></div>
        <div class="landing-about-copy"><span class="landing-eyebrow">A LITTLE ABOUT US</span><h2>Good food.<br><em>Great moments.</em></h2><p>From the first sizzle to the last bite, Charlie Chaap is all about flavourful food, familiar favourites and moments worth sharing.</p><button class="landing-dark-btn" id="landingAboutOrder">Come hungry <span>↗</span></button></div>
      </section>
      <section class="landing-story-row">
        <article class="landing-story-card landing-story-text"><span class="landing-eyebrow">MADE FRESH</span><h2>Big flavour, no fuss.</h2><p>Freshly prepared favourites for quick bites, sharing plates and satisfying cravings.</p><button class="landing-text-link" id="landingStoryMenu">Find your favourite ↗</button></article>
        <article class="landing-story-card landing-gallery-card"><div class="landing-gallery-photo"></div><div><span class="landing-eyebrow">THE CHARLIE EXPERIENCE</span><h3>Your next favourite bite is waiting.</h3></div></article>
        <article class="landing-story-card landing-review-card"><span class="landing-review-mark">“</span><h2>Made for cravings.<br>Remembered for flavour.</h2><p>Drop by, bring your people, and make it a Charlie Chaap moment.</p><button class="landing-dark-btn" id="landingReviewOrder">Place an order <span>↗</span></button></article>
      </section>
      <footer class="landing-footer"><div class="landing-footer-brand"><span class="landing-footer-mark">CC</span><div><strong>CHARLIE CHAAP</strong><p>Good food. Great moments.</p></div></div><div class="landing-footer-links"><button id="landingFooterMenu">Menu</button><button id="landingFooterOrder">Start an order</button><span>Freshly prepared. Full of flavour.</span></div></footer>
    </div>
  </section>

  <section class="view" id="customerView" data-view="customer">
    <div class="customer-head">
      <button class="customer-back" id="customerBack" type="button" aria-label="Back to staff home">← <span>Back</span></button>
      <div><div class="customer-eyebrow">CHARLIE CHAAP · ORDER ONLINE</div><h1>What are you craving?</h1><p>Choose your favourites. We’ll prepare them fresh.</p></div>
      <button class="customer-track-trigger" id="customerTrackOpen" type="button">Track order</button>
    </div>
    <div class="customer-open-state" id="customerOpenState"><span class="customer-open-dot"></span><span id="customerOpenText">Accepting orders</span><span class="customer-open-note">Prices shown in INR</span></div>
    <label class="customer-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="customerSearch" type="search" placeholder="Search chaap, momos, drinks…" autocomplete="off" aria-label="Search menu"></label>
    <div class="customer-category-strip" id="customerCategories" aria-label="Menu categories"></div>
    <div class="customer-menu-heading"><div><h2 id="customerMenuTitle">Our menu</h2><p id="customerMenuCount">Fresh favourites, ready to order</p></div><span class="customer-menu-badge">MENU</span></div>
    <div class="customer-product-grid" id="customerProducts"></div>
    <div class="customer-help-note"><strong>Need something special?</strong><span>Add preparation notes during checkout. Availability and order confirmation are handled by the restaurant.</span></div>
  </section>

  <section class="view active" id="ordersView" data-view="orders">
    <div class="page-head"><h1>Orders</h1></div>
    <section class="quick-card order-entry-card" aria-label="Quick order entry">
      <div class="quick-row">
        <svg class="quick-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
        <textarea id="homeEntry" class="quick-entry" rows="1" placeholder="Type items… e.g. 2 afghani chaap full" aria-label="Type order, one item per line"></textarea>
        <button class="black-btn" id="homeAdd">Place order</button>
      </div>
      <div id="homeMatches" class="matches" hidden></div><div id="homeSummary" class="summaryline" hidden></div>
    </section>
    <section class="order-panel" id="ordersSection">
      <div class="section-head" style="margin-top:0"><div><h2 class="section-title">Recent orders</h2><div class="section-sub"></div></div><span id="activeCount" class="status pending">0 Orders</span></div>
      <div class="order-top-tools"><div class="searchbox"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="orderSearch" placeholder="Search orders…" aria-label="Search orders"></div><button class="round-action" style="width:42px;height:42px;flex:0 0 42px" id="exportTop" aria-label="Export orders"><svg viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5"/><path d="M5 18v3h14v-3"/></svg></button></div>
      <div class="order-list" id="homeOrderList"></div>
      <div class="lower-actions"><button class="text-btn" id="allHistory">Order history</button></div>
    </section>
  </section>

  <section class="view" id="takeView" data-view="take">
    <div class="page-head take-page-head">
      <h1>Take an Order</h1>
    </div>
    <section class="take-panel take-entry-panel">
      <div class="take-panel-head"><div><div><h2>Order items</h2></div></div></div>
      <div class="quick-card take-quick-card"><div class="quick-row take-quick-row">
        <svg class="quick-search" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
        <textarea id="takeEntry" class="quick-entry" rows="2" placeholder="2 paneer momos full&#10;1 fries half" aria-label="Type items for this order"></textarea>
        <button class="black-btn" id="takeAdd" disabled><span class="plus-symbol"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg></span> Place order</button>
      </div><div id="takeMatches" class="matches" hidden></div><div id="takeSummary" class="summaryline" hidden></div></div>
    </section>
    <section class="take-panel take-cart-panel">
      <div class="take-section-head"><div><div><h2>Current order</h2><p id="takeCartMeta">Nothing added yet</p></div></div><button class="text-btn take-clear" id="takeClear" type="button" hidden>Clear</button></div>
      <div id="takeCartList" class="take-cart-list"><div class="take-cart-empty"><span class="take-empty-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span><strong>No items added</strong></div></div>
      <div class="take-cart-total"><span>Total</span><strong id="takeCartTotal">₹0</strong></div>
      <button class="take-inline-review" id="takeReview" type="button" hidden disabled>Review order</button>
    </section>
  </section>

  <section class="view" id="menuView" data-view="menu">
    <div class="page-head menu-page-head"><h1>Menu</h1><button class="black-btn custom-menu-trigger" id="addCustomMenuItem" type="button" aria-label="Open menu editor">✎ Edit menu</button></div>
    <div class="searchbox"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="menuSearch" placeholder="Search menu items…" aria-label="Search menu"></div>
    <div id="menuCategories" class="category-row menu-filters"></div>
    <div id="menuList" class="menu-list"></div>
  </section>

  <section class="view" id="menuEditorView" data-view="menuEditor">
    <div class="menu-editor-header">
      <button class="menu-editor-back" id="menuEditorBack" type="button" aria-label="Back to menu">← <span>Menu</span></button>
      <div class="menu-editor-heading"><h1>Edit menu</h1><p>Manage photos, names, categories, prices and availability.</p></div>
      <button class="black-btn menu-editor-add" id="editorAddItem" type="button">＋ Add item</button>
    </div>
    <div class="menu-editor-tools">
      <label class="menu-editor-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="editorSearch" type="search" placeholder="Find a dish to edit…" autocomplete="off"></label>
      <select id="editorStatusFilter" aria-label="Filter menu items"><option value="all">All items</option><option value="available">Available</option><option value="unavailable">Unavailable</option></select>
    </div>
    <div id="editorMenuStats" class="editor-menu-stats"></div>
    <div id="editorMenuList" class="editor-menu-list"></div>
  </section>

  <section class="view" id="historyView" data-view="history">
    <div class="page-head"><h1>Order History</h1></div>
    <div class="order-top-tools"><div class="searchbox"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="historySearch" placeholder="Search history…" aria-label="Search history"></div><button class="round-action" id="exportHistory" aria-label="Export history"><svg viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5"/><path d="M5 18v3h14v-3"/></svg></button></div>
    <div class="small-stats"><div class="small-stat"><span>Orders</span><strong id="historyCount">0</strong></div><div class="small-stat"><span>Orders today</span><strong id="todayCount">0</strong></div><div class="small-stat"><span>Completed sales</span><strong id="completedTotal">₹0</strong></div></div>
    <div id="historyList" class="order-list"></div>
  </section>

  <section class="view" id="moreView" data-view="more">
    <div class="page-head"><h1>More</h1></div>
<section class="service-settings-card" aria-labelledby="serviceSettingsTitle">
        <div class="rs-head">
          <div class="rs-head-text">
            <h2 id="serviceSettingsTitle">Restaurant setup</h2>
            <p>Manage your menu and staff access</p>
          </div>
          <span class="rs-mark">CC</span>
        </div>

        <div class="rs-orders" id="rsOrdersRow">
          <span class="rs-dot"></span>
          <div class="rs-orders-text">
            <strong>Orders</strong>
            <small id="serviceStatusText">Customers can place orders</small>
          </div>
          <button id="toggleBusinessOpen" class="rs-pill" type="button" aria-pressed="true">Open</button>
          <span class="rs-switch" role="button" tabindex="0" aria-label="Toggle ordering"
                onclick="document.getElementById('toggleBusinessOpen').click()"></span>
        </div>

        <div class="rs-tiles">
          <button id="openCustomerPreview" class="rs-tile" type="button">
            <span class="rs-tile-top"><span class="rs-icon"><svg viewBox="0 0 24 24"><path d="M4.2 9.4h15.6v9a1.2 1.2 0 0 1-1.2 1.2H5.4a1.2 1.2 0 0 1-1.2-1.2z"/><path d="M3.4 9.4l1.5-4.3a1 1 0 0 1 .9-.7h12.4a1 1 0 0 1 .9.7l1.5 4.3"/><path d="M9.2 19.6v-5.2h5.6v5.2"/></svg></span><span class="rs-chev"><svg viewBox="0 0 24 24"><path d="M9.4 5.6L15.8 12l-6.4 6.4"/></svg></span></span>
            <strong>Customer menu</strong>
            <small>Open menu for customers</small>
          </button>
          <button id="copyCustomerLink" class="rs-tile" type="button">
            <span class="rs-tile-top"><span class="rs-icon"><svg viewBox="0 0 24 24"><path d="M10.2 13.8a3.4 3.4 0 0 0 4.8 0l2.6-2.6a3.4 3.4 0 0 0-4.8-4.8l-1.2 1.2"/><path d="M13.8 10.2a3.4 3.4 0 0 0-4.8 0l-2.6 2.6a3.4 3.4 0 0 0 4.8 4.8l1.2-1.2"/></svg></span><span class="rs-chev"><svg viewBox="0 0 24 24"><path d="M9.4 5.6L15.8 12l-6.4 6.4"/></svg></span></span>
            <strong>Copy customer link</strong>
            <small>Share your menu link</small>
          </button>
        </div>

        <button id="rsUpdateMenu" class="rs-gold" type="button">
          <span class="rs-icon-dark"><svg viewBox="0 0 24 24"><path d="M5 6.6h7.4M5 10.8h5.4M5 15h5.4"/><path d="M16.4 8.6l2 2-6 6-2.6.6.6-2.6z"/></svg></span>
          <span class="rs-gold-text"><strong>Update menu</strong><small>Add, edit or remove menu items</small></span>
          <span class="rs-chev dark"><svg viewBox="0 0 24 24"><path d="M9.4 5.6L15.8 12l-6.4 6.4"/></svg></span>
        </button>

        <section class="rs-staff" id="serviceAuthPanel" aria-label="Shared service connection">
          <div class="rs-staff-row">
            <span class="rs-avatar"><svg viewBox="0 0 24 24"><circle cx="9" cy="8.2" r="3.2"/><path d="M3.6 19.4c0-2.8 2.4-4.6 5.4-4.6s5.4 1.8 5.4 4.6"/><path d="M16 5.4a3 3 0 0 1 0 5.8"/><path d="M17.4 14.9c1.9.5 3.2 2 3.2 4.1"/></svg></span>
            <div class="rs-staff-text">
              <strong>Staff access</strong>
              <small id="serviceAuthTitle">Checking service connection…</small>
            </div>
            <button id="serviceStaffLogin" type="button">Enter as staff</button>
            <button id="serviceStaffLogout" type="button" hidden>Sign out</button>
          </div>
          <label class="rs-pass"><span>Staff password</span><input id="serviceAdminPassword" type="password" autocomplete="current-password" placeholder="Enter staff password"></label>
          <div class="rs-status">
            <span class="service-auth-indicator" id="serviceAuthIndicator"></span>
            <small id="serviceAuthDescription">Shared orders activate when this app is served by its included Node.js server.</small>
          </div>
          <button id="servicePublishMenu" class="rs-publish" type="button" disabled>Publish current menu to customers</button>
        </section>

        <div class="rs-backup">
          <span class="rs-avatar"><svg viewBox="0 0 24 24"><path d="M7.6 18.4h8.8a3.4 3.4 0 0 0 .3-6.8 5 5 0 0 0-9.5-1.3 3.6 3.6 0 0 0 .4 8.1z"/></svg></span>
          <div class="rs-staff-text"><strong>Backup</strong><small>Keep your data safe</small></div>
          <div class="rs-backup-btns">
            <button id="downloadServiceBackup" type="button"><svg viewBox="0 0 24 24"><path d="M12 15.6V4.4M8.2 8.2L12 4.4l3.8 3.8M5 16.4v2.2a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.2"/></svg>Export</button>
            <button id="restoreServiceBackup" type="button"><svg viewBox="0 0 24 24"><path d="M12 4.4v11.2M8.2 11.8L12 15.6l3.8-3.8M5 16.4v2.2a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.2"/></svg>Restore</button>
          </div>
          <input id="serviceBackupFile" type="file" accept="application/json,.json" hidden>
        </div>

        <div class="rs-fees">
          <label><span>Tax / GST (%)</span><input id="serviceTaxRate" type="number" inputmode="decimal" min="0" max="100" step="0.1" value="0"></label>
          <label><span>Delivery fee (₹)</span><input id="serviceDeliveryFee" type="number" inputmode="decimal" min="0" max="100000" step="1" value="0"></label>
        </div>
        <p class="rs-help">Keep tax at 0% unless the rate has been confirmed for your business. Delivery fee is added only to delivery orders.</p>

        <div class="service-connection-note"><span class="service-connection-dot"></span><div><strong>Single-browser storage</strong><p>Orders and menu changes save in this browser. Public multi-device ordering requires a shared database and staff authentication before launch.</p></div></div>
      </section>
    <div class="more-grid">
      <div class="setting-card"><div class="setting-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg></div><div class="setting-text"><strong>Dark mode</strong></div><button class="switch" id="themeSwitch" role="switch" aria-checked="false" aria-label="Dark mode"><i></i></button></div>
      <div class="setting-card"><div class="setting-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5"/><path d="M5 18v3h14v-3"/></svg></div><div class="setting-text"><strong>Export orders</strong></div><button id="exportMore">Export</button></div>
      <div class="setting-card"><div class="setting-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h9"/></svg></div><div class="setting-text"><strong>Menu & rates</strong></div><button id="openMenuMore">View menu</button></div>
      
      <div class="setting-card"><div class="setting-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.5-5.8"/><path d="M20 4v4.5h-4.5"/></svg></div><div class="setting-text"><strong>Reset order list</strong></div><button id="clearAllMore">Reset</button></div>
      
    </div>
    
  </section>
</div>

<div id="draftDock" class="draft-dock" hidden><div class="draft-summary"><strong id="draftCount">0 items in order</strong><small id="draftTotal">₹0</small></div><button class="black-btn" id="reviewDraft">Review order</button></div>
<div id="takeDock" class="take-dock" hidden><div class="take-dock-info"><strong id="takeDockCount">0 items</strong><span id="takeDockTotal">₹0</span></div><button class="black-btn" id="takeDockReview" type="button">Review order</button></div>
