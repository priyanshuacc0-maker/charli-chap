<dialog class="dialog" id="quickDialog"><div class="dialog-inner"><div class="dialog-head"><div><div class="dialog-title">New Order</div></div><button class="close-btn" data-close="quickDialog" aria-label="Close">×</button></div><section class="quick-card"><div class="quick-row"><svg class="quick-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><textarea id="modalEntry" class="quick-entry" rows="2" placeholder="2 paneer momos full&#10;1 fries half"></textarea><button class="black-btn" id="modalAdd"><span class="plus-symbol"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span> Add</button></div><div id="modalMatches" class="matches" hidden></div><div id="modalSummary" class="summaryline" hidden></div></section><button class="black-btn" style="width:100%;margin-top:13px" id="modalAddBottom">Add order</button></div></dialog>

<dialog class="dialog" id="matchDialog"><div class="dialog-inner"><div class="dialog-head"><div><div class="dialog-title">Choose item</div></div><button class="close-btn" data-close="matchDialog" aria-label="Close">×</button></div><input id="matchSearch" class="pick-search" placeholder="Search menu items…"><div id="matchOptions"></div></div></dialog>

<dialog class="dialog" id="sizeDialog"><div class="dialog-inner"><div class="dialog-head"><div><div id="sizeTitle" class="dialog-title">Add item</div><div id="sizeSub" class="dialog-sub">Choose size</div></div><button class="close-btn" data-close="sizeDialog" aria-label="Close">×</button></div><div class="dialog-actions"><button id="sizeHalf" class="plain-btn">Half</button><button id="sizeFull" class="plain-btn">Full</button></div></div></dialog>

<dialog class="dialog" id="draftDialog"><div class="dialog-inner"><div class="dialog-head"><div><div class="dialog-title">Your Order</div></div><button class="close-btn" data-close="draftDialog" aria-label="Close">×</button></div><div id="draftLines"></div><div id="draftSummaryBox" class="summary-box"></div><div class="dialog-actions"><button class="plain-btn" id="continueMenu">Add more items</button><button class="black-btn" id="placeDraft">Place order</button></div></div></dialog>

<dialog class="dialog" id="customItemDialog"><form id="customItemForm" class="dialog-inner" method="dialog"><div class="dialog-head"><div><div class="dialog-title">Add a custom item</div><p class="dialog-sub">For off-menu dishes, extras or temporary specials.</p></div><button class="close-btn" type="button" data-close="customItemDialog" aria-label="Close">×</button></div><label class="custom-label" for="customItemName">Item name</label><input id="customItemName" class="pick-search" required maxlength="70" placeholder="e.g. Special Tandoori Chaap"><label class="custom-label" for="customItemCategory">Category</label><select id="customItemCategory" class="pick-search"><option>Chaap</option><option>Momos</option><option>Chinese</option><option>Indian</option><option>Tikka</option><option>Gravy</option><option>Drinks</option><option>Extras</option><option>Specials</option></select><div class="custom-price-grid"><div><label class="custom-label" for="customItemHalf">Half price (₹)</label><input id="customItemHalf" class="pick-search" type="number" min="0" step="0.5" placeholder="Optional"></div><div><label class="custom-label" for="customItemFull">Full price (₹)</label><input id="customItemFull" class="pick-search" type="number" min="0" step="0.5" placeholder="Optional"></div></div><p class="custom-help">Enter at least one price. The item will be saved on this device and appear in your menu next time.</p><button class="black-btn custom-save" type="submit">Save menu item</button></form></dialog>
<dialog class="dialog" id="detailDialog"><div id="detailContent" class="dialog-inner"></div></dialog>

<dialog class="dialog" id="menuPickerDialog"><div class="dialog-inner"><div class="dialog-head"><div><div class="dialog-title">Add another item</div></div><button class="close-btn" data-close="menuPickerDialog" aria-label="Close">×</button></div><input id="detailMenuSearch" class="pick-search" placeholder="Search menu items…"><div id="detailMenuPicker"></div></div></dialog>

