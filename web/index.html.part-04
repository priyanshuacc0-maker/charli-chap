 {n:"Thums Up Big",c:"Beverages",h:70,f:null,hLabel:"Big",a:["thums up big","thumbs up big","thumsup big","thums up large","big thums up","70 rupees thums up big"],custom:true,available:true},
 {n:"Thums Up Medium",c:"Beverages",h:50,f:null,hLabel:"Medium",a:["thums up medium","thumbs up medium","thumsup medium","medium thums up","50 rupees thums up medium"],custom:true,available:true},
